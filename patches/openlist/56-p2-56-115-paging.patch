@@ -0,0 +1,101 @@
+import assert from "node:assert/strict"
+import { afterEach, test } from "node:test"
+
+import { Client115 } from "./util"
+
+const realFetch = globalThis.fetch
+
+afterEach(() => {
+  globalThis.fetch = realFetch
+})
+
+/** 造 n 个文件条目（大写字段，与 115 Open API 一致） */
+function makeItems(n: number) {
+  return Array.from({ length: n }, (_, i) => ({
+    Fid: String(i),
+    Fn: `f${String(i).padStart(5, "0")}`,
+    Fc: "1",
+    FS: 1,
+    Pc: `pc${i}`,
+    Upt: 1700000000 + i,
+  }))
+}
+
+/**
+ * 假服务端：按 offset/limit 切片，单页最多 serverCap 条（模拟服务端自己的上限）。
+ * 记录每次请求的 offset/limit，供断言翻页次数与顺序。
+ */
+function installMock(items: any[], serverCap = 1000) {
+  const calls: Array<{ offset: number; limit: number }> = []
+  globalThis.fetch = (async (input: any, init?: any) => {
+    const url = String(input)
+    if (url.includes("/user/info")) {
+      return {
+        ok: true,
+        status: 200,
+        json: async () => ({ state: true, data: { user_id: 1, user_name: "t" } }),
+      }
+    }
+    const body = JSON.parse(String(init?.body || "{}"))
+    const offset = Number(body.offset)
+    const limit = Number(body.limit)
+    calls.push({ offset, limit })
+    const take = Math.min(limit, serverCap)
+    const page = items.slice(offset, offset + take)
+    return {
+      ok: true,
+      status: 200,
+      json: async () => ({
+        state: true,
+        count: items.length,
+        offset,
+        page_size: take,
+        data: page,
+      }),
+    }
+  }) as any
+  return calls
+}
+
+test("115 getFiles 翻页取满 1500 项，顺序稳定", async () => {
+  const items = makeItems(1500)
+  const calls = installMock(items)
+  const client = new Client115({ access_token: "t", refresh_token: "r" } as any)
+
+  const files = await client.getFiles("0")
+
+  assert.equal(files.length, 1500)
+  assert.deepEqual(
+    files.map((f) => f.Fid),
+    items.map((f) => f.Fid),
+  )
+  assert.deepEqual(calls, [
+    { offset: 0, limit: 1000 },
+    { offset: 1000, limit: 1000 },
+  ])
+})
+
+test("115 服务端单页上限低于请求值时按 count 继续翻页", async () => {
+  const items = makeItems(1500)
+  const calls = installMock(items, 500)
+  const client = new Client115({ access_token: "t", refresh_token: "r" } as any)
+
+  const files = await client.getFiles("0")
+
+  assert.equal(files.length, 1500)
+  assert.deepEqual(
+    calls.map((c) => c.offset),
+    [0, 500, 1000],
+  )
+})
+
+test("115 恰好 1000 项时只请求一页，不多打一次空页", async () => {
+  const items = makeItems(1000)
+  const calls = installMock(items)
+  const client = new Client115({ access_token: "t", refresh_token: "r" } as any)
+
+  const files = await client.getFiles("0")
+
+  assert.equal(files.length, 1000)
+  assert.deepEqual(calls, [{ offset: 0, limit: 1000 }])
+})
