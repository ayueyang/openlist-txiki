+        const chunk = content.subarray(start, start + info.partSize)
+        const res = await fetch(part.uploadUrl, {
+          method: "PUT",
+          headers: {
+            "Content-Type": "application/octet-stream",
+            "Content-Length": String(info.partSize),
+            Origin: "https://yun.139.com",
+            Referer: "https://yun.139.com/",
+          },
+          body: chunk as any,
+        })
+        if (res.status !== 200) {
+          throw new Error(
+            `139 upload: part ${part.partNumber} PUT failed with HTTP ${res.status} for ${name}`,
+          )
+        }
+      }
