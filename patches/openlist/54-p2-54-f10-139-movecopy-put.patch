+test("139 put: 同名冲突按 改名旧项 -> 删除旧项 -> 新项改回原名 处理", async () => {
+  let uploadUrl = ""
+  const mock = await startMock({
+    "POST /file/list": () =>
+      listResp([
+        { fileId: "cntOld", name: "a.txt", type: "file" },
+        { fileId: "cntNew", name: "a (1).txt", type: "file" },
+      ]),
+    "POST /file/create": () => ({
+      json: {
+        success: true,
+        code: "0000",
+        data: {
+          exist: false,
+          fileId: "f1",
+          fileName: "a (1).txt",
+          uploadId: "u1",
+          partInfos: [{ partNumber: 1, uploadUrl }],
+        },
+      },
+    }),
+    "PUT /up/1": () => ({ status: 200 }),
+    "POST /file/complete": () => ({ json: { success: true } }),
+    "POST /file/update": () => ({ json: { success: true } }),
+    "POST /file/delete": () => ({ json: { success: true } }),
+  })
+  uploadUrl = `http://127.0.0.1:${mock.port}/up/1`
+  const driver = makeDriver(mock.port)
+  try {
+    await driver.put("/a.txt", "/a.txt", Buffer.from("x"))
+
+    const updates = mock.callsTo("/file/update")
+    const deletes = mock.callsTo("/file/delete")
+    assert.equal(updates.length, 2, "应当有两次 /file/update")
+    assert.equal(deletes.length, 1, "应当有一次 /file/delete")
+    assert.equal(updates[0].body.fileId, "cntOld")
+    assert.match(String(updates[0].body.name), /^a\.txt.{4}$/)
+    assert.deepEqual(deletes[0].body, { fileIds: ["cntOld"] })
+    assert.equal(updates[1].body.fileId, "cntNew")
+    assert.equal(updates[1].body.name, "a.txt")
+
+    // 顺序：先改名旧项、再删除旧项、最后把新项改回原名。
+    const order = mock.calls
+      .filter((c) => c.path === "/file/update" || c.path === "/file/delete")
+      .map((c) => c.path)
+    assert.deepEqual(order, ["/file/update", "/file/delete", "/file/update"])
+  } finally {
+    await mock.close()
+  }
+})
