+test("139 put: create 带整文件 SHA256/分片表，PUT 字节全等，complete 带同一 hash", async () => {
+  const content = Buffer.from("hello 139 upload")
+  const expectedHash = createHash("sha256").update(content).digest("hex")
+  let uploadUrl = ""
+
+  const mock = await startMock({
+    "POST /file/list": () => listResp([]),
+    "POST /file/create": () => ({
+      json: {
+        success: true,
+        code: "0000",
+        data: {
+          exist: false,
+          fileId: "f1",
+          fileName: "a.txt",
+          uploadId: "u1",
+          partInfos: [{ partNumber: 1, uploadUrl }],
+        },
+      },
+    }),
+    "PUT /up/1": () => ({ status: 200 }),
+    "POST /file/complete": () => ({ json: { success: true, code: "0000" } }),
+  })
+  uploadUrl = `http://127.0.0.1:${mock.port}/up/1`
+
+  const driver = makeDriver(mock.port)
+  try {
+    await driver.put("/a.txt", "/a.txt", content)
+
+    const create = mock.callsTo("/file/create")[0]
+    assert.ok(create, "没有发 /file/create")
+    assert.equal(create.body.contentHash, expectedHash)
+    assert.equal(create.body.contentHashAlgorithm, "SHA256")
+    assert.equal(create.body.size, content.length)
+    assert.equal(create.body.name, "a.txt")
+    assert.equal(create.body.parallelUpload, false)
+    assert.equal(create.body.fileRenameMode, "auto_rename")
+    assert.equal(create.body.partInfos[0].partNumber, 1)
+    assert.equal(create.body.partInfos[0].partSize, content.length)
+    assert.equal(create.body.partInfos[0].parallelHashCtx.partOffset, 0)
+
+    const put = mock.callsTo("/up/1")[0]
+    assert.ok(put, "没有 PUT 分片")
+    assert.equal(put.method, "PUT")
+    assert.equal(put.headers["content-length"], String(content.length))
+    assert.equal(put.headers["content-type"], "application/octet-stream")
