+  private async resolveNameConflict(
+    parentFileId: string,
+    name: string,
+    serverName: string,
+  ): Promise<void> {
+    // 等 500ms 让服务端列表刷新，与 A 一致。
+    await new Promise((resolve) => setTimeout(resolve, 500))
