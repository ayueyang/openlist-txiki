+import test from "node:test"
+import assert from "node:assert/strict"
+import { createHash } from "node:crypto"
+import { createServer } from "node:http"
+import type { IncomingMessage, ServerResponse } from "node:http"
+import type { AddressInfo } from "node:net"
+import { Yun139Driver } from "./driver"
+import { Yun139Addition } from "./types"
+
+/**
+ * 本地 mock，不登录真实账号：只按路径返回固定 JSON，并记录方法/路径/头/字节。
+ * 不校验 mcloud-sign（签名算法有独立用例）。
+ */
+type MockRoute = (ctx: {
+  body: any
+  raw: Buffer
+  headers: Record<string, any>
+  count: number
+}) => { status?: number; json?: any }
+
+type Recorded = {
+  method: string
+  path: string
+  headers: Record<string, any>
+  body: any
+  raw: Buffer
+}
+
+async function startMock(routes: Record<string, MockRoute>) {
+  const calls: Recorded[] = []
+  const counts = new Map<string, number>()
+
+  const server = createServer((req: IncomingMessage, res: ServerResponse) => {
+    const chunks: Buffer[] = []
+    req.on("data", (c: Buffer) => chunks.push(c))
+    req.on("end", () => {
+      const raw = Buffer.concat(chunks)
+      const path = req.url || "/"
+      const key = `${req.method} ${path}`
+      const count = (counts.get(key) || 0) + 1
+      counts.set(key, count)
+
+      let body: any = null
+      const text = raw.toString("utf8")
+      if (text) {
+        try {
+          body = JSON.parse(text)
+        } catch {
+          body = text
+        }
+      }
+      calls.push({
+        method: req.method || "",
+        path,
+        headers: req.headers as Record<string, any>,
+        body,
+        raw,
+      })
+
+      const route = routes[key] ?? routes[path]
+      if (!route) {
+        res.writeHead(404, { "content-type": "application/json" })
+        res.end(JSON.stringify({ error: `no mock route for ${key}` }))
+        return
+      }
+      const result = route({ body, raw, headers: req.headers, count })
+      const status = result.status ?? 200
+      if (result.json === undefined) {
+        res.writeHead(status)
+        res.end()
+        return
+      }
+      const payload = JSON.stringify(result.json)
+      res.writeHead(status, {
+        "content-type": "application/json",
+        "content-length": String(Buffer.byteLength(payload)),
+      })
+      res.end(payload)
+    })
+  })
+
+  await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve))
+  const port = (server.address() as AddressInfo).port
+
+  return {
+    port,
+    calls,
+    count: (method: string, path: string) => counts.get(`${method} ${path}`) || 0,
+    callsTo: (path: string) => calls.filter((c) => c.path === path),
+    close: () => new Promise<void>((resolve) => server.close(() => resolve())),
+  }
+}
+
+function makeDriver(port: number, extra: Partial<Yun139Addition> = {}) {
+  // token 的第四个字段是毫秒到期时间；放 30 天后，避免触发 PC 刷新分支。
+  const token = `tok|1|RCS|${Date.now() + 30 * 24 * 3600 * 1000}|opaque`
+  const addition: Yun139Addition = {
+    authorization: Buffer.from(`13800138000:acct:${token}`).toString("base64"),
+    type: "personal_new",
+    ...extra,
+  }
+  const driver = new Yun139Driver(addition)
+  ;(driver as any).client.personalHost = `http://127.0.0.1:${port}`
+  return driver
+}
+
+/** personal_new 的 /file/list 响应：items 里 folder/file 混排。 */
+function listResp(items: any[]) {
+  return {
+    json: { success: true, code: "0000", data: { items, nextPageCursor: "" } },
+  }
+}
+
+test("139 move: personal_new 走 /file/batchMove，body 为源 id 与目标父目录 id", async () => {
+  const mock = await startMock({
+    "POST /file/list": () =>
+      listResp([
+        { fileId: "cnt1", name: "a.txt", type: "file" },
+        { fileId: "catDst", name: "dst", type: "folder" },
+      ]),
+    "POST /file/batchMove": () => ({ json: { success: true, code: "0000" } }),
+  })
+  const driver = makeDriver(mock.port)
+  try {
+    await driver.move("/", "/dst", ["a.txt"], "/a.txt", "/dst/a.txt")
+    const call = mock.callsTo("/file/batchMove")[0]
+    assert.ok(call, "没有发 /file/batchMove")
+    assert.deepEqual(call.body, {
+      fileIds: ["cnt1"],
+      toParentFileId: "catDst",
+    })
+  } finally {
+    await mock.close()
+  }
+})
+
