+  /**
+   * personal_new 的串行上传，对齐 A driver.go:513-708：
+   * /file/create -> 逐片 PUT -> /file/complete -> 同名冲突修正。
+   * 并行上传（parallel_upload）不在本期，请求体固定 parallelUpload:false。
+   */
+  async uploadPersonalNew(
+    parentFileId: string,
+    name: string,
+    content: Uint8Array,
+    partSizeOverride?: number,
+  ): Promise<void> {
+    const size = content.length
+    const contentHash = await sha256Hex(content)
+    const partSize = this.getPartSize(size, partSizeOverride)
+    const partCount = size === 0 ? 1 : Math.ceil(size / partSize)
+
+    const partInfos: UploadPartInfo[] = []
+    for (let i = 0; i < partCount; i++) {
+      const start = i * partSize
+      partInfos.push({
+        partNumber: i + 1,
+        partSize: Math.min(partSize, size - start),
+        // A 的 PartInfo 没有 omitempty，串行请求也带这个对象。
+        parallelHashCtx: { partOffset: start },
+      })
+    }
+
+    // 只带前 100 片；其余分片等 create 返回 fileId/uploadId 后按批补拉地址。
+    const createResp = await this.request<PersonalUploadResp>("/file/create", {
+      contentHash,
+      contentHashAlgorithm: "SHA256",
+      contentType: "application/octet-stream",
+      parallelUpload: false,
+      partInfos: partInfos.slice(0, 100),
+      size,
+      parentFileId: parentFileId || this.addition.root_folder_id || "/",
+      name,
+      type: "file",
+      fileRenameMode: "auto_rename",
+    })
+
+    const data = createResp.data
+    if (!data || !data.fileId || !data.uploadId) {
+      throw new Error(
+        `139 upload: /file/create returned no fileId/uploadId for ${name}`,
+      )
+    }
+
+    // 同内容文件已存在，云端不会重复新增，直接成功。
+    if (data.exist) return
+
+    // A 的口径：partInfos 为空表示没有可上传的分片，连 complete 都不发。
+    if (data.partInfos) {
+      const uploadPartInfos: PersonalPartInfo[] = [...data.partInfos]
+
+      for (let i = 100; i < partInfos.length; i += 100) {
+        const moreResp = await this.request<PersonalUploadUrlResp>(
+          "/file/getUploadUrl",
+          {
+            fileId: data.fileId,
+            uploadId: data.uploadId,
+            partInfos: partInfos.slice(i, i + 100),
+            commonAccountInfo: {
+              account: this.account,
+              accountType: 1,
+            },
+          },
+        )
+        const moreParts = moreResp.data?.partInfos
+        if (!moreParts || moreParts.length === 0) {
+          throw new Error(
+            `139 upload: /file/getUploadUrl returned no partInfos for ${name}`,
+          )
+        }
+        uploadPartInfos.push(...moreParts)
