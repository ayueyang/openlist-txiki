+        stage: "head",
+        attempt: 0,
+        event: "end",
+        ms: Date.now() - t0,
+        status: res.status,
+        err: "",
+        head_try: 0,
+      })
+      return res
+    } catch (e) {
+      logLink(lid, {
+        stage: "head",
+        attempt: 0,
+        event: "end",
+        ms: Date.now() - t0,
+        status: 0,
+        err: errText(e),
+        head_try: 0,
+        ...(isAbortErr(e) ? { aborted: 1 } : {}),
+      })
+      throw e
+    } finally {
+      clearTimeout(timer)
+    }
+  }
