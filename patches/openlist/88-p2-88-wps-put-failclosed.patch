diff --git a/src/backend/drivers/wps/driver.test.ts b/src/backend/drivers/wps/driver.test.ts
index d830410..1baf6e2 100644
--- a/src/backend/drivers/wps/driver.test.ts
+++ b/src/backend/drivers/wps/driver.test.ts
@@ -71,3 +71,45 @@ test("WpsDriver instantiation and methods", async () => {
   const link = await driver.link("/我的文档/doc.docx", "/我的文档/doc.docx")
   assert.equal(link.url, "https://ks3.kdocs.cn/download/doc.docx")
 })
+
+// ---- SPEC p2-88：上传 fail-closed（RED 先行，见 raw/10-before-p88-wps.log） ----
+
+test("WPS beginStream 存在且第一行即失败", async () => {
+  const driver = new WpsDriver({ cookie: "wps_sid=test_session_id", mode: "Personal" })
+  assert.equal(typeof (driver as any).beginStream, "function")
+  await assert.rejects(
+    (driver as any).beginStream("/我的文档/a.txt", "/我的文档/a.txt"),
+    /not implemented/,
+  )
+})
+
+test("WPS put 直接抛错，不再静默返回", async () => {
+  const driver = new WpsDriver({ cookie: "wps_sid=test_session_id", mode: "Personal" })
+  await assert.rejects(
+    driver.put("/我的文档/a.txt", "/我的文档/a.txt", Buffer.from("x")),
+    /not implemented/,
+  )
+})
+
+test("WPS 上传失败发生在任何网络请求之前", async () => {
+  const driver = new WpsDriver({ cookie: "wps_sid=test_session_id", mode: "Personal" })
+  const originalFetch = globalThis.fetch
+  let calls = 0
+  globalThis.fetch = (async () => {
+    calls++
+    return new Response("", { status: 200 })
+  }) as typeof fetch
+  try {
+    await assert.rejects(
+      driver.put("/我的文档/a.txt", "/我的文档/a.txt", Buffer.from("x")),
+      /not implemented/,
+    )
+    await assert.rejects(
+      (driver as any).beginStream("/我的文档/a.txt", "/我的文档/a.txt"),
+      /not implemented/,
+    )
+    assert.equal(calls, 0)
+  } finally {
+    globalThis.fetch = originalFetch
+  }
+})
