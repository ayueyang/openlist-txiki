@@ -0,0 +1,116 @@
+import assert from "node:assert/strict"
+import { test } from "node:test"
+import {
+  assertCanonicalPath,
+  canonicalizePath,
+  decodeWirePath,
+  parentPath,
+  PathRejectedError,
+  isPathRejected,
+} from "../pkg/canonical-path"
+
+/**
+ * P1-18 的唯一规范化函数表驱动测试（SPEC-P118 §7.3）。
+ *
+ * 判据：输出里不存在「整段全是点」的段、空段、尾斜杠；解码只在边界发生一次；
+ * 规范输出对自己幂等。
+ */
+
+test("canonicalizePath：折叠、拒绝与边界表", () => {
+  const ok: Array<[string, string]> = [
+    ["", "/"],
+    ["/", "/"],
+    ["///", "/"],
+    ["/a///b/./c", "/a/b/c"],
+    ["a\\b", "/a/b"],
+    ["/100%.txt", "/100%.txt"],
+    ["/100%25.txt", "/100%25.txt"],
+    ["/a..b.txt", "/a..b.txt"],
+    ["/..a.txt", "/..a.txt"],
+    ["/a..", "/a.."],
+    ["/50%20off.txt", "/50%20off.txt"],
+    ["/%zz", "/%zz"],
+    ["/@s/abc", "/@s/abc"],
+  ]
+  for (const [input, want] of ok) {
+    const got = canonicalizePath(input)
+    assert.deepEqual(got, { ok: true, path: want }, `canonicalizePath(${input})`)
+  }
+
+  const bad: Array<[string, string]> = [
+    ["/a/../b", "relative-path"],
+    ["/..../x", "relative-path"],
+    ["/.../x", "relative-path"],
+    ["/a/../../b", "relative-path"],
+    ["/%2e%2e/x", "encoded-residue"],
+    ["/%2E%2e/x", "encoded-residue"],
+    ["/%252e%252e/x", "encoded-residue"],
+    ["/a%2fb", "encoded-residue"],
+    ["/a%5cb", "encoded-residue"],
+    ["/a\0b", "illegal-char"],
+    ["/a\nb", "illegal-char"],
+    ["C:/x", "windows-abs"],
+    ["//host/x", "unc"],
+  ]
+  for (const [input, reason] of bad) {
+    const got = canonicalizePath(input)
+    assert.equal(got.ok, false, `canonicalizePath(${JSON.stringify(input)}) 应拒绝`)
+    if (!got.ok) assert.equal(got.reason, reason, `canonicalizePath(${JSON.stringify(input)}) reason`)
+  }
+})
+
+test("canonicalizePath：对自身输出幂等", () => {
+  const samples = ["/", "/sub/x", "/100%.txt", "/50%20off.txt", "/a/b/c", "/%zz", "/a..b.txt", "/100%25.txt"]
+  for (const s of samples) {
+    const c = canonicalizePath(s)
+    assert.equal(c.ok, true)
+    if (!c.ok) continue
+    const again = canonicalizePath(c.path)
+    assert.equal(again.ok, true)
+    if (again.ok) assert.equal(again.path, c.path, `幂等：${s}`)
+    assert.equal(c.path.split("/").some((s) => /^\.{2,}$/.test(s)), false)
+    assert.equal(c.path.includes("//"), false)
+    assert.equal(c.path.length > 1 ? c.path.endsWith("/") : false, false)
+  }
+})
+
+test("decodeWirePath：边界上恰好解码一次", () => {
+  assert.deepEqual(decodeWirePath("/100%25.txt"), { ok: true, path: "/100%.txt" })
+  assert.deepEqual(decodeWirePath("/100%.txt"), { ok: false })
+  assert.deepEqual(decodeWirePath("/%E4%B8%AD"), { ok: true, path: "/中" })
+  assert.deepEqual(decodeWirePath("/a/%zz"), { ok: false })
+  assert.deepEqual(decodeWirePath(""), { ok: true, path: "" })
+})
+
+test("parentPath：根与一级目录", () => {
+  const table: Array<[string, string]> = [
+    ["/", "/"],
+    ["/a", "/"],
+    ["/a/b", "/a"],
+    ["/t/locked/x.txt", "/t/locked"],
+    ["/t/locked/sub", "/t/locked"],
+  ]
+  for (const [p, want] of table) assert.equal(parentPath(p), want, `parentPath(${p})`)
+})
+
+test("PathRejectedError：状态码与文案对齐 Go", () => {
+  const rel = new PathRejectedError("relative-path")
+  assert.equal(rel.status, 403)
+  assert.equal(rel.message, "relative path")
+  const residue = new PathRejectedError("encoded-residue")
+  assert.equal(residue.status, 403)
+  assert.equal(residue.message, "relative path")
+  const illegal = new PathRejectedError("illegal-char")
+  assert.equal(illegal.status, 400)
+  assert.equal(illegal.message, "invalid path")
+  assert.equal(isPathRejected(rel), true)
+  assert.equal(isPathRejected(new Error("x")), false)
+})
+
+test("assertCanonicalPath：非规范形必须抛错（raw_url 生成侧用）", () => {
+  assert.equal(assertCanonicalPath("/a/b"), "/a/b")
+  assert.equal(assertCanonicalPath("/"), "/")
+  for (const p of ["/a/", "/a//b", "/a/./b", "/a/../b", "/%2e%2e/x"]) {
+    assert.throws(() => assertCanonicalPath(p), PathRejectedError, `assertCanonicalPath(${p})`)
+  }
+})
