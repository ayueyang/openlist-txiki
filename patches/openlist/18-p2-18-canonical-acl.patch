new file mode 100644
index 0000000..f370536
--- /dev/null
+++ b/src/backend/pkg/canonical-path.ts
@@ -0,0 +1,110 @@
+/**
+ * 唯一路径规范化函数（P1-18）。
+ *
+ * 安全不变量：**范围检查**（pkg/permission.getActualPath / isWithinUserRoot）与
+ * **实际解析**（internal/model/db.resolvePath）必须对同一个字符串给出同一个答案，
+ * 因此两边都只调用本文件的 canonicalizePath()，且本函数不解码。
+ *
+ * 历史缺陷：检查侧 normalizeSegments() 不解码、只折字面 ".."；解析侧 resolvePath()
+ * 最多解 4 次码、把 "%2f" 换成 "/"、把连续 3 个以上点折成 ".."。两套流水线
+ * 对 "/%252e%252e/x" 这类写法的答案不同，于是「检查放行、解析越界」。
+ *
+ * 设计取舍（详见 SPEC-P118）：
+ *  - 解码只发生在传输边界，各恰好一次（decodeWirePath）。JSON body 里的路径
+ *    本来就是解码后的形态，不能再解；
+ *  - 路径里出现「整段全是点且长度 >=2」的段（.. / ... / ....）一律拒绝
+ *    （不折叠、不钳制）。钳制会得到 200 空表，过不了「越界请求必须非 200」的
+ *    验收；"a..b.txt"、"..a.txt"、"a.." 是合法文件名，按段判而不是子串判；
+ *  - 二次编码残留（%2e/%2f/%5c，以及 %252e/%252f/%255c）一律拒绝：这是
+ *    「再解一次就会改变段结构」的集合；裸 %25 不再当残留（解码只在传输边界做
+ *    一次，字面 % 就是文件名字符，REG-NAME L5/L6）；只改字符不改结构的
+ *    %20、%41 放行。
+ */
+
+export type PathRejectReason =
+  | "illegal-char"
+  | "windows-abs"
+  | "unc"
+  | "relative-path"
+  | "encoded-residue"
+
+export class PathRejectedError extends Error {
+  readonly reason: PathRejectReason
+  readonly status: 400 | 403
+
+  constructor(reason: PathRejectReason) {
+    super(
+      reason === "relative-path" || reason === "encoded-residue"
+        ? "relative path"
+        : "invalid path",
+    )
+    this.name = "PathRejectedError"
+    this.reason = reason
+    this.status = reason === "relative-path" || reason === "encoded-residue" ? 403 : 400
+  }
+}
+
+/** 传输边界上恰好解码一次。非法百分号序列 / 孤立代理项返回 ok:false。 */
+export function decodeWirePath(
+  raw: string,
+): { ok: true; path: string } | { ok: false } {
+  try {
+    return { ok: true, path: decodeURIComponent(String(raw ?? "")) }
+  } catch {
+    return { ok: false }
+  }
+}
+
+/** 唯一规范化函数：不解码、不抛错。 */
+export function canonicalizePath(
+  input: string,
+): { ok: true; path: string } | { ok: false; reason: PathRejectReason } {
+  const s = String(input ?? "").replace(/\\/g, "/")
+  if (/[\0\r\n\t]/.test(s)) return { ok: false, reason: "illegal-char" }
+  if (/^[A-Za-z]:/.test(s)) return { ok: false, reason: "windows-abs" }
+  if (/^\/\/[^/]/.test(s)) return { ok: false, reason: "unc" }
+  // 按段判：只有「整段全是点且长度 >=2」（.. / ... / ....）才是越界写法。
+  // "a..b.txt"、"..a.txt"、"a.." 是合法文件名（Go 的 path.Clean 也只特判整段
+  // 等于 "." / ".."）；子串判会把合法名字一起挡掉（REG-NAME L1-L3 回归）。
+  const segs = s.split("/")
+  for (const seg of segs) {
+    if (/^\.{2,}$/.test(seg)) return { ok: false, reason: "relative-path" }
+  }
+  // 二次编码残留：只拒「再解一次就会改变段结构」的 %2e/%2f/%5c 与
+  // %252e/%252f/%255c。裸 %25 不再拒：解码只在传输边界做一次，字面 "%" 是
+  // 合法文件名字符（L5/L6）；但 %25 后面紧跟 2e/2f/5c 仍拒，否则 API body 里
+  // 的 /%252e%252e/x 会被当成普通文件名放行（82 条里 W/R/E 组要求非 2xx）。
+  if (/%(?:2e|2f|5c|25(?:2e|2f|5c))/i.test(s)) return { ok: false, reason: "encoded-residue" }
+  const stack: string[] = []
+  for (const seg of segs) {
+    if (!seg || seg === ".") continue
+    stack.push(seg)
+  }
+  return { ok: true, path: "/" + stack.join("/") }
+}
+
+/** 已规范路径的父目录（"/a" -> "/"，"/a/b" -> "/a"，"/" -> "/"）。 */
+export function parentPath(p: string): string {
+  const i = p.lastIndexOf("/")
+  return i <= 0 ? "/" : p.slice(0, i)
+}
+
+/**
+ * 规范化后必须与输入逐字节相同，否则抛 PathRejectedError。
+ * 给 raw_url 生成侧用：链接里不允许出现「再解一次就会改变段结构」的形态。
+ */
+export function assertCanonicalPath(p: string): string {
+  const c = canonicalizePath(p)
+  if (!c.ok) throw new PathRejectedError(c.reason)
+  if (c.path !== p) throw new PathRejectedError("relative-path")
+  return c.path
+}
+
+export function isPathRejected(e: unknown): e is PathRejectedError {
+  return e instanceof PathRejectedError
+}
+
+/** 统一响应：403 用 Go 的 "relative path" 文案，400 用 "invalid path"。 */
+export function pathRejectedResponse(c: any, e: PathRejectedError) {
+  return c.json({ code: e.status, message: e.message, data: null }, e.status)
+}
