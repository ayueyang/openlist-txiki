+/**
+ * 189 驱动走子进程 curl 的 HTTP 传输层。
+ *
+ * 背景（conductor 2026-11-03 设备实测，证据 work/cond-r35-189repro/）：
+ * cloud.189.cn 的会话按 TLS 客户端栈分流——curl（OpenSSL/HTTP2）取得的 Cookie
+ * 交给 txiki fetch（mbedtls/HTTP1.1）带走会被判 InvalidSessionKey；登录首跳同理
+ * （tjs 拿 200 + Tengine 静态页，curl 拿 302 + Set-Cookie）。
+ *
+ * 边界：不跟随重定向（调用方逐跳跟，便于逐跳收 Set-Cookie）；curl 不存在、非 0
+ * 退出、超时、响应头解析失败一律返回 null，由调用方回落 fetch。
+ */
+
+/** 设备现测：curl 8.21.0 在 /usr/bin/curl。 */
+const CURL_PATH = "/usr/bin/curl"
+const DEFAULT_MAX_TIME_S = 20
+/** 与 curl 自己的 --max-time 之外多留的余量，到点 SIGKILL。 */
+const HARD_TIMEOUT_MARGIN_MS = 5_000
+
+export interface CurlHttpResponse {
+  status: number
+  /** 响应头（名转小写；set-cookie 逐条放在 setCookies 里，不在这里合并）。 */
+  headers: Headers
+  /** 全部 Set-Cookie 原文，按出现顺序。 */
+  setCookies: string[]
+  body: string
+}
+
+export interface CurlHttpOptions {
+  method?: "GET" | "POST"
+  headers?: Record<string, string>
+  body?: string
+  maxTimeS?: number
+  /** 默认 https 就走 HTTP/2（与设备实测通过的 curl 口径一致）。 */
+  http2?: boolean
+}
+
+declare const tjs: any
+
+interface ParsedCurlOutput {
+  status: number
+  headerPairs: Array<[string, string]>
+  body: string
+}
+
+/**
+ * 解析 `curl -D -` 的输出：一个或多个头块 + body。
+ *
+ * 不跟随重定向时只有一个头块；1xx（100-continue）与紧接的状态行会继续往后找，
+ * 取最后一个头块作为最终响应。
+ */
+function parseCurlOutput(raw: string): ParsedCurlOutput | null {
+  let offset = 0
+  for (let guard = 0; guard < 10; guard++) {
+    const crlfEnd = raw.indexOf("\r\n\r\n", offset)
+    const lfEnd = raw.indexOf("\n\n", offset)
+    let end = -1
+    let sep = 0
+    if (crlfEnd !== -1 && (lfEnd === -1 || crlfEnd <= lfEnd)) {
+      end = crlfEnd
+      sep = 4
+    } else if (lfEnd !== -1) {
+      end = lfEnd
+      sep = 2
+    }
+    if (end === -1) return null
+
+    const lines = raw.slice(offset, end).split(/\r?\n/)
+    const statusLine = lines.shift() || ""
+    const match = statusLine.match(/^HTTP\/[0-9.]+\s+(\d{3})/)
+    if (!match) return null
+    const status = Number(match[1])
+
+    const headerPairs: Array<[string, string]> = []
+    for (const line of lines) {
+      const colon = line.indexOf(":")
+      if (colon <= 0) continue
+      headerPairs.push([
+        line.slice(0, colon).trim().toLowerCase(),
+        line.slice(colon + 1).trim(),
+      ])
+    }
+
+    const rest = raw.slice(end + sep)
+    const isInterim = status >= 100 && status < 200
+    const hasAnotherBlock = /^HTTP\/[0-9.]+\s+\d{3}/.test(rest)
+    if (isInterim || hasAnotherBlock) {
+      offset = end + sep
+      continue
+    }
+    return { status, headerPairs, body: rest }
+  }
+  return null
+}
+
+function buildArgs(url: string, options: CurlHttpOptions): string[] {
+  const maxTimeS = options.maxTimeS ?? DEFAULT_MAX_TIME_S
+  const args = [
+    CURL_PATH,
+    "-q",
+    "-sS",
+    "--max-time",
+    String(maxTimeS),
+    "-D",
+    "-",
+    // 关掉 100-continue（表单 body 到 KB 级时 curl 会自动加 Expect 头）。
+    "-H",
+    "Expect:",
+  ]
+  const useHttp2 = options.http2 ?? url.startsWith("https://")
+  if (useHttp2) args.push("--http2")
+  const method = options.method || "GET"
+  if (method === "POST") args.push("-X", "POST")
+  for (const [name, value] of Object.entries(options.headers || {})) {
+    if (value === undefined || value === null) continue
+    args.push("-H", `${name}: ${value}`)
+  }
+  if (options.body !== undefined) args.push("--data-binary", options.body)
+  args.push(url)
+  return args
+}
+
+/**
+ * 跑一次 curl 取完整响应；不可用 / 非 0 退出 / 超时 / 解析失败返回 null。
+ * 每次调用都是新进程，即新连接。
+ */
+export async function curlFetch(
+  url: string,
+  options: CurlHttpOptions = {},
+): Promise<CurlHttpResponse | null> {
+  const maxTimeS = options.maxTimeS ?? DEFAULT_MAX_TIME_S
+  let proc: any
+  try {
+    proc = tjs.spawn(buildArgs(url, options), {
+      stdout: "pipe",
+      stderr: "pipe",
+    })
+  } catch {
+    // ENOENT：curl 不存在。
+    return null
+  }
+
+  // 先挂上读取，避免子进程写满管道后卡死。
+  const stdoutText = new Response(proc.stdout).text()
+  const stderrText = new Response(proc.stderr).text()
+  let timer: any
+  const hardTimeout = new Promise<null>((resolve) => {
+    timer = setTimeout(() => {
+      try {
+        proc.kill("SIGKILL")
+      } catch {
+        // 进程已经退出。
+      }
+      resolve(null)
+    }, maxTimeS * 1000 + HARD_TIMEOUT_MARGIN_MS)
+  })
+  const finished = (async (): Promise<CurlHttpResponse | null> => {
+    const rc = await proc.wait()
+    const out = await stdoutText
+    await stderrText
+    // 设备现测：rc 是对象 {exit_status, term_signal}，不是数字。
+    if (!rc || rc.exit_status !== 0) return null
+    const parsed = parseCurlOutput(String(out))
+    if (!parsed) return null
+    const headers = new Headers()
+    const setCookies: string[] = []
+    for (const [name, value] of parsed.headerPairs) {
+      if (name === "set-cookie") setCookies.push(value)
+      else if (!headers.has(name)) headers.set(name, value)
+    }
+    return { status: parsed.status, headers, setCookies, body: parsed.body }
+  })().catch(() => null)
+
+  const result = await Promise.race([finished, hardTimeout])
+  clearTimeout(timer)
+  return result
+}
