+  /** 登录三步专用 cookie jar：实例内固定路径，/tmp 重启自清。 */
+  private loginJar = ""
+
+  private loginJarPath(): string {
+    if (!this.loginJar) {
+      const tmp =
+        (typeof process !== "undefined" && process.env?.TMPDIR) || "/tmp"
+      this.loginJar = `${tmp}/.openlist-189-jar-${Date.now().toString(36)}-${Math.random()
+        .toString(36)
+        .slice(2, 8)}`
+    }
+    return this.loginJar
+  }
+
+  /** 把 JS 侧按域 cookie 罐写成 curl 的 Netscape jar，供三步 POST 共用。 */
+  private async seedLoginJar(jarPath: string, cookie: string): Promise<void> {
+    const lines = ["# Netscape HTTP Cookie File"]
+    for (const part of String(cookie || "").split(";")) {
+      const trimmed = part.trim()
+      if (!trimmed) continue
+      const eq = trimmed.indexOf("=")
+      if (eq <= 0) continue
+      const name = trimmed.slice(0, eq).trim()
+      const value = trimmed.slice(eq + 1).trim()
+      if (!name) continue
+      lines.push([".189.cn", "TRUE", "/", "TRUE", "0", name, value].join("\t"))
+    }
+    const anyTjs = (globalThis as any).tjs
+    try {
+      if (anyTjs?.writeFile) {
+        await anyTjs.writeFile(jarPath, lines.join("\n") + "\n")
+      }
+    } catch (e: any) {
+      trace(`login jar write failed path=${jarPath} err=${e?.message || e}`)
+    }
+  }
+
+  private async removeLoginJar(): Promise<void> {
+    if (!this.loginJar) return
+    const jarPath = this.loginJar
+    this.loginJar = ""
+    try {
+      await (globalThis as any).tjs?.remove?.(jarPath)
+    } catch {
+      // /tmp 重启自清；删不掉不影响登录。
+    }
+  }
+
+  /**
+   * 登录 POST：curl 优先、fetch 回落（curl 不可用时 httpRequest 内回落）。
+   * Cookie 仍由 JS 侧按域罐给出；jar 让 curl 跨三个进程携带服务端下发值。
+   */
+  private async loginPost(
+    url: string,
+    headers: Record<string, string>,
+    form: URLSearchParams,
+    jarPath: string,
+  ): Promise<Response> {
+    return this.httpRequest(url, {
+      method: "POST",
+      headers,
+      body: form.toString(),
+      cookieSource: jarPath,
+      cookieJar: jarPath,
+    })
+  }
+
