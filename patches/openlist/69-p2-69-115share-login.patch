+import test from "node:test"
+import assert from "node:assert/strict"
+import { Pan115ShareApiClient } from "./util"
+import { Pan115ShareDriver } from "./driver"
+
+interface RecordedRequest {
+  url: string
+  method: string
+  headers: Record<string, string>
+  body?: string
+}
+
+// 全 mock fetch：记录 URL/方法/头，不连网、不登录。
+function mockFetch(handler: (req: RecordedRequest) => unknown) {
+  const calls: RecordedRequest[] = []
+  const original = globalThis.fetch
+  ;(globalThis as any).fetch = async (input: any, init: any = {}) => {
+    const url = typeof input === "string" ? input : String(input?.url ?? input)
+    const headers: Record<string, string> = {}
+    for (const [k, v] of Object.entries(init.headers || {})) {
+      headers[String(k).toLowerCase()] = String(v)
+    }
+    const req: RecordedRequest = {
+      url,
+      method: String(init.method || "GET").toUpperCase(),
+      headers,
+      body: init.body,
+    }
+    calls.push(req)
+    const payload = handler(req)
+    return new Response(JSON.stringify(payload), {
+      status: 200,
+      headers: { "content-type": "application/json" },
+    })
+  }
+  return {
+    calls,
+    restore: () => {
+      globalThis.fetch = original
+    },
+  }
+}
+
+test("有 cookie：init 请求顺序是 snap -> my.115.com status，status 带 Cookie", async (t) => {
+  const mock = mockFetch((req) => {
+    if (req.url.includes("/share/snap")) {
+      return { state: true, data: { count: 0, list: [] } }
+    }
+    return { state: true }
+  })
+  t.after(mock.restore)
+
+  const client = new Pan115ShareApiClient({
+    share_code: "sc1",
+    receive_code: "rc1",
+    cookie: "UID=1;CID=2;SEID=3",
+  })
+  await client.init()
+
+  assert.equal(mock.calls.length, 2)
+  assert.ok(mock.calls[0].url.startsWith("https://webapi.115.com/share/snap"))
+  const snapUrl = new URL(mock.calls[0].url)
+  assert.equal(snapUrl.searchParams.get("share_code"), "sc1")
+  assert.equal(snapUrl.searchParams.get("receive_code"), "rc1")
+  assert.equal(snapUrl.searchParams.get("cid"), "0")
+
+  assert.ok(mock.calls[1].url.startsWith("https://my.115.com/"))
+  assert.match(mock.calls[1].url, /ct=guide/)
+  assert.match(mock.calls[1].url, /ac=status/)
+  assert.equal(mock.calls[1].headers["cookie"], "UID=1;CID=2;SEID=3")
+})
+
+test("无 cookie：init 只发 1 条 snap 并 resolve，公开分享不被登录打断", async (t) => {
+  const mock = mockFetch(() => ({ state: true, data: { count: 0, list: [] } }))
+  t.after(mock.restore)
+
+  const client = new Pan115ShareApiClient({
+    share_code: "sc1",
+    receive_code: "rc1",
+  })
+  await client.init()
+
+  assert.equal(mock.calls.length, 1)
+  assert.ok(mock.calls[0].url.includes("/share/snap"))
+})
+
+test("只有 qrcode_token：rejects /扫码登录未接线/ 且零请求", async (t) => {
+  const mock = mockFetch(() => {
+    throw new Error("qrcode 路径不应发请求")
+  })
+  t.after(mock.restore)
+
+  const client = new Pan115ShareApiClient({
+    share_code: "sc1",
+    receive_code: "rc1",
+    qrcode_token: "qr-token",
+  })
+  await assert.rejects(client.init(), /扫码登录未接线/)
+  assert.equal(mock.calls.length, 0)
+})
+
+test("短键 snap 归一化：目录/文件/大小正确", async (t) => {
+  const mock = mockFetch((req) => {
+    if (req.url.includes("/share/snap")) {
+      return {
+        state: true,
+        data: {
+          count: 2,
+          list: [
+            { cid: "c1", n: "Folder1", fc: 0, t: 1700000000 },
+            { fid: "f1", n: "video.mp4", fc: 1, s: 10240, t: 1700000000 },
+          ],
+        },
+      }
+    }
+    return { state: true }
+  })
+  t.after(mock.restore)
+
+  const driver = new Pan115ShareDriver({
+    share_code: "sc1",
+    receive_code: "rc1",
+  })
+  const items = await driver.list("/", "/")
+
+  assert.equal(items.length, 2)
+  const folder = items.find((item) => item.name === "Folder1")
+  const file = items.find((item) => item.name === "video.mp4")
+  assert.ok(folder, "Folder1 应出现在列表里")
+  assert.ok(file, "video.mp4 应出现在列表里")
+  assert.equal(folder!.is_dir, true)
+  assert.equal(file!.is_dir, false)
+  assert.equal(file!.size, 10240)
+})
+
+test("getDownloadUrl：GET + dl=1 + 115cdn share Referer", async (t) => {
+  const mock = mockFetch(() => ({
+    state: true,
+    data: { url: { url: "https://cdn.example/f1" } },
+  }))
+  t.after(mock.restore)
+
+  const client = new Pan115ShareApiClient({
+    share_code: "sc1",
+    receive_code: "rc1",
+  })
+  const url = await client.getDownloadUrl("f1")
+
+  assert.equal(url, "https://cdn.example/f1")
+  assert.equal(mock.calls.length, 1)
+  assert.equal(mock.calls[0].method, "GET")
+  const downloadUrl = new URL(mock.calls[0].url)
+  assert.equal(downloadUrl.searchParams.get("share_code"), "sc1")
+  assert.equal(downloadUrl.searchParams.get("receive_code"), "rc1")
+  assert.equal(downloadUrl.searchParams.get("file_id"), "f1")
+  assert.equal(downloadUrl.searchParams.get("dl"), "1")
+  assert.match(mock.calls[0].headers["referer"], /115cdn\.com\/s\/sc1/)
+})
+
+test("getDownloadUrl：兼容 data.url 字符串响应", async (t) => {
+  const mock = mockFetch(() => ({
+    state: true,
+    data: { url: "https://cdn.example/f2" },
+  }))
+  t.after(mock.restore)
+
+  const client = new Pan115ShareApiClient({
+    share_code: "sc1",
+    receive_code: "rc1",
+  })
+  assert.equal(await client.getDownloadUrl("f2"), "https://cdn.example/f2")
+})
+
+test("limit_rate 换算：2 -> 500ms；未设 -> 0", () => {
+  const limited = new Pan115ShareApiClient({
+    share_code: "s",
+    receive_code: "r",
+    limit_rate: 2,
+  })
+  assert.equal((limited as any).rateLimitMs, 500)
+
+  const unlimited = new Pan115ShareApiClient({
+    share_code: "s",
+    receive_code: "r",
+  })
+  assert.equal((unlimited as any).rateLimitMs, 0)
+})
