+/**
+ * P2-66：/api/fs/copy 与 /api/fs/move 的撞名 preflight。
+ *
+ * Go 版（server/handles/fsmanage.go:123-131 与 :222-231）在 !Overwrite 时逐个
+ * 检查目标，命中且不允许跳过就回 403 `file [x] exists`；检查全部跑完之前不会
+ * 搬任何一项。本模块只负责「查完再返回名单」，不接触驱动，因此调用方只要在
+ * 驱动动作之前调用一次，批量里任一撞名时一个都不会动。
+ */
+
+export class WriteConflictError extends Error {
+  constructor(public itemName: string) {
+    super(`file [${itemName}] exists`)
+  }
+}
+
+export interface WriteConflictOptions {
+  overwrite?: boolean
+  skipExisting?: boolean
+}
+
+/**
+ * 逐个名字查重；返回真正要执行的名单。
+ *
+ * - overwrite===true：原样返回全部，不查重（保持既有覆盖语义）。
+ * - 撞名且 skipExisting===true：跳过该项。
+ * - 撞名且未允许跳过：抛 WriteConflictError，整个批量不执行。
+ */
+export async function filterWriteTargets(
+  names: string[],
+  exists: (name: string) => Promise<boolean>,
+  opts: WriteConflictOptions,
+): Promise<string[]> {
+  if (opts.overwrite === true) return [...names]
+  const selected: string[] = []
+  for (const name of names) {
+    if (!(await exists(name))) {
+      selected.push(name)
+      continue
+    }
+    if (opts.skipExisting === true) continue
+    throw new WriteConflictError(name)
+  }
+  return selected
+}
