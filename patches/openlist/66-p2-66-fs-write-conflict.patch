@@ -0,0 +1,250 @@
+/**
+ * P2-66：/api/fs/copy 与 /api/fs/move 撞名行为的 handler 级验收。
+ *
+ * 全部本地、mock 存储（local 驱动 + 临时目录），不连网、不登录、不用真实账号。
+ * 用例编号对应 rulings.md B-3 的验收 1-7：
+ *   1 copy 撞名 403 + 两侧内容不变
+ *   2 copy overwrite:true 200 + 目标被覆盖
+ *   3 move 撞名 403 + 源与目标都不变
+ *   4 move overwrite:true 200 + 源消失、目标为源内容
+ *   5 批量 [x 不撞, y 撞]：403 且 x 没有被驱动处理
+ *   6 copy skip_existing:true 200 + 目标保持旧内容、源仍在
+ *   7 copy merge:true 400 + message 含 merge，源与目标不变
+ *
+ * 本文件不 import write-conflict.ts：在 01..65 树上（无实现）也能直接跑，
+ * 用真实 HTTP 行为产出 before-FAIL 证据。
+ */
+import assert from "node:assert/strict"
+import { test } from "node:test"
+import { Hono } from "hono"
+import { mkdtemp, mkdir, writeFile, readFile, rm } from "node:fs/promises"
+import { tmpdir } from "node:os"
+import { dirname, join } from "node:path"
+
+import { saveDb } from "../internal/model/db"
+import { fsRouter } from "./fs"
+
+const env: any = {}
+const ADMIN_TOKEN = "ADMIN_STATIC_TOKEN"
+
+const app = new Hono()
+app.route("/api/fs", fsRouter)
+
+async function seed(root: string, id: string) {
+  await saveDb(
+    {
+      settings: [{ key: "token", value: ADMIN_TOKEN }],
+      users: [
+        {
+          id: 1,
+          username: "admin",
+          password: "xxx",
+          role: 2,
+          permission: 0,
+          base_path: "/",
+          disabled: false,
+        },
+      ],
+      storages: [
+        {
+          id,
+          mount_path: "/",
+          driver: "local",
+          disabled: false,
+          addition: JSON.stringify({ root_folder_path: root }),
+        },
+      ],
+      shares: [],
+    },
+    env,
+  )
+}
+
+function post(route: string, body: any) {
+  return app.request(`/api/fs/${route}`, {
+    method: "POST",
+    headers: {
+      "Content-Type": "application/json",
+      Authorization: ADMIN_TOKEN,
+    },
+    body: JSON.stringify(body),
+  })
+}
+
+async function makeTree(files: Record<string, string>): Promise<string> {
+  const root = await mkdtemp(join(tmpdir(), "openlist-wc-"))
+  for (const [rel, content] of Object.entries(files)) {
+    const full = join(root, rel)
+    await mkdir(dirname(full), { recursive: true })
+    await writeFile(full, content)
+  }
+  return root
+}
+
+async function readOrMissing(path: string): Promise<string | null> {
+  try {
+    return await readFile(path, "utf8")
+  } catch {
+    return null
+  }
+}
+
+test("1 copy 撞名：HTTP 403，body 逐字 file [x] exists，目标与源都不变", async (t) => {
+  const root = await makeTree({ "a/x": "AAA", "b/x": "BBB" })
+  t.after(() => rm(root, { recursive: true, force: true }))
+  await seed(root, "wc-copy-1")
+
+  const res = await post("copy", {
+    src_dir: "/a",
+    dst_dir: "/b",
+    names: ["x"],
+  })
+
+  assert.equal(res.status, 403)
+  assert.deepEqual(await res.json(), {
+    code: 403,
+    message: "file [x] exists",
+    data: null,
+  })
+  assert.equal(await readOrMissing(join(root, "a/x")), "AAA")
+  assert.equal(await readOrMissing(join(root, "b/x")), "BBB")
+})
+
+test("2 copy overwrite:true：HTTP 200，目标被源覆盖", async (t) => {
+  const root = await makeTree({ "a/x": "AAA", "b/x": "BBB" })
+  t.after(() => rm(root, { recursive: true, force: true }))
+  await seed(root, "wc-copy-2")
+
+  const res = await post("copy", {
+    src_dir: "/a",
+    dst_dir: "/b",
+    names: ["x"],
+    overwrite: true,
+  })
+
+  assert.equal(res.status, 200)
+  assert.equal(await readOrMissing(join(root, "a/x")), "AAA")
+  assert.equal(await readOrMissing(join(root, "b/x")), "AAA")
+})
+
+test("3 move 撞名：HTTP 403，源仍存在且目标内容不变", async (t) => {
+  const root = await makeTree({ "a/x": "AAA", "b/x": "BBB" })
+  t.after(() => rm(root, { recursive: true, force: true }))
+  await seed(root, "wc-move-3")
+
+  const res = await post("move", {
+    src_dir: "/a",
+    dst_dir: "/b",
+    names: ["x"],
+  })
+
+  assert.equal(res.status, 403)
+  assert.deepEqual(await res.json(), {
+    code: 403,
+    message: "file [x] exists",
+    data: null,
+  })
+  assert.equal(await readOrMissing(join(root, "a/x")), "AAA")
+  assert.equal(await readOrMissing(join(root, "b/x")), "BBB")
+})
+
+test("4 move overwrite:true：HTTP 200，源消失、目标为源内容", async (t) => {
+  const root = await makeTree({ "a/x": "AAA", "b/x": "BBB" })
+  t.after(() => rm(root, { recursive: true, force: true }))
+  await seed(root, "wc-move-4")
+
+  const res = await post("move", {
+    src_dir: "/a",
+    dst_dir: "/b",
+    names: ["x"],
+    overwrite: true,
+  })
+
+  assert.equal(res.status, 200)
+  assert.equal(await readOrMissing(join(root, "a/x")), null)
+  assert.equal(await readOrMissing(join(root, "b/x")), "AAA")
+})
+
+test("5 copy 批量 [x 不撞, y 撞]：403 且 x 没有被驱动处理（preflight 在所有动作之前）", async (t) => {
+  const root = await makeTree({
+    "a/x": "X-FREE",
+    "a/y": "Y-SRC",
+    "b/y": "Y-TAKEN",
+  })
+  t.after(() => rm(root, { recursive: true, force: true }))
+  await seed(root, "wc-copy-5")
+
+  const res = await post("copy", {
+    src_dir: "/a",
+    dst_dir: "/b",
+    names: ["x", "y"],
+  })
+
+  assert.equal(res.status, 403)
+  assert.deepEqual(await res.json(), {
+    code: 403,
+    message: "file [y] exists",
+    data: null,
+  })
+  // x 是第一个名字且不撞名。若 preflight 边查边做，x 会先被复制到 /b/x。
+  assert.equal(await readOrMissing(join(root, "b/x")), null)
+  assert.equal(await readOrMissing(join(root, "a/x")), "X-FREE")
+  assert.equal(await readOrMissing(join(root, "b/y")), "Y-TAKEN")
+})
+
+test("5b move 批量 [x 不撞, y 撞]：403 且 x 没有被搬走", async (t) => {
+  const root = await makeTree({
+    "a/x": "X-FREE",
+    "a/y": "Y-SRC",
+    "b/y": "Y-TAKEN",
+  })
+  t.after(() => rm(root, { recursive: true, force: true }))
+  await seed(root, "wc-move-5b")
+
+  const res = await post("move", {
+    src_dir: "/a",
+    dst_dir: "/b",
+    names: ["x", "y"],
+  })
+
+  assert.equal(res.status, 403)
+  assert.equal(await readOrMissing(join(root, "a/x")), "X-FREE")
+  assert.equal(await readOrMissing(join(root, "b/x")), null)
+})
+
+test("6 copy skip_existing:true：HTTP 200，目标保持旧内容、源仍在", async (t) => {
+  const root = await makeTree({ "a/x": "AAA", "b/x": "BBB" })
+  t.after(() => rm(root, { recursive: true, force: true }))
+  await seed(root, "wc-copy-6")
+
+  const res = await post("copy", {
+    src_dir: "/a",
+    dst_dir: "/b",
+    names: ["x"],
+    skip_existing: true,
+  })
+
+  assert.equal(res.status, 200)
+  assert.equal(await readOrMissing(join(root, "a/x")), "AAA")
+  assert.equal(await readOrMissing(join(root, "b/x")), "BBB")
+})
+
+test("7 copy merge:true：HTTP 400，message 含 merge，源与目标都不变", async (t) => {
+  const root = await makeTree({ "a/x": "AAA", "b/x": "BBB" })
+  t.after(() => rm(root, { recursive: true, force: true }))
+  await seed(root, "wc-copy-7")
+
+  const res = await post("copy", {
+    src_dir: "/a",
+    dst_dir: "/b",
+    names: ["x"],
+    merge: true,
+  })
+
+  assert.equal(res.status, 400)
+  const body: any = await res.json()
+  assert.equal(body.code, 400)
+  assert.match(String(body.message), /merge/)
+  assert.equal(await readOrMissing(join(root, "a/x")), "AAA")
+  assert.equal(await readOrMissing(join(root, "b/x")), "BBB")
+})
