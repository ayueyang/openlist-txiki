+/**
+ * P2-66：写冲突 preflight 的单元级验收（rulings.md B-3 验收用例 1-7 的等价覆盖）。
+ *
+ * 这里只测 filterWriteTargets / WriteConflictError 本身，不接触驱动。
+ * 用例 7（copy + merge:true 回 400）是 handler 层行为，write-conflict.ts 里没有
+ * merge 分支，因此不在本文件覆盖；由 fs.write-conflict.test.ts 断言。
+ */
+import assert from "node:assert/strict"
+import { test } from "node:test"
+
+import {
+  filterWriteTargets,
+  WriteConflictError,
+} from "./write-conflict"
+
+test("单个撞名：抛 WriteConflictError，消息逐字为 file [x] exists", async () => {
+  await assert.rejects(
+    filterWriteTargets(["x"], async () => true, {}),
+    (e: any) => {
+      assert.ok(e instanceof WriteConflictError)
+      assert.equal(e.itemName, "x")
+      assert.equal(e.message, "file [x] exists")
+      return true
+    },
+  )
+})
+
+test("overwrite:true：原样放行全部名字，且不调用查重回调", async () => {
+  let calls = 0
+  const selected = await filterWriteTargets(
+    ["x", "y"],
+    async () => {
+      calls++
+      return true
+    },
+    { overwrite: true },
+  )
+  assert.deepEqual(selected, ["x", "y"])
+  assert.equal(calls, 0)
+})
+
+test("skipExisting:true：撞名项被跳过，返回空数组（调用方回 200 success）", async () => {
+  const selected = await filterWriteTargets(["x"], async () => true, {
+    skipExisting: true,
+  })
+  assert.deepEqual(selected, [])
+})
+
+test("skipExisting:true：只跳过撞名项，不撞的照常返回且顺序不变", async () => {
+  const selected = await filterWriteTargets(
+    ["x", "y", "z"],
+    async (name) => name === "y",
+    { skipExisting: true },
+  )
+  assert.deepEqual(selected, ["x", "z"])
+})
+
+test("批量 [不撞, 撞]：抛错；exists 按名字顺序被调用，说明查完才可能进入动作", async () => {
+  const seen: string[] = []
+  await assert.rejects(
+    filterWriteTargets(
+      ["x", "y"],
+      async (name) => {
+        seen.push(name)
+        return name === "y"
+      },
+      {},
+    ),
+    (e: any) => e instanceof WriteConflictError && e.itemName === "y",
+  )
+  assert.deepEqual(seen, ["x", "y"])
+})
+
+test("全部不撞：返回完整名单，顺序与输入一致", async () => {
+  const selected = await filterWriteTargets(["a", "b", "c"], async () => false, {})
+  assert.deepEqual(selected, ["a", "b", "c"])
+})
+
+test("撞名判定按每个名字单独进行：前一项不撞、后一项撞，抛的是后一项", async () => {
+  await assert.rejects(
+    filterWriteTargets(
+      ["free", "taken"],
+      async (name) => name === "taken",
+      {},
+    ),
+    (e: any) => {
+      assert.ok(e instanceof WriteConflictError)
+      assert.equal(e.message, "file [taken] exists")
+      assert.equal(e.itemName, "taken")
+      return true
+    },
+  )
+})
