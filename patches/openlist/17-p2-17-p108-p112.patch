       return permissionDenied(c)
+    // P1-08：目标已存在且未显式 overwrite:true 时回 403，对齐 Go
+    // fsmanage.go:314-318 的 file [x] exists；此前会静默覆盖目标并删掉源文件。
+    const parentPath = actualOldPath.slice(0, actualOldPath.lastIndexOf("/")) || "/"
