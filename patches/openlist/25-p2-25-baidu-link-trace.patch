+// --- 取链日志打点（诊断用，只记录，不改变请求与控制流） ---
+const LINK_LOG_PREFIX = "[baidu_netdisk][link]"
+const linkAttempts = new Map<string, number>()
+
+function errText(e: any): string {
+  return `${e?.name || "Error"}: ${e?.message !== undefined ? e.message : String(e)}`
+}
+
+function linkWarn(e: any): string {
+  const msg = String(e?.message || e || "").toLowerCase()
+  if (msg.includes("read failed")) return "read_failed"
+  if (msg.includes("timed out") || msg.includes("timeout")) return "timeout"
+  return "other"
+}
+
+function logLink(lid: string, fields: Record<string, string | number>): void {
+  if (!lid) return
+  const parts = Object.entries(fields).map(([k, v]) =>
+    k === "err" ? `${k}="${v}"` : `${k}=${v}`,
+  )
+  console.warn(`${LINK_LOG_PREFIX} lid=${lid} ${parts.join(" ")}`)
+}
+
+function linkSummary(
+  lid: string,
+  filemetasMs: number,
+  headMs: number,
+  retries: number,
+  warn: string,
+): void {
+  if (!lid) return
+  linkAttempts.delete(lid)
+  console.warn(
+    `${LINK_LOG_PREFIX} lid=${lid} summary filemetas_ms=${filemetasMs} head_ms=${headMs} retries=${retries} warn=${warn}`,
+  )
+}
+
