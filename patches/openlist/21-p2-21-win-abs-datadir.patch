@@ -34,6 +34,29 @@ const DEFAULTS = {
   readonly: true,
 }
 
+// 绝对路径判定。POSIX 只认 "/"（与 r13 逐字符相同）；Windows 另认盘符与 UNC：
+// "X:/"、"X:\"、"\\server\share"（UNC 两种写法都以两个反斜杠开头）。
+function isAbsolutePath(p: string, windows: boolean): boolean {
+  if (p.startsWith("/")) return true
+  if (!windows) return false
+  if (/^[A-Za-z]:[\\/]/.test(p)) return true
+  if (p.startsWith("\\\\")) return true
+  return false
+}
+
+function isWindowsEnv(env: Record<string, string>): boolean {
+  return env.OS === "Windows_NT"
+}
+
+// 默认数据目录：Windows 用 %LOCALAPPDATA%\openlist-txiki；LOCALAPPDATA 为空时退回
+// 当前目录（不猜别的盘）。其它平台保持 /etc/openlist-txiki 一字不改。
+function defaultDataDir(env: Record<string, string>): string {
+  if (!isWindowsEnv(env)) return DEFAULTS.dataDir
+  const base = (env.LOCALAPPDATA || "").replace(/[\/]+$/, "")
+  if (base) return `${base}\\openlist-txiki`
+  return (tjs as any).cwd || "."
+}
+
 export function loadConfig(): TxikiConfig {
   const env = (tjs.env || {}) as Record<string, string>
   let file: Record<string, any> = {}
