+
+  assert.ok(readLens.length > 0, "读块必须经过 tjs.read")
+  assert.ok(Math.max(...readLens) <= 65536, "读块上限 64KiB")
+  assert.equal(readLens.reduce((a, b) => a + b, 0), 5 * MB)
+})
+
+test("4 4xx：错误含 403 与前 300 字符，spool 已删", async () => {
+  uploadStatus = 403
+  uploadText = "denied by policy: token invalid or expired"
+  const d = makeDriver()
+  const w = await (d as any).beginStream("docs/a.bin", 3)
+  await w.write(new Uint8Array([1, 2, 3]))
+  await assert.rejects(() => w.commit(), (e: any) => {
+    assert.match(String(e.message), /403/)
+    assert.ok(String(e.message).includes(uploadText.slice(0, 300)))
+    return true
+  })
+  assert.deepEqual(await readdir(spoolDir), [])
+})
+
+test("5 abort：不发上传 POST，spool 已删", async () => {
+  const d = makeDriver()
+  const w = await (d as any).beginStream("docs/a.bin", 2 * MB)
+  await w.write(new Uint8Array(MB))
+  await w.abort()
+  assert.equal(calls.length, 0)
+  assert.deepEqual(await readdir(spoolDir), [])
+})
+
+test("6 长度不符：expectedSize=10 写 11 字节即抛错", async () => {
+  const d = makeDriver()
+  const w = await (d as any).beginStream("docs/a.bin", 10)
+  await assert.rejects(() => w.write(new Uint8Array(11)), /声明长度与实际不符/)
+  assert.equal(calls.length, 0)
+})
