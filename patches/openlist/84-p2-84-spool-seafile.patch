+// SPEC p2-77（补丁 84）：seafile 落盘暂存 + 流式 multipart 单元测试。
+// 全部 mock globalThis.fetch 与 globalThis.tjs：不连网、不需要真实 seafile。
+import assert from "node:assert/strict"
+import { afterEach, beforeEach, test } from "node:test"
+import * as fsp from "node:fs/promises"
+import { mkdtemp, readdir, rm } from "node:fs/promises"
+import { tmpdir } from "node:os"
+import { join } from "node:path"
+
+import { SeafileDriver } from "./driver"
+
+const MB = 1024 * 1024
+const realFetch = globalThis.fetch
+const realTjs = (globalThis as any).tjs
+
+interface FetchCall {
+  url: string
+  method: string
+  body: any
+  duplex?: string
+}
+
+let calls: FetchCall[] = []
+let spoolDir = ""
+let readLens: number[] = []
+let uploadStatus = 200
+let uploadText = ""
+let statFsBavail = 1024 * 1024
+let fullBody: Uint8Array | null = null
+
+function jsonResponse(body: any): any {
+  const text = JSON.stringify(body)
+  return {
+    ok: true,
+    status: 200,
+    headers: { get: () => "application/json" },
+    text: async () => text,
+    json: async () => JSON.parse(text),
+  }
+}
+
+function textResponse(status: number, text: string): any {
+  return {
+    ok: status >= 200 && status < 300,
+    status,
+    headers: { get: () => "text/plain" },
+    text: async () => text,
+    json: async () => JSON.parse(text),
+  }
+}
+
+async function readAllStream(body: any): Promise<Uint8Array> {
+  const reader = body.getReader()
+  const chunks: Uint8Array[] = []
+  let total = 0
+  for (;;) {
+    const { done, value } = await reader.read()
+    if (done) break
+    chunks.push(value)
+    total += value.byteLength
+  }
+  const out = new Uint8Array(total)
+  let off = 0
+  for (const c of chunks) {
+    out.set(c, off)
+    off += c.byteLength
+  }
+  return out
+}
+
+function indexOfBytes(haystack: Uint8Array, needle: Uint8Array, from = 0): number {
+  outer: for (let i = from; i + needle.length <= haystack.length; i++) {
+    for (let j = 0; j < needle.length; j++) {
+      if (haystack[i + j] !== needle[j]) continue outer
+    }
+    return i
+  }
+  return -1
+}
+
+function makeDriver(): SeafileDriver {
+  return new SeafileDriver({
+    address: "https://seafile.test",
+    token: "test-token",
+    repo_id: "repo-1",
+  } as any)
+}
+
+beforeEach(async () => {
+  calls = []
+  readLens = []
+  uploadStatus = 200
+  uploadText = ""
+  statFsBavail = 1024 * 1024
+  fullBody = null
+  spoolDir = await mkdtemp(join(tmpdir(), "seafile-p84-"))
+  ;(globalThis as any).tjs = {
+    env: { UPLOAD_SPOOL_DIR: spoolDir },
+    statFs: async () => ({ bsize: 4096, bavail: statFsBavail }),
+    open: async (p: string, mode: "r" | "w") => {
+      const fh = await fsp.open(p, mode)
+      return {
+        write: async (chunk: Uint8Array) => {
+          const r = await fh.write(chunk)
+          return r.bytesWritten
+        },
+        read: async (buf: Uint8Array, position: number) => {
+          readLens.push(buf.byteLength)
+          const r = await fh.read(buf, 0, buf.byteLength, position)
+          return r.bytesRead
+        },
+        close: async () => fh.close(),
+      }
+    },
+  }
+  globalThis.fetch = (async (input: any, init?: any) => {
+    const url = String(input)
+    const method = String(init?.method || "GET").toUpperCase()
+    calls.push({ url, method, body: init?.body, duplex: init?.duplex })
+    if (url.includes("/upload-link/")) {
+      return jsonResponse("https://upload.seafile.test/u/abc")
+    }
+    if (url.startsWith("https://upload.seafile.test/")) {
+      fullBody = await readAllStream(init.body)
+      return textResponse(uploadStatus, uploadText || "ok")
+    }
+    throw new Error("unexpected fetch: " + url)
+  }) as any
+})
+
+afterEach(async () => {
+  globalThis.fetch = realFetch
+  ;(globalThis as any).tjs = realTjs
+  await rm(spoolDir, { recursive: true, force: true })
+})
+
+test("1 能力探测：beginStream 存在", () => {
+  const d = makeDriver()
+  assert.equal(typeof (d as any).beginStream, "function")
