+/** begin 时至少预留 fileSize + 64MiB。 */
+const SPOOL_MIN_FREE = 64 * 1024 * 1024
+/** 出站流读块，与 txiki/shims/fs.ts 的 createReadStream 同口径。 */
+const SPOOL_READ_CHUNK = 64 * 1024
+
+/**
+ * 从 spool 读句柄建出站流：pull 驱动、64KiB 一块、空闲不读。
+ * 不用 txiki/shims/fs 的 createReadStream：那是适配层文件，静态 import 会把
+ * tjs:path 拖进 Node 单测，驱动文件必须保持 node 可加载。
+ */
+function spoolReadStream(
+  handle: SpoolHandle,
+  size: number,
+): ReadableStream<Uint8Array> {
+  let pos = 0
+  return new ReadableStream<Uint8Array>({
+    async pull(controller) {
+      if (pos >= size) {
+        controller.close()
+        return
+      }
+      const want = Math.min(SPOOL_READ_CHUNK, size - pos)
+      const buf = new Uint8Array(want)
+      let got = 0
+      while (got < want) {
+        const n = await handle.readAt(buf.subarray(got), pos + got)
+        if (!(n > 0)) throw new Error("seafile spool 读取提前结束")
+        got += n
+      }
+      pos += want
+      controller.enqueue(buf)
+      if (pos >= size) controller.close()
+    },
+  })
+}
 
