+
+test("7 空间不足：写第一块前抛错", async () => {
+  statFsBavail = 1
+  const d = makeDriver()
+  await assert.rejects(
+    () => (d as any).beginStream("docs/a.bin", 5 * MB),
+    /空间不足/,
+  )
