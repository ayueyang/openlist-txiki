+  /**
+   * 本地维护：txiki 上传内存上限。seafile 的 PUT 走流式 multipart：
+   * 文件来自盘上的 spool，按 64KiB 拉块进请求体，内存不随文件大小增长。
+   * duplex: "half" 是 txiki fetch polyfill 对 ReadableStream 请求体的硬要求。
+   */
+  async postMultipartStream(
+    url: string,
+    fields: Record<string, string>,
+    file: { name: string; stream: ReadableStream<Uint8Array> },
+  ): Promise<void> {
+    const boundary = `----openlist-${randomHex(16)}`
+    const enc = new TextEncoder()
+    let head = ""
+    for (const [k, v] of Object.entries(fields)) {
+      head += `--${boundary}\r\nContent-Disposition: form-data; name="${k}"\r\n\r\n${v}\r\n`
+    }
+    head +=
+      `--${boundary}\r\nContent-Disposition: form-data; name="file"; filename="${file.name}"` +
+      `\r\nContent-Type: application/octet-stream\r\n\r\n`
+    const headBytes = enc.encode(head)
+    const tailBytes = enc.encode(`\r\n--${boundary}--\r\n`)
+    const reader = file.stream.getReader()
+    let phase: 0 | 1 | 2 = 0
+    const body = new ReadableStream<Uint8Array>({
+      async pull(controller) {
+        if (phase === 0) {
+          phase = 1
+          controller.enqueue(headBytes)
+          return
+        }
+        if (phase === 1) {
+          const { done, value } = await reader.read()
+          if (done) {
+            phase = 2
+            controller.enqueue(tailBytes)
+            controller.close()
+            return
+          }
+          controller.enqueue(value)
+        }
+      },
+      async cancel(reason) {
+        try {
+          await reader.cancel(reason)
+        } catch {}
+      },
+    })
+    const headers: Record<string, string> = {
+      Accept: "application/json",
+      "Content-Type": `multipart/form-data; boundary=${boundary}`,
+    }
+    if (this.authorization) headers["Authorization"] = this.authorization
+    const res = await fetch(url, {
+      method: "POST",
+      headers,
+      body,
+      duplex: "half",
+    } as any)
+    if (!res.ok) {
+      let text = ""
+      try {
+        text = await res.text()
+      } catch {}
+      throw new Error(
+        `Seafile upload failed (${res.status}): ${text.slice(0, 300)}`,
+      )
+    }
+    try {
+      await res.body?.cancel()
+    } catch {}
+  }
