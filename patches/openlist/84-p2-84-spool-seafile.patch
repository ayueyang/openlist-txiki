+})
+
+test("2/3 5MiB 三块写入：2 次 fetch、body 是流、读块 <=64KiB、字节一致", async () => {
+  const d = makeDriver()
+  const src = new Uint8Array(5 * MB)
+  for (let i = 0; i < src.length; i++) src[i] = (i * 31 + 7) & 0xff
+
+  const w = await (d as any).beginStream("docs/a.bin", 5 * MB)
+  await w.write(src.subarray(0, 2 * MB))
+  await w.write(src.subarray(2 * MB, 4 * MB))
+  await w.write(src.subarray(4 * MB, 5 * MB))
+  await w.commit()
+
+  assert.equal(calls.length, 2, "upload-link + 上传 POST")
+  assert.ok(calls[1].body instanceof ReadableStream, "POST body 必须是 ReadableStream")
+  assert.equal(calls[1].duplex, "half")
+  assert.ok(String(calls[1].url).includes("upload.seafile.test"))
+
+  // 从流里取回完整 body 再解析文件段（fetch mock 已读一遍；这里重放不便，
+  // 改为在 mock 内保存）。见下方 fullBody。
+  const body = fullBody!
+  assert.ok(body.byteLength > 5 * MB)
+  const head = Buffer.from(body).toString("latin1")
+  assert.ok(head.includes("name=\"parent_dir\"") && head.includes("docs"))
+  assert.ok(head.includes("name=\"replace\"") && head.includes("\r\n\r\n1\r\n"))
