--- /dev/null
+++ b/src/backend/drivers/terabox/part-upload.test.ts
@@ -0,0 +1,205 @@
+// SPEC p2-78（补丁 85）：terabox 分片上传与落盘暂存单元测试。
+// mock globalThis.fetch 与 globalThis.tjs：不连网、不需要真实 terabox 账号。
+import assert from "node:assert/strict"
+import { afterEach, beforeEach, test } from "node:test"
+import * as fsp from "node:fs/promises"
+import { mkdtemp, readdir, rm } from "node:fs/promises"
+import { tmpdir } from "node:os"
+import { join } from "node:path"
+import { createHash } from "node:crypto"
+
+import { TeraboxDriver, calculateChunkSize } from "./driver"
+
+const MB = 1024 * 1024
+const GB = 1024 * MB
+const realFetch = globalThis.fetch
+const realTjs = (globalThis as any).tjs
+
+interface FetchCall {
+  url: string
+  method: string
+  body: any
+}
+interface PartRec {
+  partseq: number
+  bytes: Uint8Array
+}
+
+let calls: FetchCall[] = []
+let spoolDir = ""
+let readLens: number[] = []
+let parts: PartRec[] = []
+let precreateResp: any = { errno: 0, return_type: 1, uploadid: "up-1" }
+let partFailAt = -1
+let createResp: any = { errno: 0 }
+let createBody: URLSearchParams | null = null
+let createCount = 0
+
+function jsonResponse(body: any): any {
+  const text = JSON.stringify(body)
+  return {
+    ok: true,
+    status: 200,
+    headers: { get: () => "application/json" },
+    text: async () => text,
+    json: async () => JSON.parse(text),
+  }
+}
+
+function okResponse(): any {
+  return {
+    ok: true,
+    status: 200,
+    headers: { get: () => "application/json" },
+    text: async () => "{}",
+    json: async () => ({}),
+  }
+}
+
+function errResponse(status: number): any {
+  return {
+    ok: false,
+    status,
+    headers: { get: () => "text/plain" },
+    text: async () => "boom",
+    json: async () => ({}),
+  }
+}
+
+function makeDriver(): TeraboxDriver {
+  return new TeraboxDriver({ cookie: "test-cookie" } as any)
+}
+
+beforeEach(async () => {
+  calls = []
+  readLens = []
+  parts = []
+  partFailAt = -1
+  precreateResp = { errno: 0, return_type: 1, uploadid: "up-1" }
+  createResp = { errno: 0 }
+  createBody = null
+  createCount = 0
+  spoolDir = await mkdtemp(join(tmpdir(), "terabox-p85-"))
+  ;(globalThis as any).tjs = {
+    env: { UPLOAD_SPOOL_DIR: spoolDir },
+    statFs: async () => ({ bsize: 4096, bavail: 1024 * 1024 }),
+    open: async (p: string, mode: "r" | "w") => {
+      const fh = await fsp.open(p, mode)
+      return {
+        write: async (chunk: Uint8Array) => (await fh.write(chunk)).bytesWritten,
+        read: async (buf: Uint8Array, position: number) => {
+          readLens.push(buf.byteLength)
+          const r = await fh.read(buf, 0, buf.byteLength, position)
+          return r.bytesRead
+        },
+        close: async () => fh.close(),
+      }
+    },
+  }
+  globalThis.fetch = (async (input: any, init?: any) => {
+    const url = String(input)
+    const method = String(init?.method || "GET").toUpperCase()
+    calls.push({ url, method, body: init?.body })
+    if (url.includes("method=locateupload")) {
+      return jsonResponse({ host: "d.terabox.com" })
+    }
+    if (url.includes("/api/precreate")) {
+      return jsonResponse(precreateResp)
+    }
+    if (url.includes("/rest/2.0/pcs/superfile2")) {
+      const u = new URL(url)
+      const partseq = Number(u.searchParams.get("partseq"))
+      const form: FormData = init.body
+      const file = form.get("file") as File
+      const bytes = new Uint8Array(await file.arrayBuffer())
+      parts.push({ partseq, bytes })
+      if (partFailAt === partseq) return errResponse(500)
+      return okResponse()
+    }
+    if (url.includes("/api/create")) {
+      createCount++
+      createBody = new URLSearchParams(String(init.body))
+      return jsonResponse(createResp)
+    }
+    throw new Error("unexpected fetch: " + url)
+  }) as any
+})
+
+afterEach(async () => {
+  globalThis.fetch = realFetch
+  ;(globalThis as any).tjs = realTjs
+  await rm(spoolDir, { recursive: true, force: true })
+})
+
+test("1 calculateChunkSize 表驱动", () => {
+  assert.equal(calculateChunkSize(1), 1)
+  assert.equal(calculateChunkSize(4 * MB), 4 * MB)
+  assert.equal(calculateChunkSize(4 * MB + 1), 4 * MB)
+  assert.equal(calculateChunkSize(5 * MB), 4 * MB)
+  assert.equal(calculateChunkSize(4 * GB + 1), 8 * MB)
+  assert.equal(calculateChunkSize(8 * GB + 1), 16 * MB)
+})
+
+test("2/3/6 10MiB：precreate 1 次、分片 3 次、create 1 次、block_list 3 项", async () => {
+  const d = makeDriver()
+  const src = new Uint8Array(10 * MB)
+  for (let i = 0; i < src.length; i++) src[i] = (i * 17 + 3) & 0xff
+  const w = await (d as any).beginStream("docs/big.bin", 10 * MB)
+  await w.write(src)
+  await w.commit()
+
+  const pre = calls.filter((c) => c.url.includes("/api/precreate"))
+  assert.equal(pre.length, 1)
+  assert.equal(parts.length, 3)
+  assert.deepEqual(parts.map((p) => p.partseq), [0, 1, 2])
+  assert.deepEqual(parts.map((p) => p.bytes.length), [4 * MB, 4 * MB, 2 * MB])
+  for (let i = 0; i < 3; i++) {
+    const off = i * 4 * MB
+    const wantMd5 = createHash("md5").update(src.subarray(off, off + parts[i].bytes.length)).digest("hex")
+    const gotMd5 = createHash("md5").update(parts[i].bytes).digest("hex")
+    assert.equal(gotMd5, wantMd5)
+  }
+  assert.equal(createCount, 1)
+  assert.ok(createBody)
+  const blockList = JSON.parse(createBody!.get("block_list") || "[]")
+  assert.equal(blockList.length, 3)
+  const fullMd5 = createHash("md5").update(src).digest("hex")
+  assert.ok(!blockList.includes(fullMd5))
+  assert.equal(createBody!.get("size"), String(10 * MB))
+
+  assert.equal(readLens.length, 3, "每片一次 readAt")
+  assert.ok(Math.max(...readLens) <= 4 * MB)
+  assert.deepEqual(await readdir(spoolDir), [])
+})
+
+test("4 第 2 片回 500：只发 2 片、错误含 part 2/3、spool 已删", async () => {
+  partFailAt = 1
+  const d = makeDriver()
+  const w = await (d as any).beginStream("docs/big.bin", 10 * MB)
+  await w.write(new Uint8Array(10 * MB))
+  await assert.rejects(() => w.commit(), /part 2\/3 failed: HTTP 500/)
+  assert.equal(parts.length, 2)
+  assert.equal(createCount, 0)
+  assert.deepEqual(await readdir(spoolDir), [])
+})
+
+test("5 秒传：return_type=2 不再发片、不调 create、spool 已删", async () => {
+  precreateResp = { errno: 0, return_type: 2, uploadid: "up-2" }
+  const d = makeDriver()
+  const w = await (d as any).beginStream("docs/big.bin", 10 * MB)
+  await w.write(new Uint8Array(10 * MB))
+  await w.commit()
+  assert.equal(parts.length, 0)
+  assert.equal(createCount, 0)
+  assert.deepEqual(await readdir(spoolDir), [])
+})
+
+test("7 put 兼容路径：3MiB 走同一实现、片上字节一致", async () => {
+  const d = makeDriver()
+  const src = new Uint8Array(3 * MB)
+  for (let i = 0; i < src.length; i++) src[i] = (i * 7 + 1) & 0xff
+  await d.put("/docs/small.bin", "docs/small.bin", Buffer.from(src))
+  assert.equal(parts.length, 1)
+  assert.deepEqual(parts[0].bytes, src)
+  assert.deepEqual(await readdir(spoolDir), [])
+})
