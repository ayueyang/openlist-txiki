+++ b/src/backend/drivers/123_open/util.test.ts
@@ -0,0 +1,110 @@
+import assert from "node:assert/strict"
+import { afterEach, test } from "node:test"
+
+import { Client123Open } from "./util"
+
+const realFetch = globalThis.fetch
+
+afterEach(() => {
+  globalThis.fetch = realFetch
+})
+
+interface MockOpts {
+  listCode: number
+  refresh: "ok" | "fail"
+  expiresIn?: number
+}
+
+/** 假服务端：/api/v1/access_token 走刷新，其余当文件列表 */
+function installMock(opts: MockOpts) {
+  const calls = { list: 0, refresh: 0 }
+  globalThis.fetch = (async (input: any) => {
+    const url = String(input)
+    if (url.includes("/api/v1/access_token")) {
+      calls.refresh++
+      if (opts.refresh === "fail") {
+        return {
+          ok: true,
+          status: 200,
+          json: async () => ({ code: -1, message: "bad refresh" }),
+        }
+      }
+      return {
+        ok: true,
+        status: 200,
+        json: async () => ({
+          code: 0,
+          message: "ok",
+          data: { access_token: "t-new", expires_in: opts.expiresIn ?? 7200 },
+        }),
+      }
+    }
+    calls.list++
+    return {
+      ok: true,
+      status: 200,
+      json: async () =>
+        opts.listCode === 0
+          ? { code: 0, message: "ok", data: { file_list: [], last_file_id: -1 } }
+          : { code: opts.listCode, message: "unauthorized" },
+    }
+  }) as any
+  return calls
+}
+
+function newClient() {
+  return new Client123Open({
+    client_id: "id",
+    client_secret: "sec",
+    use_online_api: false,
+  } as any)
+}
+
+test("123_open 401 后只刷新一次，二次 401 直接报错", async () => {
+  const calls = installMock({ listCode: 401, refresh: "ok" })
+  const client = newClient()
+
+  await assert.rejects(() => client.getFiles("0"), /401 after token refresh/)
+  assert.equal(calls.refresh, 1)
+  assert.equal(calls.list, 2)
+})
+
+test("123_open 刷新失败即熔断，后续请求不再打刷新接口", async () => {
+  const calls = installMock({ listCode: 401, refresh: "fail" })
+  const client = newClient()
+
+  await assert.rejects(() => client.getFiles("0"), /bad refresh/)
+  assert.equal(calls.refresh, 1)
+  assert.equal(calls.list, 1)
+
+  await assert.rejects(() => client.getFiles("0"), /Authentication expired/)
+  assert.equal(calls.refresh, 1)
+  assert.equal(calls.list, 2)
+})
+
+test("123_open 到期前 5 分钟主动刷新，不等 401", async () => {
+  const calls = installMock({ listCode: 0, refresh: "ok", expiresIn: 120 })
+  const client = newClient()
+
+  await client.init()
+  assert.equal(calls.refresh, 1)
+  assert.equal(calls.list, 0)
+
+  await client.getFiles("0")
+  assert.equal(calls.refresh, 2)
+  assert.equal(calls.list, 1)
+})
+
+test("123_open 连续 401 不递归爆栈，每轮最多一次刷新", async () => {
+  const calls = installMock({ listCode: 401, refresh: "ok" })
+  const client = newClient()
+
+  for (let i = 0; i < 5; i++) {
+    await assert.rejects(
+      () => client.getFiles("0"),
+      (e: any) => e instanceof Error && !(e instanceof RangeError) && /401 after token refresh/.test(e.message),
+    )
+  }
+  assert.equal(calls.refresh, 5)
+  assert.equal(calls.list, 10)
+})
