diff --git a/src/backend/server/webdav.ts b/src/backend/server/webdav.ts
index 7da5b90..50106b5 100644
--- a/src/backend/server/webdav.ts
+++ b/src/backend/server/webdav.ts
@@ -35,6 +35,7 @@ import {
   removeItems,
   moveItems,
   copyItems,
+  renameItem,
 } from "../internal/op/storage"
 import { buildWebDavPropfindResponse } from "../internal/webdav/webdav"
 import { safeErrorMessage } from "../pkg/errs"
@@ -441,6 +442,12 @@ webdavRouter.all("/*", async (c) => {
           return metaForbidden(c)
         }
         await moveItems(src.dir, dst.dir, [src.name], ctx)
+        // C 段：Destination 的文件名与源不同时才是真正的「重命名 + 移动」。
+        // op/storage 的 moveItems 按 src.name 落到 dst.dir，这里补一次 renameItem
