+        if (dst.name && dst.name !== src.name) {
+          await renameItem(`${dst.dir}/${src.name}`, dst.name, ctx)
+        }
         return c.body(null, 201)
       }
 
@@ -468,6 +475,11 @@ webdavRouter.all("/*", async (c) => {
           return metaForbidden(c)
         }
         await copyItems(src.dir, dst.dir, [src.name], ctx)
+        // 同 MOVE：COPY 到不同文件名是「复制 + 改名」，moveItems/copyItems 只认
+        // dst.dir，这里补 renameItem 才能让 Destination 的文件名生效。
+        if (dst.name && dst.name !== src.name) {
+          await renameItem(`${dst.dir}/${src.name}`, dst.name, ctx)
+        }
         return c.body(null, 201)
       }
 
