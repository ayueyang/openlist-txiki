+// SPEC p2-90：默认直连 oauth.yandex.com，第三方在线刷新必须显式 opt-in（RED 先行）
+import assert from "node:assert/strict"
+import test from "node:test"
+import { YandexApiClient, normalizeYandexAddition } from "./util"
+
+interface Call {
+  url: string
+  method: string
+  body: string
+}
+
+function stubFetch(payload: any = { access_token: "a", refresh_token: "b" }) {
+  const calls: Call[] = []
+  const original = globalThis.fetch
+  globalThis.fetch = (async (input: any, init?: any) => {
+    calls.push({
+      url: String(input),
+      method: String(init?.method || "GET").toUpperCase(),
+      body: String(init?.body ?? ""),
+    })
+    return new Response(JSON.stringify(payload), {
+      status: 200,
+      headers: { "content-type": "application/json" },
+    })
+  }) as typeof fetch
+  return { calls, restore: () => { globalThis.fetch = original } }
+}
+
+test("默认配置直连 oauth.yandex.com/token，不带 refresh_ui", async () => {
+  const { calls, restore } = stubFetch()
+  try {
+    const client = new YandexApiClient({ refresh_token: "r" })
+    await client.refreshToken()
+    assert.equal(calls.length, 1)
+    const u = new URL(calls[0].url)
+    assert.equal(u.origin + u.pathname, "https://oauth.yandex.com/token")
+    assert.equal(u.search.includes("refresh_ui"), false)
+    assert.equal(calls[0].method, "POST")
+    assert.match(calls[0].body, /grant_type=refresh_token/)
+    assert.match(calls[0].body, /refresh_token=r/)
+    assert.match(calls[0].body, /client_id=a78d5a69054042fa936f6c77f9a0ae8b/)
+    assert.match(calls[0].body, /client_secret=9c119bbb04b346d2a52aa64401936b2b/)
+  } finally {
+    restore()
+  }
+})
+
+test('字符串 "false" 归一成布尔 false，仍走直连', async () => {
+  const { calls, restore } = stubFetch()
+  try {
+    const client = new YandexApiClient({
+      refresh_token: "r",
+      use_online_api: "false" as any,
+    })
+    await client.refreshToken()
+    const u = new URL(calls[0].url)
+    assert.equal(u.origin + u.pathname, "https://oauth.yandex.com/token")
+  } finally {
+    restore()
+  }
+})
+
+test("显式 opt-in 才走第三方地址，且带 refresh_ui", async () => {
+  const { calls, restore } = stubFetch()
+  try {
+    const client = new YandexApiClient({
+      refresh_token: "r",
+      use_online_api: true,
+      api_url_address: "http://127.0.0.1:9/x",
+    })
+    await client.refreshToken()
+    assert.equal(calls.length, 1)
+    const u = new URL(calls[0].url)
+    assert.equal(u.origin + u.pathname, "http://127.0.0.1:9/x")
+    assert.equal(u.searchParams.get("refresh_ui"), "r")
+  } finally {
+    restore()
+  }
+})
+
+test("init() 只刷新一次，回调拿到新 token", async () => {
+  const { calls, restore } = stubFetch({ access_token: "acc1", refresh_token: "ref1" })
+  try {
+    const seen: any[] = []
+    const client = new YandexApiClient(
+      { refresh_token: "r" },
+      async (tokens) => { seen.push(tokens) },
+    )
+    await client.init()
+    assert.equal(calls.length, 1)
+    assert.deepEqual(seen, [{ accessToken: "acc1", refreshToken: "ref1" }])
+  } finally {
+    restore()
+  }
+})
+
+test("normalize 补齐默认 client_id/client_secret 且 use_online_api 归一为布尔", () => {
+  const norm: any = normalizeYandexAddition({ refresh_token: "r" } as any)
+  assert.equal(norm.client_id, "a78d5a69054042fa936f6c77f9a0ae8b")
+  assert.equal(norm.client_secret, "9c119bbb04b346d2a52aa64401936b2b")
+  assert.equal(norm.use_online_api, false)
+})
