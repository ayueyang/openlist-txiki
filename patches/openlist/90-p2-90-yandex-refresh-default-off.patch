+const YANDEX_CLIENT_ID = "a78d5a69054042fa936f6c77f9a0ae8b"
+const YANDEX_CLIENT_SECRET = "9c119bbb04b346d2a52aa64401936b2b"
+
+export function normalizeYandexAddition(a: YandexAddition): YandexAddition {
+  const norm: any = { ...(a || {}) }
+  norm.use_online_api =
+    norm.use_online_api === true ||
+    (typeof norm.use_online_api === "string" &&
+      norm.use_online_api.trim().toLowerCase() === "true")
+  norm.client_id = (norm.client_id || "").trim() || YANDEX_CLIENT_ID
+  norm.client_secret = (norm.client_secret || "").trim() || YANDEX_CLIENT_SECRET
+  return norm as YandexAddition
+}
