diff --git a/src/backend/drivers/189pc/routing.test.ts b/src/backend/drivers/189pc/routing.test.ts
new file mode 100644
index 0000000..e69de4a
--- /dev/null
+++ b/src/backend/drivers/189pc/routing.test.ts
@@ -0,0 +1,54 @@
+import assert from "node:assert/strict"
+import { afterEach, beforeEach, test } from "node:test"
+
+import { getDriver } from "../../internal/op/storage"
+
+const realFetch = globalThis.fetch
+
+// 这两条用例不该发任何网络请求：旧实现会把 189pc 路由进 Cloud189Driver 并尝试登录。
+// 真发请求就立刻失败，避免外网依赖，也让「错路由」表现成可读的断言失败。
+beforeEach(() => {
+  globalThis.fetch = (async () => {
+    throw new Error("routing test must not call fetch")
+  }) as any
+})
+
+afterEach(() => {
+  globalThis.fetch = realFetch
+})
+
+function cfg(id: string) {
+  return {
+    id,
+    driver: "189pc",
+    mount_path: "/189pc",
+    addition: JSON.stringify({ username: "u", password: "p" }),
+    modified: 1,
+    disabled: false,
+  }
+}
+
+/**
+ * 负向 1：driver=189pc 必须显式失败。
+ * 旧实现用 normDriver.startsWith("189") 把它吞进 Cloud189Driver，等于用 189 的
+ * 协议去跑 189pc 的配置（189pc/driver.ts 的 list/link/move 签名与 StorageDriver 不一致）。
+ */
+test("driver=189pc 显式拒绝，不被 startsWith(189) 路由进 189 驱动", async () => {
+  await assert.rejects(
+    () => getDriver("189pc", cfg("r57-neg-189pc")),
+    (e: any) => {
+      assert.match(String(e?.message), /189pc/)
+      assert.match(String(e?.message), /未接线/)
+      assert.doesNotMatch(String(e?.message), /189Cloud|Cloud189Driver/)
+      return true
+    },
+  )
+})
+
+/** 负向 2：任意 189 开头的未知名不再被模糊匹配成 189 驱动。 */
+test("未知的 189 开头驱动名落到 unsupported driver，而不是 189", async () => {
+  await assert.rejects(
+    () => getDriver("189abc", cfg("r57-neg-189abc")),
+    /unsupported driver/,
+  )
+})
