diff -ruN a/src/backend/drivers/mega/driver.failclosed.test.ts b/src/backend/drivers/mega/driver.failclosed.test.ts
--- a/src/backend/drivers/mega/driver.failclosed.test.ts	1970-01-01 08:00:00.000000000 +0800
+++ b/src/backend/drivers/mega/driver.failclosed.test.ts	2026-11-09 03:49:15.580261600 +0800
@@ -0,0 +1,43 @@
+import test from "node:test"
+import assert from "node:assert/strict"
+import { MegaDriver } from "./driver"
+import { MegaAddition } from "./types"
+
+// Mega 的 put / rename / copy 在 txiki 运行时没有实现，必须显式抛错，
+// 不能 console.warn 后返回成功。unsupported 判断在节点解析之前，
+// 因此这些用例不需要登录、不需要 mock client、不连网。
+
+const addition: MegaAddition = {
+  email: "test@example.com",
+  password: "not-a-real-password",
+}
+
+async function expectUnsupported(op: string, run: () => Promise<unknown>) {
+  await assert.rejects(run, (err: any) => {
+    const msg = String(err && err.message)
+    assert.match(msg, /Mega/, `message must name Mega: ${msg}`)
+    assert.match(msg, new RegExp(`\\(${op}\\)`), `message must name op ${op}: ${msg}`)
+    return true
+  })
+}
+
+test("MegaDriver.put is fail-closed", async () => {
+  const driver = new MegaDriver(addition)
+  await expectUnsupported("put", () =>
+    driver.put("/", "/a.txt", new Uint8Array([1, 2, 3])),
+  )
+})
+
+test("MegaDriver.rename is fail-closed before node lookup", async () => {
+  const driver = new MegaDriver(addition)
+  await expectUnsupported("rename", () =>
+    driver.rename("/", "/a.txt", "b.txt"),
+  )
+})
+
+test("MegaDriver.copy is fail-closed", async () => {
+  const driver = new MegaDriver(addition)
+  await expectUnsupported("copy", () =>
+    driver.copy("/src", "/dst", ["a.txt"], "/src/a.txt", "/dst/a.txt"),
+  )
+})
