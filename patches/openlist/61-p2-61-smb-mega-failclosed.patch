--- a/src/backend/drivers/smb/driver.failclosed.test.ts	1970-01-01 08:00:00.000000000 +0800
+++ b/src/backend/drivers/smb/driver.failclosed.test.ts	2026-11-09 03:49:15.517139800 +0800
@@ -0,0 +1,72 @@
+import test from "node:test"
+import assert from "node:assert/strict"
+import { SMBDriver } from "./driver"
+import { SMBAddition } from "./types"
+
+// SMB 在 txiki 运行时没有实现（无 node:net / SMB 客户端）。
+// 所有方法必须 fail-closed：抛错，而不是返回空数组 / 编造条目 / 空体成功。
+// 这些用例不连网、不登录、不读任何真实配置。
+
+const addition: SMBAddition = {
+  address: "127.0.0.1",
+  username: "guest",
+  password: "",
+  share_name: "share",
+}
+
+async function expectUnsupported(op: string, run: () => Promise<unknown>) {
+  await assert.rejects(run, (err: any) => {
+    const msg = String(err && err.message)
+    assert.match(msg, /SMB/, `message must name SMB: ${msg}`)
+    assert.match(msg, new RegExp(`\\(${op}\\)`), `message must name op ${op}: ${msg}`)
+    return true
+  })
+}
+
+test("SMBDriver.list is fail-closed", async () => {
+  const driver = new SMBDriver(addition)
+  await expectUnsupported("list", () => driver.list("/", "/"))
+})
+
+test("SMBDriver.get is fail-closed", async () => {
+  const driver = new SMBDriver(addition)
+  await expectUnsupported("get", () => driver.get("/", "/x.txt"))
+})
+
+test("SMBDriver.mkdir is fail-closed", async () => {
+  const driver = new SMBDriver(addition)
+  await expectUnsupported("mkdir", () => driver.mkdir("/", "/newdir"))
+})
+
+test("SMBDriver.rename is fail-closed", async () => {
+  const driver = new SMBDriver(addition)
+  await expectUnsupported("rename", () =>
+    driver.rename("/", "/a.txt", "b.txt"),
+  )
+})
+
+test("SMBDriver.remove is fail-closed", async () => {
+  const driver = new SMBDriver(addition)
+  await expectUnsupported("remove", () => driver.remove("/", "/a.txt", ["a.txt"]))
+})
+
+test("SMBDriver.move is fail-closed", async () => {
+  const driver = new SMBDriver(addition)
+  await expectUnsupported("move", () =>
+    driver.move("/src", "/dst", ["a.txt"], "/src/a.txt", "/dst/a.txt"),
+  )
+})
+
+test("SMBDriver.copy is fail-closed", async () => {
+  const driver = new SMBDriver(addition)
+  await expectUnsupported("copy", () =>
+    driver.copy("/src", "/dst", ["a.txt"], "/src/a.txt", "/dst/a.txt"),
+  )
+})
+
+test("SMBDriver.put is fail-closed", async () => {
+  const driver = new SMBDriver(addition)
+  await expectUnsupported("put", () =>
+    driver.put("/", "/a.txt", new Uint8Array([1, 2, 3])),
+  )
+})
