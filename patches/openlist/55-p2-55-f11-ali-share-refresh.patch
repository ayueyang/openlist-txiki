diff --git a/src/backend/drivers/aliyundrive_share/driver.token.test.ts b/src/backend/drivers/aliyundrive_share/driver.token.test.ts
new file mode 100644
--- /dev/null
+++ b/src/backend/drivers/aliyundrive_share/driver.token.test.ts
@@ -0,0 +1,333 @@
+import test from "node:test"
+import assert from "node:assert/strict"
+import { createServer } from "node:http"
+import type { IncomingMessage, ServerResponse } from "node:http"
+import type { AddressInfo } from "node:net"
+import { AliyundriveShareDriver } from "./driver"
+import { AliyundriveShareAddition } from "./types"
+
+/** 本地 mock，不登录真实账号：按路径返回固定 JSON 并记录请求。 */
+type MockRoute = (ctx: {
+  body: any
+  headers: Record<string, any>
+  count: number
+}) => { status?: number; json?: any }
+
+type Recorded = {
+  method: string
+  path: string
+  headers: Record<string, any>
+  body: any
+}
+
+async function startMock(routes: Record<string, MockRoute>) {
+  const calls: Recorded[] = []
+  const counts = new Map<string, number>()
+
+  const server = createServer((req: IncomingMessage, res: ServerResponse) => {
+    const chunks: Buffer[] = []
+    req.on("data", (c: Buffer) => chunks.push(c))
+    req.on("end", () => {
+      const raw = Buffer.concat(chunks)
+      const path = req.url || "/"
+      const count = (counts.get(path) || 0) + 1
+      counts.set(path, count)
+
+      let body: any = null
+      const text = raw.toString("utf8")
+      if (text) {
+        try {
+          body = JSON.parse(text)
+        } catch {
+          body = text
+        }
+      }
+      calls.push({
+        method: req.method || "",
+        path,
+        headers: req.headers as Record<string, any>,
+        body,
+      })
+
+      const route = routes[path]
+      if (!route) {
+        res.writeHead(404, { "content-type": "application/json" })
+        res.end(JSON.stringify({ error: `no mock route for ${path}` }))
+        return
+      }
+      const result = route({ body, headers: req.headers, count })
+      const status = result.status ?? 200
+      const payload = JSON.stringify(result.json ?? {})
+      res.writeHead(status, {
+        "content-type": "application/json",
+        "content-length": String(Buffer.byteLength(payload)),
+      })
+      res.end(payload)
+    })
+  })
+
+  await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve))
+  const port = (server.address() as AddressInfo).port
+
+  return {
+    port,
+    calls,
+    callsTo: (path: string) => calls.filter((c) => c.path === path),
+    close: () => new Promise<void>((resolve) => server.close(() => resolve())),
+  }
+}
+
+function pointAt(driver: AliyundriveShareDriver, port: number) {
+  const client = (driver as any).client
+  client.authHost = `http://127.0.0.1:${port}`
+  client.apiHost = `http://127.0.0.1:${port}`
+}
+
+test("aliyundrive_share init: 用 refresh_token 换 access_token 并把轮换后的值交给回调", async () => {
+  const mock = await startMock({
+    "/v2/account/token": () => ({
+      json: { access_token: "a1", refresh_token: "r1", expires_in: 7200 },
+    }),
+    "/v2/share_link/get_share_token": () => ({
+      json: { share_token: "s1", expires_in: 7200 },
+    }),
+  })
+  const addition: AliyundriveShareAddition = {
+    share_id: "share1",
+    refresh_token: "r0",
+  }
+  const persisted: string[] = []
+  const driver = new AliyundriveShareDriver(addition, async (t) => {
+    persisted.push(t)
+  })
+  pointAt(driver, mock.port)
+  try {
+    await driver.init()
+    const auth = mock.callsTo("/v2/account/token")[0]
+    assert.ok(auth, "没有调 auth 端点")
+    assert.deepEqual(auth.body, {
+      refresh_token: "r0",
+      grant_type: "refresh_token",
+    })
+    assert.deepEqual(persisted, ["r1"])
+    assert.equal(addition.refresh_token, "r1")
+  } finally {
+    await mock.close()
+  }
+})
+
