+/**
+ * P2-75：A meta.go:21-40 字段与 O 的 PascalCase 旧键归一。
+ * 显式 auth_mode 永远优先；缺省按现有凭据推断（W 老配置无 auth_mode，
+ * 缺省值不能让它们起不来）。未知取值直接报错（A client.go:42 同义）。
+ */
+export function normalize123OpenAddition(
+  a: any,
+): Driver123OpenAddition {
+  const norm: any = { ...(a || {}) }
+  const mode = norm.auth_mode
+  if (
+    mode !== undefined &&
+    mode !== "" &&
+    mode !== "token" &&
+    mode !== "client_credentials"
+  ) {
+    throw new Error(`[123Open] unknown auth_mode: ${mode}`)
+  }
+  if (!mode) {
+    if (norm.access_token || norm.refresh_token) norm.auth_mode = "token"
+    else if (norm.client_id && norm.client_secret)
+      norm.auth_mode = "client_credentials"
+    else norm.auth_mode = "token"
+  }
+  norm.private_key = norm.private_key || norm.DirectLinkPrivateKey || ""
+  norm.uid = Number(norm.uid ?? 0)
+  const duration = Number(
+    norm.valid_duration ?? norm.DirectLinkValidDuration ?? 30,
+  )
+  norm.valid_duration = Number.isFinite(duration) && duration > 0 ? duration : 30
+  norm.use_direct_link = norm.use_direct_link ?? norm.DirectLink ?? false
+  norm.upload_thread = Number(norm.upload_thread ?? norm.UploadThread ?? 3)
+  return norm as Driver123OpenAddition
+}
