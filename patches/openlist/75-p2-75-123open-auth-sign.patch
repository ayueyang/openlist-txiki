+
+/**
+ * P2-75：A sign.go:13-30 的逐行移植（auth_key 直链签名）。
+ * 空私钥原样返回；ts = 当前秒 + 有效分钟数*60；rand 默认随机。
+ * path 用解码后的 pathname（对齐 Go url.Parse 的 Path），解码失败回退原值。
+ */
+export function sign123Url(
+  originUrl: string,
+  privateKey: string,
+  uid: number,
+  validDurationMinutes: number,
+  opts: { nowMs?: number; randInt?: number } = {},
+): string {
+  if (!privateKey) return originUrl
+  const nowMs = opts.nowMs ?? Date.now()
+  const ts = Math.floor(nowMs / 1000) + validDurationMinutes * 60
+  const randInt =
+    opts.randInt ?? Math.floor(Math.random() * 2147483647)
+  const parsed = new URL(originUrl)
+  let path = parsed.pathname
+  try {
+    path = decodeURIComponent(parsed.pathname)
+  } catch {
+    path = parsed.pathname
+  }
+  const md5hex = createHash("md5")
+    .update(`${path}-${ts}-${randInt}-${uid}-${privateKey}`)
+    .digest("hex")
+  parsed.searchParams.append("auth_key", `${ts}-${randInt}-${uid}-${md5hex}`)
+  return parsed.toString()
+}
