   constructor(addition: Driver123OpenAddition) {
-    this.client = new Client123Open(addition)
+    const norm = normalize123OpenAddition(addition)
+    this.privateKey = norm.private_key || ""
+    this.uid = Number(norm.uid ?? 0)
+    this.validDuration = Number(norm.valid_duration ?? 30)
+    this.useDirectLink = norm.use_direct_link === true
+    this.client = new Client123Open(norm)
   }
 
   async init(): Promise<void> {
+    // P2-75：直链服务端点不在 A 源码树内，显式 fail-closed，不做静默降级。
+    if (this.useDirectLink) {
+      throw new Error(
+        "[123Open] use_direct_link is not implemented in txiki; set use_direct_link=false",
+      )
+    }
+    if (this.privateKey && this.uid <= 0) {
+      throw new Error("[123Open] uid is required when private_key is set")
+    }
     await this.client.init()
   }
 
