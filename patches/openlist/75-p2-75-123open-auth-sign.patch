+import assert from "node:assert/strict"
+import { test } from "node:test"
+
+import { Driver123Open, normalize123OpenAddition } from "./driver"
+import { sign123Url } from "./util"
+
+const FIXED = { nowMs: 1699998200000, randInt: 12345 }
+
+test("p2-75 固定向量：auth_key 值正确且原 query 保留", () => {
+  const out = sign123Url(
+    "https://x.example/a/b.txt?x=1",
+    "secret",
+    42,
+    30,
+    FIXED,
+  )
+  const u = new URL(out)
+  assert.equal(u.searchParams.get("x"), "1")
+  assert.deepEqual(u.searchParams.getAll("auth_key"), [
+    "1700000000-12345-42-a03bc497c0ccd898bb80b2ebf8b5dc95",
+  ])
+})
+
+test("p2-75 private_key 为空：原样返回不改 query", () => {
+  const url = "https://x.example/a/b.txt?x=1"
+  assert.equal(sign123Url(url, "", 42, 30, FIXED), url)
+})
+
+test("p2-75 uid=0 且 private_key 非空：init 抛 uid is required", async () => {
+  const d = new Driver123Open({ access_token: "t", private_key: "k" })
+  await assert.rejects(() => d.init(), /uid is required when private_key is set/)
+})
+
+test("p2-75 auth_mode=bogus：构造即抛 unknown auth_mode", () => {
+  assert.throws(
+    () => new Driver123Open({ auth_mode: "bogus" } as any),
+    /\[123Open\] unknown auth_mode: bogus/,
+  )
+})
+
+test("p2-75 auth_mode=client_credentials 缺凭据：沿用现有错误", async () => {
+  const d = new Driver123Open({ auth_mode: "client_credentials" })
+  await assert.rejects(
+    () => d.init(),
+    /\[123Open\] no valid authentication method/,
+  )
+})
+
+test("p2-75 use_direct_link=true：init 显式 fail-closed", async () => {
+  const d = new Driver123Open({ access_token: "t", use_direct_link: true })
+  await assert.rejects(() => d.init(), /use_direct_link=false/)
+})
+
+test("p2-75 O PascalCase 键归一为 snake_case 四字段", () => {
+  const n = normalize123OpenAddition({
+    DirectLink: true,
+    DirectLinkPrivateKey: "k",
+    DirectLinkValidDuration: 10,
+    UploadThread: 2,
+  } as any)
+  assert.equal(n.use_direct_link, true)
+  assert.equal(n.private_key, "k")
+  assert.equal(n.valid_duration, 10)
+  assert.equal(n.upload_thread, 2)
+  assert.equal(n.auth_mode, "token")
+})
+
+test("p2-75 显式 auth_mode 优先于凭据推断", () => {
+  const n = normalize123OpenAddition({
+    auth_mode: "client_credentials",
+    access_token: "t",
+    client_id: "id",
+    client_secret: "sec",
+  } as any)
+  assert.equal(n.auth_mode, "client_credentials")
+})
