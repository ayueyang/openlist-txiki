diff --git a/src/backend/drivers/google_drive/put-overwrite.test.ts b/src/backend/drivers/google_drive/put-overwrite.test.ts
new file mode 100644
index 0000000..fb8a51b
--- /dev/null
+++ b/src/backend/drivers/google_drive/put-overwrite.test.ts
@@ -0,0 +1,154 @@
+import assert from "node:assert/strict"
+import { afterEach, beforeEach, test } from "node:test"
+
+import { GoogleDrive } from "./driver"
+import { GOOGLE_DRIVE_FOLDER_MIME } from "./types"
+
+// 全部用例只 mock globalThis.fetch：不连网、不登录、不需要真实 Google 账号。
+// 目标语义对齐 alist v3.2.0：上传前按目标路径查同名文件，命中则
+// PATCH files/{id}?uploadType=resumable（body 空 JSON），未命中才 POST 新建。
+
+const realFetch = globalThis.fetch
+
+type Call = {
+  method: string
+  url: string
+  body: string
+  headers: Record<string, string>
+}
+
+let calls: Call[] = []
+let listedFiles: any[] = []
+let initSeq = 0
+
+function jsonResponse(
+  body: any,
+  headers: Record<string, string> = {},
+  status = 200,
+): any {
+  const text = JSON.stringify(body)
+  return {
+    ok: status >= 200 && status < 300,
+    status,
+    headers: {
+      get: (name: string) => {
+        const key = String(name).toLowerCase()
+        for (const [k, v] of Object.entries(headers)) {
+          if (k.toLowerCase() === key) return v
+        }
+        return key === "content-type" ? "application/json" : null
+      },
+    },
+    text: async () => text,
+    json: async () => JSON.parse(text),
+  }
+}
+
+beforeEach(() => {
+  calls = []
+  listedFiles = []
+  initSeq = 0
+  globalThis.fetch = (async (input: any, init: any = {}) => {
+    const url = String(input)
+    const method = String(init.method || "GET").toUpperCase()
+    const isUploadInit =
+      url.startsWith("https://www.googleapis.com/upload/drive/v3/files") &&
+      (method === "POST" || method === "PATCH")
+    calls.push({
+      method,
+      url,
+      body: typeof init.body === "string" ? init.body : "<binary>",
+      headers: (init.headers || {}) as Record<string, string>,
+    })
+    if (method === "GET" && url.includes("/drive/v3/files?")) {
+      return jsonResponse({ files: listedFiles })
+    }
+    if (isUploadInit) {
+      initSeq += 1
+      return jsonResponse({}, { location: `https://upload.example/s${initSeq}` })
+    }
+    return jsonResponse({})
+  }) as any
+})
+
+afterEach(() => {
+  globalThis.fetch = realFetch
+})
+
+function initCalls(): Call[] {
+  return calls.filter(
+    (c) =>
+      (c.method === "POST" || c.method === "PATCH") &&
+      c.url.startsWith("https://www.googleapis.com/upload/drive/v3/files"),
+  )
+}
+
+function makeDriver(chunkSize?: number): GoogleDrive {
+  return new GoogleDrive({ refresh_token: "", chunk_size: chunkSize })
+}
+
+test("同名上传：首次 POST 新建，第二次 PATCH 覆盖同一个 file id", async () => {
+  // 1MB + 1 字节，大于 chunk_size=1MB，新建和覆盖都走 resumable 分支。
+  const content = Buffer.alloc(1024 * 1024 + 1, 7)
+  const driver = makeDriver(1)
+
+  listedFiles = []
+  await driver.put("/gd", "/a.txt", content)
+  listedFiles = [
+    { id: "f1", name: "a.txt", mimeType: "application/octet-stream" },
+  ]
+  await driver.put("/gd", "/a.txt", content)
+
+  const inits = initCalls()
+  assert.deepEqual(
+    inits.map((c) => c.method),
+    ["POST", "PATCH"],
+  )
+  const patch = inits[1]
+  assert.ok(
+    patch.url.includes("/files/f1?uploadType=resumable"),
+    `PATCH URL 未带目标文件 id: ${patch.url}`,
+  )
+  assert.equal(patch.body, "{}")
+  const posts = calls.filter(
+    (c) =>
+      c.method === "POST" &&
+      c.url.startsWith("https://www.googleapis.com/upload/drive/v3/files"),
+  )
+  assert.equal(posts.length, 1)
+})
+
+test("同名条目是文件夹时不 PATCH，仍 POST 新建", async () => {
+  const content = Buffer.alloc(1024 * 1024 + 1, 7)
+  const driver = makeDriver(1)
+
+  listedFiles = [
+    { id: "d1", name: "a.txt", mimeType: GOOGLE_DRIVE_FOLDER_MIME },
+  ]
+  await driver.put("/gd", "/a.txt", content)
+  await driver.put("/gd", "/a.txt", content)
+
+  assert.deepEqual(
+    initCalls().map((c) => c.method),
+    ["POST", "POST"],
+  )
+})
+
+test("小文件覆盖：PATCH 后单次 PUT 带 Content-Length，无 Content-Range", async () => {
+  const content = Buffer.from("hello overwrite")
+  const driver = makeDriver(1)
+
+  listedFiles = [
+    { id: "f1", name: "a.txt", mimeType: "application/octet-stream" },
+  ]
+  await driver.put("/gd", "/a.txt", content)
+
+  assert.deepEqual(
+    initCalls().map((c) => c.method),
+    ["PATCH"],
+  )
+  const puts = calls.filter((c) => c.method === "PUT")
+  assert.equal(puts.length, 1)
+  assert.equal(puts[0].headers["Content-Length"], String(content.length))
+  assert.equal(puts[0].headers["Content-Range"], undefined)
+})
