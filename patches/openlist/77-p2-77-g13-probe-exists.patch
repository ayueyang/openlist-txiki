 })
+
+test("r63 缺陷 A 目录分支：单候选存在时 PUT 命中该候选（Local 缺失目录 list 回空）", async () => {
+  const d = newLocalLike()
+  d.dirs.add("/local1/sub")
+  await d.put("/v/sub/b2.txt", "/sub/b2.txt", Buffer.from("x"))
+  assert.deepEqual(d.writes(), ["storage.putItem:/local1/sub/b2.txt"])
+})
+
+test("r63 缺陷 A 目录分支：单候选存在时 MKDIR 命中该候选", async () => {
+  const d = newLocalLike()
+  d.dirs.add("/local1/sub")
+  await d.mkdir("/v/sub/d2", "/sub/d2")
+  assert.deepEqual(d.writes(), ["storage.makeDirectory:/local1/sub/d2"])
+})
+
+test("r63 缺陷 A 目录分支：0 候选 not found、2 候选仍 multiple targets", async () => {
+  const zero = newLocalLike()
+  await assert.rejects(
+    () => zero.put("/v/sub/b2.txt", "/sub/b2.txt", Buffer.from("x")),
+    /\[Alias\] put: no target found for \/sub/,
+  )
+  assert.deepEqual(zero.writes(), [])
+
+  const both = newLocalLike()
+  both.dirs.add("/local1/sub")
+  both.dirs.add("/local2/sub")
+  await assert.rejects(
+    () => both.put("/v/sub/b2.txt", "/sub/b2.txt", Buffer.from("x")),
+    /\[Alias\] protect_same_name: multiple targets for \/sub/,
+  )
+  assert.deepEqual(both.writes(), [])
+})
+
+test("r63 文件项矩阵：0 候选 not found、1 候选命中、2 候选 multiple targets", async () => {
+  const zero = newLocalLike()
+  await assert.rejects(
+    () => zero.rename("/v/r", "/r", "r2"),
+    /\[Alias\] rename: no target found for \/r/,
+  )
+  assert.deepEqual(zero.writes(), [])
+
+  const one = newLocalLike()
+  one.files.add("/local2/r")
+  await one.rename("/v/r", "/r", "r2")
+  assert.deepEqual(one.writes(), ["storage.renameItem:/local2/r"])
+
+  const both = newLocalLike()
+  both.files.add("/local1/r")
+  both.files.add("/local2/r")
+  await assert.rejects(
+    () => both.rename("/v/r", "/r", "r2"),
+    /\[Alias\] protect_same_name: multiple targets for \/r/,
+  )
+  assert.deepEqual(both.writes(), [])
+})
+
+test("r63 目录矩阵 protect_same_name=false：两候选只一个存在时取该候选", async () => {
+  const d = newLocalLike({ protect_same_name: false })
+  d.dirs.add("/local2/sub")
+  await d.put("/v/sub/b2.txt", "/sub/b2.txt", Buffer.from("x"))
+  assert.deepEqual(d.writes(), ["storage.putItem:/local2/sub/b2.txt"])
+})
