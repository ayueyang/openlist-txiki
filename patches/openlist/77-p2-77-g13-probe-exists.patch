   }
 }
 
+/**
+ * r63（r62 G13 缺陷 A）真机同形桩：与 LocalDriver 一致——目录不存在时
+ * readdir 失败被吞成空列表（reference local.ts:39-45），只有 getItem（stat）
+ * 会抛 ObjectNotFound。本桩不覆写 probeCandidate，直接验证探测实现。
+ */
+class LocalLikeAliasDriver extends AliasDriver {
+  calls: string[] = []
+  dirs = new Set<string>()
+  files = new Set<string>()
+
+  protected async storageModule(): Promise<any> {
+    const calls = this.calls
+    const dirs = this.dirs
+    const files = this.files
+    return {
+      listItems: async (p: string) => {
+        calls.push(`storage.listItems:${p}`)
+        return { content: [] }
+      },
+      getItem: async (p: string) => {
+        calls.push(`storage.getItem:${p}`)
+        if (files.has(p))
+          return { item: { name: p.split("/").pop(), is_dir: false, size: 1 } }
+        if (dirs.has(p))
+          return { item: { name: p.split("/").pop(), is_dir: true, size: 0 } }
+        throw new Error(`ObjectNotFound: ${p}`)
+      },
+      makeDirectory: async (p: string) => {
+        calls.push(`storage.makeDirectory:${p}`)
+      },
+      putItem: async (p: string) => {
+        calls.push(`storage.putItem:${p}`)
+      },
+      renameItem: async (p: string) => {
+        calls.push(`storage.renameItem:${p}`)
+      },
+      removeItems: async (p: string) => {
+        calls.push(`storage.removeItems:${p}`)
+      },
+      moveItems: async (s: string, d: string) => {
+        calls.push(`storage.moveItems:${s}->${d}`)
+      },
+      copyItems: async (s: string, d: string) => {
+        calls.push(`storage.copyItems:${s}->${d}`)
+      },
+    }
+  }
+
+  /** 写调用（去掉探测） */
+  writes(): string[] {
+    return this.calls.filter(
+      (c) =>
+        !c.startsWith("storage.getItem:") && !c.startsWith("storage.listItems:"),
+    )
+  }
+}
+
+function newLocalLike(extra: Record<string, unknown> = {}): LocalLikeAliasDriver {
+  return new LocalLikeAliasDriver({
+    paths: "/local1\n/local2",
+    writable: true,
+    ...extra,
+  } as any)
+}
+
