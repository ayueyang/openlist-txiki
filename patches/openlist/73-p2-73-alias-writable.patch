diff --git a/src/backend/drivers/alias/write-gate.test.ts b/src/backend/drivers/alias/write-gate.test.ts
new file mode 100755
index 0000000..e8048b2
--- /dev/null
+++ b/src/backend/drivers/alias/write-gate.test.ts
@@ -0,0 +1,147 @@
+import assert from "node:assert/strict"
+import { test } from "node:test"
+
+import { AliasDriver } from "./driver"
+import { AliasPermissionError } from "../../pkg/errs"
+
+/**
+ * P2-73 单测桩：不触达 internal/op/storage。
+ * - probeCandidate 用 existing 集合模拟候选存在性；
+ * - storageModule 返回计数桩，断言被门禁拦下时零底层写调用。
+ */
+class StubAliasDriver extends AliasDriver {
+  calls: string[] = []
+  existing = new Set<string>()
+  probeAll = false
+
+  protected async probeCandidate(
+    fullPath: string,
+    _isDir: boolean,
+  ): Promise<boolean> {
+    this.calls.push(`probe:${fullPath}`)
+    return this.probeAll || this.existing.has(fullPath)
+  }
+
+  protected async storageModule(): Promise<any> {
+    const calls = this.calls
+    return {
+      listItems: async (p: string) => {
+        calls.push(`storage.listItems:${p}`)
+        return { content: [] }
+      },
+      getItem: async (p: string) => {
+        calls.push(`storage.getItem:${p}`)
+        return { item: { name: "x" } }
+      },
+      makeDirectory: async (p: string) => {
+        calls.push(`storage.makeDirectory:${p}`)
+      },
+      renameItem: async (p: string) => {
+        calls.push(`storage.renameItem:${p}`)
+      },
+      removeItems: async (p: string) => {
+        calls.push(`storage.removeItems:${p}`)
+      },
+      moveItems: async (s: string, d: string) => {
+        calls.push(`storage.moveItems:${s}->${d}`)
+      },
+      copyItems: async (s: string, d: string) => {
+        calls.push(`storage.copyItems:${s}->${d}`)
+      },
+      putItem: async (p: string) => {
+        calls.push(`storage.putItem:${p}`)
+      },
+    }
+  }
+
+  storageCalls(): string[] {
+    return this.calls.filter((c) => c.startsWith("storage."))
+  }
+}
+
+/** 六个写方法各一次 */
+function sixWrites(d: AliasDriver): Array<() => Promise<void>> {
+  return [
+    () => d.mkdir("/v/mk", "/mk"),
+    () => d.rename("/v/r", "/r", "r2"),
+    () => d.remove("/v/x", "/x", ["x"]),
+    () => d.move("/v/s", "/v/t", ["f"], "/s/f", "/t/f"),
+    () => d.copy("/v/s", "/v/t", ["f"], "/s/f", "/t/f"),
+    () => d.put("/v/p", "/p", Buffer.from("x")),
+  ]
+}
+
+function newDriver(extra: Record<string, unknown> = {}): StubAliasDriver {
+  return new StubAliasDriver({
+    paths: "/local1\n/local2",
+    ...extra,
+  } as any)
+}
+
+test("p2-73 默认 writable=false：六个写方法全部拒绝且零底层调用", async () => {
+  const d = newDriver()
+  const wants = [
+    /\[Alias\] writable=false: mkdir denied/,
+    /\[Alias\] writable=false: rename denied/,
+    /\[Alias\] writable=false: remove denied/,
+    /\[Alias\] writable=false: move denied/,
+    /\[Alias\] writable=false: copy denied/,
+    /\[Alias\] writable=false: put denied/,
+  ]
+  const writes = sixWrites(d)
+  for (let i = 0; i < writes.length; i++) {
+    await assert.rejects(writes[i], (e: any) => {
+      assert.ok(e instanceof AliasPermissionError, `第 ${i} 个方法错误类型`)
+      assert.match(e.message, wants[i])
+      return true
+    })
+  }
+  assert.deepEqual(d.storageCalls(), [])
+})
+
+test("p2-73 writable=true：六个写方法过门禁", async () => {
+  const d = new StubAliasDriver({ paths: "/local1", writable: true } as any)
+  d.probeAll = true
+  for (const w of sixWrites(d)) {
+    await w()
+  }
+  assert.ok(d.storageCalls().length >= 6)
+})
+
+test("p2-73 protect_same_name 默认 true：两候选同名时 rename/remove 拒绝，单个存在时返回该候选", async () => {
+  const both = newDriver({ writable: true })
+  both.probeAll = true
+  await assert.rejects(
+    () => both.rename("/v/r", "/r", "r2"),
+    /\[Alias\] protect_same_name: multiple targets for \/r/,
+  )
+  await assert.rejects(
+    () => both.remove("/v/x", "/x", ["x"]),
+    /\[Alias\] protect_same_name: multiple targets for \/x/,
+  )
+
+  const one = newDriver({ writable: true })
+  one.existing.add("/local1/r")
+  await one.rename("/v/r", "/r", "r2")
+  assert.deepEqual(one.storageCalls(), ["storage.renameItem:/local1/r"])
+})
+
+test("p2-73 protect_same_name=false：两候选同名时取第一个存在的候选", async () => {
+  const d = newDriver({ writable: true, protect_same_name: false })
+  d.probeAll = true
+  await d.rename("/v/r", "/r", "r2")
+  assert.deepEqual(d.storageCalls(), ["storage.renameItem:/local1/r"])
+})
+
+test("p2-73 零候选存在：报 not found 且不落任何写调用", async () => {
+  const d = newDriver({ writable: true })
+  await assert.rejects(
+    () => d.mkdir("/v/mk", "/mk"),
+    /\[Alias\] mkdir: no target found for \//,
+  )
+  await assert.rejects(
+    () => d.put("/v/p", "/p", Buffer.from("x")),
+    /\[Alias\] put: no target found for \//,
+  )
+  assert.deepEqual(d.storageCalls(), [])
+})
