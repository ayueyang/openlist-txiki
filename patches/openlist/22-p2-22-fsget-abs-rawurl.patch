diff --git a/src/backend/server/sign_go_parity.test.ts b/src/backend/server/sign_go_parity.test.ts
index d093337..9aac078 100644
--- a/src/backend/server/sign_go_parity.test.ts
+++ b/src/backend/server/sign_go_parity.test.ts
@@ -123,10 +123,25 @@ test("fs/get：raw_url 编码后，含 % / # / 中文 的文件名不再被截
     const body: any = await res.json()
     assert.equal(body.code, 200, `${name}: ${JSON.stringify(body)}`)
     const rawUrl: string = body.data.raw_url
-    assert.ok(
-      rawUrl.startsWith("/api/p" + encodeDownloadPath(`/local/${name}`)),
+    // r19 F5（A）：raw_url 现在是绝对 URL（origin 取自 c.req.url，测试里
+    // 是 http://localhost）；路径部分仍必须逐字等于 encodeDownloadPath
+    // 的产物（%xx 不二次编码），且 sign 仍在 query 里。
+    const expectedPath = "/api/p" + encodeDownloadPath(`/local/${name}`)
+    const parsedRawUrl = new URL(rawUrl)
+    assert.equal(
+      parsedRawUrl.origin,
+      "http://localhost",
+      `${name}: raw_url origin -> ${rawUrl}`,
+    )
+    assert.equal(
+      parsedRawUrl.pathname,
+      expectedPath,
       `${name}: raw_url not encoded -> ${rawUrl}`,
     )
+    assert.ok(
+      /[?&]sign=/.test(parsedRawUrl.search),
+      `${name}: raw_url missing sign -> ${rawUrl}`,
+    )
     // 关键：这个 http 请求过去会抛 URIError（裸 %）或被 ? 截断成另一个路径
     const hit = await app.request(rawUrl, { method: "GET" })
     assert.notEqual(hit.status, 401, `${name}: raw_url rejected -> ${hit.status}`)
