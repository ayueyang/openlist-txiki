+/**
+ * 取传输层收到的原始路径：运行时在进 fetch 前已经解码一次，本函数不再解码。
+ *
+ * tjs 的 HTTP 层在交给 JS 之前会对 URL 路径解码一次（实测 `/100%25.txt`
+ * 到 `req.url` 已是 `/100%.txt`、`%E4%B8%AD` 已是 `中`）。所以这里只做
+ * `c.req.url` 的字符串切片：
+ *  - 不能调 decodeURIComponent：对残留字面 `%`（如合法文件名 `100%.txt`）
+ *    会抛 URIError，把正常文件判成 400；
+ *  - 不能用 new URL(...).pathname：WHATWG 解析会把 `%2e%2e` 折成 `..`、
+ *    把中文/空格重新百分号编码，丢掉进 fetch 时的原样字符。
+ *
+ * 返回的字符串就是上游路由看到的形态：裸 `%`、`%2e`、`%2F`、空格、中文
+ * 都保持不变；url 没有路径部分时返回 "/"。
+ */
+export function wirePath(c: { req: { url: string } }): string {
+  const url = String(c.req.url || "")
+  const start = url.indexOf("/", url.indexOf(":") + 4)
+  if (start < 0) return "/"
+  let end = url.length
+  const q = url.indexOf("?", start)
+  if (q >= 0) end = q
+  const h = url.indexOf("#", start)
+  if (h >= 0 && h < end) end = h
+  return url.slice(start, end) || "/"
+}
+
