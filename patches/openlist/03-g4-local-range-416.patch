+/** 多段 Range 的 multipart/byteranges 流：按序从驱动取每一段，段间补分隔符。 */
+function multipartRanges(
+  open: RangeOpen,
+  size: number,
+  ranges: RangeParams[],
+  boundary: string,
+): ReadableStream<Uint8Array> {
+  const enc = new TextEncoder()
+  const head = (r: RangeParams) =>
+    `--${boundary}${CRLF}Content-Type: application/octet-stream${CRLF}` +
+    `Content-Range: bytes ${r.start}-${r.end}/${size}${CRLF}${CRLF}`
+  let index = 0
+  let reader: any = null
+  return new ReadableStream<Uint8Array>({
+    async pull(controller) {
+      for (;;) {
+        if (reader) {
+          const { done, value } = await reader.read()
+          if (!done) {
+            if (value && value.length) controller.enqueue(value)
+            return
+          }
+          reader.releaseLock()
+          reader = null
+          if (index >= ranges.length) {
+            controller.enqueue(enc.encode(`${CRLF}--${boundary}--${CRLF}`))
+            controller.close()
+            return
+          }
+          const next = ranges[index++]
+          controller.enqueue(enc.encode(`${CRLF}${head(next)}`))
+          reader = (await open({ start: next.start, end: next.end })).getReader()
+          return
+        }
+        if (index >= ranges.length) {
+          controller.enqueue(enc.encode(`--${boundary}--${CRLF}`))
+          controller.close()
+          return
+        }
+        const first = ranges[index++]
+        controller.enqueue(enc.encode(head(first)))
+        reader = (await open({ start: first.start, end: first.end })).getReader()
+        return
+      }
+    },
+    cancel(reason) {
+      try {
+        reader?.cancel(reason)
+      } catch {}
+    },
+  })
+}
