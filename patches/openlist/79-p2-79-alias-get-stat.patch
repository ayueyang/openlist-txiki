diff --git a/src/backend/drivers/alias/get-stat.test.ts b/src/backend/drivers/alias/get-stat.test.ts
new file mode 100644
index 0000000..e8b46bf
--- /dev/null
+++ b/src/backend/drivers/alias/get-stat.test.ts
@@ -0,0 +1,128 @@
+/**
+ * r64 补丁 79（缺陷 B）单测：alias get() 的 stat 语义。
+ *
+ * 修前：路径不存在时 get() 返回 size=0, is_dir=false 的占位 item，
+ * 所有 getItem() 调用方都拿到「对象存在」，rename/move/copy 的写预检恒真。
+ * 修后：0 候选 / 全候选缺失抛 AliasNotFoundError；真实错误原样上抛；
+ * 多 target 仍取第一个成功候选。
+ *
+ * 用 StubAliasDriver 覆写 storageModule（沿用 write-gate.test.ts 的桩法），
+ * 不触达 internal/op/storage、不建网络连接。
+ */
+import assert from "node:assert/strict"
+import { test } from "node:test"
+
+import { AliasDriver } from "./driver"
+import { AliasNotFoundError, isNotFoundError } from "../../pkg/errs"
+
+type GetItemStub = (path: string) => Promise<any>
+
+class StubAliasDriver extends AliasDriver {
+  calls: string[] = []
+  getItemImpl: GetItemStub = async () => {
+    throw new Error("Object not found")
+  }
+
+  protected async storageModule(): Promise<any> {
+    const calls = this.calls
+    const impl = this.getItemImpl
+    return {
+      getItem: async (p: string) => {
+        calls.push(p)
+        return impl(p)
+      },
+    }
+  }
+}
+
+const driverWith = (paths: string, impl: GetItemStub): StubAliasDriver => {
+  const d = new StubAliasDriver({ paths, writable: true } as any)
+  d.getItemImpl = impl
+  return d
+}
+
+test("r64 补丁 79：0 候选抛 AliasNotFoundError，不返回占位 item", async () => {
+  const d = driverWith("/sub:/l1", async () => {
+    throw new Error("should not be called")
+  })
+  await assert.rejects(
+    () => d.get("/elsewhere", "/x"),
+    (e: any) => e instanceof AliasNotFoundError && e.code === 404,
+  )
+  assert.equal(d.calls.length, 0)
+})
+
+test("r64 补丁 79：全部候选缺失抛 AliasNotFoundError", async () => {
+  const d = driverWith("/l1\n/l2", async () => {
+    throw new Error("Object not found")
+  })
+  await assert.rejects(
+    () => d.get("/dup.txt", "/dup.txt"),
+    (e: any) => e instanceof AliasNotFoundError,
+  )
+  assert.deepEqual(d.calls, ["/l1/dup.txt", "/l2/dup.txt"])
+})
+
+test("r64 补丁 79：一真一缺失取真候选，raw_url 回退到 res.rawUrl", async () => {
+  const d = driverWith("/l1\n/l2", async (p) => {
+    if (p === "/l2/dup.txt") {
+      return {
+        item: { name: "dup.txt", size: 6, is_dir: false },
+        rawUrl: "/api/p/l2/dup.txt",
+      }
+    }
+    throw new Error("Object not found")
+  })
+  const item: any = await d.get("/dup.txt", "/dup.txt")
+  assert.equal(item.name, "dup.txt")
+  assert.equal(item.raw_url, "/api/p/l2/dup.txt")
+  assert.deepEqual(d.calls, ["/l1/dup.txt", "/l2/dup.txt"])
+})
+
+test("r64 补丁 79：item 自带 raw_url 时优先于 res.rawUrl", async () => {
+  const d = driverWith("/l1", async () => ({
+    item: { name: "a.bin", size: 1, is_dir: false, raw_url: "/api/p/l1/a.bin" },
+    rawUrl: "/api/d/l1/a.bin",
+  }))
+  const item: any = await d.get("/a.bin", "/a.bin")
+  assert.equal(item.raw_url, "/api/p/l1/a.bin")
+})
+
+test("r64 补丁 79：真实错误全部失败后原样上抛，不伪装成 404", async () => {
+  const real = Object.assign(new Error("upstream 503"), { code: 503 })
+  const d = driverWith("/l1\n/l2", async (p) => {
+    if (p === "/l1/x") throw real
+    throw new Error("Object not found")
+  })
+  await assert.rejects(
+    () => d.get("/x", "/x"),
+    (e: any) => e === real && !(e instanceof AliasNotFoundError),
+  )
+  assert.equal(d.calls.length, 2)
+})
+
+test("r64 补丁 79：多 target 首个成功即返回，不再探测后续候选", async () => {
+  const d = driverWith("/l1\n/l2", async (p) => ({
+    item: { name: "dup.txt", size: 6, is_dir: false, raw_url: `/api/p${p}` },
+    rawUrl: `/api/d${p}`,
+  }))
+  const item: any = await d.get("/dup.txt", "/dup.txt")
+  assert.equal(item.raw_url, "/api/p/l1/dup.txt")
+  assert.deepEqual(d.calls, ["/l1/dup.txt"])
+})
+
+test("r64 补丁 79：isNotFoundError 认 404/1004/ENOENT/ENOTDIR 与 not found 文案", () => {
+  for (const e of [
+    { code: 404 },
+    { code: 1004 },
+    { code: "ENOENT" },
+    { code: "ENOTDIR" },
+    { message: "Object not found" },
+    { message: "Storage not found" },
+  ]) {
+    assert.equal(isNotFoundError(e), true, JSON.stringify(e))
+  }
+  for (const e of [null, {}, { code: 403 }, { message: "permission denied" }]) {
+    assert.equal(isNotFoundError(e), false, JSON.stringify(e))
+  }
+})
diff --git a/src/backend/pkg/errs.ts b/src/backend/pkg/errs.ts
index a77b0dd..9831309 100644
--- a/src/backend/pkg/errs.ts
+++ b/src/backend/pkg/errs.ts
@@ -78,3 +78,31 @@ export class AliasPermissionError extends Error {
     this.name = "AliasPermissionError"
   }
 }
+
+/**
+ * r64 补丁 79（缺陷 B）：alias 路径不存在。
+ *
+ * alias 的 get() 从「返回 size=0 占位 item」改成 stat 语义后抛这个类型；
+ * 调用方按类型映射成 404。不要继承 AliasPermissionError，否则现有 403
+ * 映射会把「缺失」当「无权限」。
+ */
+export class AliasNotFoundError extends Error {
+  code = 404
+
+  constructor(message: string) {
+    super(message)
+    this.name = "AliasNotFoundError"
+  }
+}
+
+/**
+ * 「不存在」类错误判定：alias 驱动逐候选回退时用（code 优先，文案兜底）。
+ * 只用于决定是否继续尝试下一个候选；真实错误仍按原类型上抛，不在这里吞掉。
+ */
+export function isNotFoundError(e: any): boolean {
+  if (!e) return false
+  const code = e?.code
+  if (code === 404 || code === 1004 || code === "ENOENT" || code === "ENOTDIR")
+    return true
+  return /not found/i.test(String(e?.message || ""))
+}
