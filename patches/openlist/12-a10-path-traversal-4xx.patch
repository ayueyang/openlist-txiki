+/**
+ * 写请求的错误映射：请求路径在虚拟文件系统里没有匹配到任何存储（含 `/w/../x`
+ * 这类被 resolvePath 折叠到虚拟根、只剩 `/x` 的路径）属于客户端路径错误，
+ * 必须回 4xx，不能把 HTTP 状态码留在 Hono 默认的 200 上。
+ * 其余错误（驱动 / IO / 权限之外的运行期故障）保持 500。
+ *
+ * 选 404 的理由：路径规范化后确实不存在对应挂载点，与「Not Found」语义一致；
+ * 403 会让客户端误以为有权限问题并暴露路径校验分支。
+ */
+function writeFailure(c: any, e: any) {
+  const message = safeErrorMessage(e)
+  if (/storage not found/i.test(message)) {
+    return c.json({ code: 404, message, data: null }, 404)
+  }
+  return c.json({ code: 500, message, data: null })
+}
