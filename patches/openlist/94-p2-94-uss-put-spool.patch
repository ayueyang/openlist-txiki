diff --git a/src/backend/drivers/uss/stream.test.ts b/src/backend/drivers/uss/stream.test.ts
new file mode 100644
index 0000000..d6938be
--- /dev/null
+++ b/src/backend/drivers/uss/stream.test.ts
@@ -0,0 +1,171 @@
+// SPEC p2-94（补丁 94）：又拍云 USS 落盘暂存 + 流式 PUT 单元测试。
+// mock globalThis.tjs 与 fetch：不连网、不需要真实 UPYUN 账号。
+import assert from "node:assert/strict"
+import { afterEach, beforeEach, test } from "node:test"
+import * as fsp from "node:fs/promises"
+import { mkdtemp, readdir, rm } from "node:fs/promises"
+import { tmpdir } from "node:os"
+import { join } from "node:path"
+
+import { UssDriver } from "./driver"
+
+const MB = 1024 * 1024
+const realFetch = globalThis.fetch
+const realTjs = (globalThis as any).tjs
+
+let spoolDir = ""
+let readLens: number[] = []
+let readTotal = 0
+let calls: Array<{ url: string; method: string; headers: Record<string, string>; body: any; duplex?: string }> = []
+let putStatus = 200
+let putText = ""
+let putChunkLens: number[] = []
+let putBodyBytes = new Uint8Array(0)
+
+function makeSrc(size: number, seed = 11): Uint8Array {
+  const src = new Uint8Array(size)
+  for (let i = 0; i < size; i++) src[i] = (i * seed + 3) & 0xff
+  return src
+}
+
+function makeDriver(): UssDriver {
+  return new UssDriver({ bucket: "bkt", operator_name: "op", operator_password: "pw" } as any)
+}
+
+beforeEach(async () => {
+  readLens = []
+  readTotal = 0
+  calls = []
+  putStatus = 200
+  putText = ""
+  putChunkLens = []
+  putBodyBytes = new Uint8Array(0)
+  spoolDir = await mkdtemp(join(tmpdir(), "uss-p94-"))
+  ;(globalThis as any).tjs = {
+    env: { UPLOAD_SPOOL_DIR: spoolDir },
+    statFs: async () => ({ bsize: 4096, bavail: 1024 * 1024 }),
+    open: async (p: string, mode: "r" | "w") => {
+      const fh = await fsp.open(p, mode)
+      return {
+        write: async (chunk: Uint8Array) => (await fh.write(chunk)).bytesWritten,
+        read: async (buf: Uint8Array, position: number) => {
+          readLens.push(buf.byteLength)
+          const r = await fh.read(buf, 0, buf.byteLength, position)
+          readTotal += r.bytesRead
+          return r.bytesRead
+        },
+        close: async () => fh.close(),
+      }
+    },
+  }
+  globalThis.fetch = (async (input: any, init?: any) => {
+    const url = String(input)
+    // 真实 fetch 在 resolve 前读完请求体；mock 同点消费，避免驱动 finally 关句柄后 EBADF。
+    if (init?.body instanceof ReadableStream) {
+      const parts: Uint8Array[] = []
+      const reader = init.body.getReader()
+      for (;;) {
+        const { done, value } = await reader.read()
+        if (done) break
+        putChunkLens.push(value.byteLength)
+        parts.push(value)
+      }
+      putBodyBytes = new Uint8Array(Buffer.concat(parts.map((p) => Buffer.from(p))))
+    }
+    calls.push({
+      url,
+      method: String(init?.method || "GET").toUpperCase(),
+      headers: (init?.headers || {}) as Record<string, string>,
+      body: init?.body,
+      duplex: init?.duplex,
+    })
+    if (putStatus !== 200) {
+      return {
+        ok: false,
+        status: putStatus,
+        headers: { get: () => "text/plain" },
+        text: async () => putText,
+        json: async () => ({}),
+      }
+    }
+    return {
+      ok: true,
+      status: 200,
+      headers: { get: () => "text/plain" },
+      text: async () => "",
+      json: async () => ({}),
+    } as any
+  }) as any
+})
+
+afterEach(async () => {
+  globalThis.fetch = realFetch
+  ;(globalThis as any).tjs = realTjs
+  await rm(spoolDir, { recursive: true, force: true })
+})
+
+test("1 beginStream 存在", () => {
+  assert.equal(typeof (makeDriver() as any).beginStream, "function")
+})
+
+test("2 5MiB：单次 PUT、body 是 ReadableStream、字节一致、读块 <= 64KiB", async () => {
+  const size = 5 * MB
+  const src = makeSrc(size)
+  const d = makeDriver()
+  const w = await (d as any).beginStream("/uss-test/a.bin", size)
+  await w.write(src)
+  await w.commit()
+
+  assert.equal(calls.length, 1)
+  const c = calls[0]
+  assert.equal(c.method, "PUT")
+  assert.ok(c.url.startsWith("https://v0.api.upyun.com/bkt/uss-test/a.bin"), c.url)
+  assert.ok(c.body instanceof ReadableStream, "body 是 ReadableStream")
+  assert.equal(c.duplex, "half")
+  assert.equal(c.headers["Content-Length"], String(size))
+  assert.ok(String(c.headers["Authorization"]).startsWith("Basic "))
+
+  assert.ok(Math.max(...putChunkLens) <= 64 * 1024)
+  assert.equal(readTotal, size)
+  assert.equal(putBodyBytes.byteLength, size)
+  assert.deepEqual(putBodyBytes, src)
+  assert.deepEqual(await readdir(spoolDir), [])
+})
+
+test("3 0 字节：body 是 Uint8Array(0)，Content-Length 0", async () => {
+  const d = makeDriver()
+  const w = await (d as any).beginStream("/uss-test/empty.bin", 0)
+  await w.commit()
+  const c = calls[0]
+  assert.ok(c.body instanceof Uint8Array)
+  assert.equal(c.body.byteLength, 0)
+  assert.equal(c.headers["Content-Length"], "0")
+  assert.deepEqual(await readdir(spoolDir), [])
+})
+
+test("4 403 + 文本：commit 抛错含状态与前 300 字符，spool 已清", async () => {
+  putStatus = 403
+  putText = "denied by policy"
+  const d = makeDriver()
+  const w = await (d as any).beginStream("/uss-test/a.bin", MB)
+  await w.write(new Uint8Array(MB))
+  await assert.rejects(() => w.commit(), /\[USS\] put failed \(403\): denied by policy/)
+  assert.deepEqual(await readdir(spoolDir), [])
+})
+
+test("5 abort：fetch 0 次，spool 已清", async () => {
+  const d = makeDriver()
+  const w = await (d as any).beginStream("/uss-test/a.bin", MB)
+  await w.write(new Uint8Array(MB))
+  await w.abort()
+  assert.equal(calls.length, 0)
+  assert.deepEqual(await readdir(spoolDir), [])
+})
+
+test("6 声明长度 10 写 11：write 抛错，fetch 0 次，spool 已清", async () => {
+  const d = makeDriver()
+  const w = await (d as any).beginStream("/uss-test/a.bin", 10)
+  await assert.rejects(() => w.write(new Uint8Array(11)), /uss 上传声明长度与实际不符/)
+  assert.equal(calls.length, 0)
+  assert.deepEqual(await readdir(spoolDir), [])
+})
