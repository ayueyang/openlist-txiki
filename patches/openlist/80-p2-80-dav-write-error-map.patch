+/**
+ * r64 补丁 80（缺陷 D）单测：DAV 写方法共用的外层错误映射。
+ *
+ * 修前：webdav 外层 catch 只认路径拒绝 403 与源缺失 404，AliasPermissionError
+ * （writable=false、protect_same_name 多 target）落进 500 兜底，把「客户端被
+ * 拒绝」说成「服务端故障」。修后按类型补 403/404，其余仍 500。
+ *
+ * 直接调 webdavErrorResponse，用最小 Hono context 桩，不发网络请求。
+ */
+import assert from "node:assert/strict"
+import { test } from "node:test"
+
+import { webdavErrorResponse } from "./webdav"
+import { AliasNotFoundError, AliasPermissionError } from "../pkg/errs"
+import { PathRejectedError } from "../pkg/canonical-path"
+
+const ctx = () =>
+  ({
+    text: (body: string, status: number) => new Response(body, { status }),
+  }) as any
+
+test("r64 补丁 80：路径拒绝仍 403", () => {
+  const res = webdavErrorResponse(ctx(), new PathRejectedError("relative-path"))
+  assert.equal(res.status, 403)
+})
+
+test("r64 补丁 80：AliasNotFoundError 映射 404", () => {
+  const res = webdavErrorResponse(
+    ctx(),
+    new AliasNotFoundError("[Alias] not found: /x"),
+  )
+  assert.equal(res.status, 404)
+})
+
+test("r64 补丁 80：AliasPermissionError（writable=false）映射 403 且文案保留", async () => {
+  const res = webdavErrorResponse(
+    ctx(),
+    new AliasPermissionError("[Alias] writable=false: put denied"),
+  )
+  assert.equal(res.status, 403)
+  assert.equal(await res.text(), "[Alias] writable=false: put denied")
+})
+
+test("r64 补丁 80：AliasPermissionError（multiple targets）映射 403", async () => {
+  const res = webdavErrorResponse(
+    ctx(),
+    new AliasPermissionError(
+      "[Alias] protect_same_name: multiple targets for /dir1",
+    ),
+  )
+  assert.equal(res.status, 403)
+  assert.match(await res.text(), /multiple targets for/)
+})
+
+test("r64 补丁 80：普通 Error 仍 500", () => {
+  const res = webdavErrorResponse(ctx(), new Error("driver exploded"))
+  assert.equal(res.status, 500)
+})
