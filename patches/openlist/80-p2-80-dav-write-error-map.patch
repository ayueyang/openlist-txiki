     // P1-18：路径被拒绝（纵深调用里抛出的 PathRejectedError）一律 403。
-    if (isPathRejected(e)) return c.text("Forbidden", 403)
-    if (e instanceof SourceMissingError) return c.text("Not Found", 404)
-    return c.text(safeErrorMessage(e), 500)
+    // r64 补丁 80（缺陷 D）：alias 写拒绝按类型映射 403/404，不再兜成 500。
+    return webdavErrorResponse(c, e)
   }
 })
