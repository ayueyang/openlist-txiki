+/**
+ * r64 补丁 80（缺陷 D）：DAV 写方法共用的外层错误映射。
+ *
+ * PUT/MKCOL/DELETE/MOVE/COPY 全在同一个 try 里，sourceStep 只把「源缺失」
+ * 转成 SourceMissingError，其它错误原样冒泡，所以在这里按类型补分支即可
+ * 覆盖五个写方法。顺序先具体后兜底：
+ *   路径拒绝 403 → 源缺失 404 → alias 缺失 404 → alias 权限/同名 403 → 500。
+ * 不做字符串匹配，避免把驱动真实错误吞成 4xx。
+ */
+export function webdavErrorResponse(c: any, e: any): Response {
+  if (isPathRejected(e)) return c.text("Forbidden", 403)
+  if (e instanceof SourceMissingError) return c.text("Not Found", 404)
+  if (e instanceof AliasNotFoundError) return c.text("Not Found", 404)
+  if (e instanceof AliasPermissionError)
+    return c.text(safeErrorMessage(e), 403)
+  return c.text(safeErrorMessage(e), 500)
+}
+
 webdavRouter.all("/*", async (c) => {
   const method = c.req.method.toUpperCase()
 
