@@ -0,0 +1,414 @@
+/**
+ * 189（天翼云盘）重登接点：会话失效判定、限流、单飞。
+ *
+ * 本模块只做三件事，不放 HTTP 细节、不放 UI 文案、不接触 addition/cookie/密码：
+ * 1. isSessionInvalidResponse()：判定一条 API 响应是否代表会话失效；
+ * 2. ReloginGuard.canAttempt/recordSuccess/recordFailure：限流与退避状态机；
+ * 3. ReloginGuard.run()：单飞 + 限流 + 计数，包住一个 () => Promise<T>。
+ *
+ * 状态只放内存，不写库：进程重启清零，重启后第一次请求会尝试一次。
+ * 进程级「同账号每小时 N 次」只存 sha256(username) 前 8 位，不存明文。
+ */
+
+export const RELOGIN_ERRORS = {
+  NO_CREDENTIALS: "189_RELOGIN_NO_CREDENTIALS",
+  THROTTLED: "189_RELOGIN_THROTTLED",
+  FAILED: "189_RELOGIN_FAILED",
+  /** 登录协议成功但 cloud 会话代际没有变化（architect 10:37 勘误 D-2）。 */
+  NO_SESSION: "189_LOGIN_NO_SESSION",
+} as const
+
+export type ReloginErrorCode = (typeof RELOGIN_ERRORS)[keyof typeof RELOGIN_ERRORS]
+
+export type SessionInvalidReason = "errorCode" | "res_code_1010" | "msg_fallback"
+
+export interface SessionInvalidVerdict {
+  invalid: boolean
+  reason?: SessionInvalidReason
+}
+
+/**
+ * 会话失效判定矩阵（DESIGN 第二节 + 10:37 勘误 1.4）。
+ *
+ * 只认明确的码；`check ip error` 文案只在「没有 errorCode，且没有非零 res_code」
+ * 时兜底（B17/B18）。不按 HTTP 401/403 或非 JSON 响应重登，避免把下载直链/CDN
+ * 的正常失败放大成登录风暴。reason 只用于插桩与 A3 分段，不参与控制流。
+ */
+export function classifySessionInvalidResponse(data: any): SessionInvalidVerdict {
+  if (!data || typeof data !== "object") return { invalid: false }
+  if (data.errorCode === "InvalidSessionKey") {
+    return { invalid: true, reason: "errorCode" }
+  }
+  if (data.res_code === "InvalidSessionKey") {
+    return { invalid: true, reason: "errorCode" }
+  }
+  if (String(data.res_code) === "1010") {
+    return { invalid: true, reason: "res_code_1010" }
+  }
+  const resCode = data.res_code
+  const nonZeroResCode =
+    resCode !== undefined &&
+    resCode !== null &&
+    String(resCode) !== "" &&
+    String(resCode) !== "0"
+  if (!data.errorCode && !nonZeroResCode) {
+    const message = String(data.errorMsg || data.res_message || "")
+    if (/check\s*ip\s*error/i.test(message)) {
+      return { invalid: true, reason: "msg_fallback" }
+    }
+  }
+  return { invalid: false }
+}
+
+/** 布尔语义保留：调用点不需要改。 */
+export function isSessionInvalidResponse(data: any): boolean {
+  return classifySessionInvalidResponse(data).invalid
+}
+
+/** sha256 前 8 位，用于日志与进程级账号键；不存明文。 */
+export function shortHash(value: string): string {
+  return sha256Hex(String(value ?? "")).slice(0, 8)
+}
+
+const SHA256_K = [
+  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1,
+  0x923f82a4, 0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
+  0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786,
+  0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
+  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147,
+  0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
+  0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b,
+  0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
+  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a,
+  0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
+  0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
+]
+
+function rotr32(value: number, bits: number): number {
+  return ((value >>> bits) | (value << (32 - bits))) >>> 0
+}
+
+/**
+ * 纯 JS 同步 sha256：tjs 没有 node:crypto，WebCrypto 只有异步 digest，
+ * 而限流判定是同步路径，故自带一份最小实现（只用于取短哈希，不做密码学用途）。
+ */
+function sha256Hex(input: string): string {
+  const bytes = new TextEncoder().encode(input)
+  const length = bytes.length
+  const blockCount = Math.ceil((length + 9) / 64)
+  const padded = new Uint8Array(blockCount * 64)
+  padded.set(bytes)
+  padded[length] = 0x80
+  const view = new DataView(padded.buffer)
+  const bitLength = length * 8
+  view.setUint32(padded.length - 8, Math.floor(bitLength / 0x100000000))
+  view.setUint32(padded.length - 4, bitLength >>> 0)
+
+  let h0 = 0x6a09e667
+  let h1 = 0xbb67ae85
+  let h2 = 0x3c6ef372
+  let h3 = 0xa54ff53a
+  let h4 = 0x510e527f
+  let h5 = 0x9b05688c
+  let h6 = 0x1f83d9ab
+  let h7 = 0x5be0cd19
+  const w = new Uint32Array(64)
+
+  for (let block = 0; block < blockCount; block++) {
+    const offset = block * 64
+    for (let t = 0; t < 16; t++) w[t] = view.getUint32(offset + t * 4)
+    for (let t = 16; t < 64; t++) {
+      const s0 = rotr32(w[t - 15], 7) ^ rotr32(w[t - 15], 18) ^ (w[t - 15] >>> 3)
+      const s1 = rotr32(w[t - 2], 17) ^ rotr32(w[t - 2], 19) ^ (w[t - 2] >>> 10)
+      w[t] = (w[t - 16] + s0 + w[t - 7] + s1) >>> 0
+    }
+
+    let a = h0
+    let b = h1
+    let c = h2
+    let d = h3
+    let e = h4
+    let f = h5
+    let g = h6
+    let h = h7
+
+    for (let t = 0; t < 64; t++) {
+      const s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25)
+      const ch = (e & f) ^ (~e & g)
+      const temp1 = (h + s1 + ch + SHA256_K[t] + w[t]) >>> 0
+      const s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22)
+      const maj = (a & b) ^ (a & c) ^ (b & c)
+      const temp2 = (s0 + maj) >>> 0
+      h = g
+      g = f
+      f = e
+      e = (d + temp1) >>> 0
+      d = c
+      c = b
+      b = a
+      a = (temp1 + temp2) >>> 0
+    }
+
+    h0 = (h0 + a) >>> 0
+    h1 = (h1 + b) >>> 0
+    h2 = (h2 + c) >>> 0
+    h3 = (h3 + d) >>> 0
+    h4 = (h4 + e) >>> 0
+    h5 = (h5 + f) >>> 0
+    h6 = (h6 + g) >>> 0
+    h7 = (h7 + h) >>> 0
+  }
+
+  return [h0, h1, h2, h3, h4, h5, h6, h7]
+    .map((value) => value.toString(16).padStart(8, "0"))
+    .join("")
+}
+
+export interface ReloginGuardOptions {
+  /** 同一实例两次登录的最小间隔，默认 60 s。 */
+  minIntervalMs?: number
+  /** 连续失败后的退避窗口，按失败次数取；超出取最后一个，默认 60/300/900/1800 s。 */
+  backoffMs?: number[]
+  /**
+   * 连续失败到第几次进入熔断，默认 4：
+   * 失败 1/2/3 次后分别退避 60/300/900 s（CRITERIA B11），第 4 次失败熔断 30 min。
+   */
+  maxFailures?: number
+  /** 熔断时长，默认 30 min。 */
+  circuitMs?: number
+  /** 进程级同账号每小时最多尝试次数，默认 6。 */
+  maxPerHour?: number
+  /** resend 相连续失败几次后暂停，默认 3（10:37 勘误 D-3）。 */
+  sessionFailLimit?: number
+  /** resend 相暂停时长，默认 30 min。 */
+  sessionPauseMs?: number
+  /** 每次真正发起登录前回调一次，用于日志计数。 */
+  onAttempt?: (info: { attempt: number; now: number }) => void
+}
+
+export interface AttemptDecision {
+  ok: boolean
+  reason?: "circuit" | "min_interval" | "backoff" | "hourly_limit" | "session_pause"
+  retryAfterMs?: number
+}
+
+/** 失败分相：login 计入退避/熔断；resend 只计 session_fail（D-3）。 */
+export type ReloginPhase = "login" | "resend"
+
+const HOUR_MS = 3_600_000
+
+function reloginError(
+  code: ReloginErrorCode,
+  message: string,
+  retryAfterMs?: number,
+): Error & { code: ReloginErrorCode; retryAfterMs?: number; cause?: unknown } {
+  const error = new Error(message) as Error & {
+    code: ReloginErrorCode
+    retryAfterMs?: number
+    cause?: unknown
+  }
+  error.code = code
+  if (retryAfterMs !== undefined) {
+    error.retryAfterMs = retryAfterMs
+    error.cause = { retryAfterMs }
+  }
+  return error
+}
+
+export class ReloginGuard {
+  private readonly minIntervalMs: number
+  private readonly backoffMs: number[]
+  private readonly maxFailures: number
+  private readonly circuitMs: number
+  private readonly maxPerHour: number
+  private readonly sessionFailLimit: number
+  private readonly sessionPauseMs: number
+  private readonly onAttempt?: ReloginGuardOptions["onAttempt"]
+
+  /** 进程级：同账号（sha256 前 8 位）最近一小时的成功尝试时间戳。 */
+  private static processAttempts = new Map<string, number[]>()
+
+  private inflight: Promise<unknown> | null = null
+  private lastAttemptAt = 0
+  private backoffUntil = 0
+  private circuitUntil = 0
+  private failures = 0
+  private attempts = 0
+  /** resend 相连续失败（登录成功但会话不可用）。 */
+  private sessionFailures = 0
+  private sessionPauseUntil = 0
+
+  constructor(options: ReloginGuardOptions = {}) {
+    this.minIntervalMs = options.minIntervalMs ?? 60_000
+    this.backoffMs = options.backoffMs ?? [60_000, 300_000, 900_000, 1_800_000]
+    this.maxFailures = options.maxFailures ?? 4
+    this.circuitMs = options.circuitMs ?? 1_800_000
+    this.maxPerHour = options.maxPerHour ?? 6
+    this.sessionFailLimit = options.sessionFailLimit ?? 3
+    this.sessionPauseMs = options.sessionPauseMs ?? 1_800_000
+    this.onAttempt = options.onAttempt
+  }
+
+  /** 仅供单测清理进程级状态。 */
+  static resetProcessState(): void {
+    ReloginGuard.processAttempts.clear()
+  }
+
+  getAttemptCount(): number {
+    return this.attempts
+  }
+
+  getFailureCount(): number {
+    return this.failures
+  }
+
+  canAttempt(now: number = Date.now(), accountKey = ""): AttemptDecision {
+    if (this.sessionPauseUntil > 0) {
+      if (now < this.sessionPauseUntil) {
+        return {
+          ok: false,
+          reason: "session_pause",
+          retryAfterMs: this.sessionPauseUntil - now,
+        }
+      }
+      this.sessionPauseUntil = 0
+      this.sessionFailures = 0
+    }
+
+    if (this.circuitUntil > 0) {
+      if (now < this.circuitUntil) {
+        return {
+          ok: false,
+          reason: "circuit",
+          retryAfterMs: this.circuitUntil - now,
+        }
+      }
+      // 熔断到期：计数清零，重新开始。
+      this.circuitUntil = 0
+      this.failures = 0
+      this.backoffUntil = 0
+    }
+
+    if (this.failures > 0) {
+      const remain = this.backoffUntil - now
+      if (remain > 0) {
+        return { ok: false, reason: "backoff", retryAfterMs: remain }
+      }
+    }
+
+    if (this.lastAttemptAt > 0) {
+      const remain = this.minIntervalMs - (now - this.lastAttemptAt)
+      if (remain > 0) {
+        return { ok: false, reason: "min_interval", retryAfterMs: remain }
+      }
+    }
+
