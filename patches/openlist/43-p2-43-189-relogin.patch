diff --git a/src/backend/drivers/189/relogin.test.ts b/src/backend/drivers/189/relogin.test.ts
new file mode 100644
index 0000000..d04c6ec
--- /dev/null
+++ b/src/backend/drivers/189/relogin.test.ts
@@ -0,0 +1,215 @@
+import assert from "node:assert/strict"
+import { test } from "node:test"
+
+import {
+  RELOGIN_ERRORS,
+  ReloginGuard,
+  classifySessionInvalidResponse,
+  isSessionInvalidResponse,
+  shortHash,
+} from "./relogin"
+
+test("B1 errorCode=InvalidSessionKey is a session failure", () => {
+  assert.equal(isSessionInvalidResponse({ errorCode: "InvalidSessionKey" }), true)
+})
+
+test("B2 res_code=InvalidSessionKey is a session failure", () => {
+  assert.equal(isSessionInvalidResponse({ res_code: "InvalidSessionKey" }), true)
+})
+
+test("B3 res_code=1010 is a session failure", () => {
+  assert.equal(isSessionInvalidResponse({ res_code: 1010 }), true)
+  assert.equal(isSessionInvalidResponse({ res_code: "1010" }), true)
+})
+
+test("B4 check ip error text is a session failure", () => {
+  assert.equal(
+    isSessionInvalidResponse({
+      res_code: 0,
+      res_message:
+        "check ip error - curIp=1.1.1.1, cookiesIp=2.2.2.2",
+    }),
+    true,
+  )
+  // B18：无 errorCode、res_code=0 时才走文案兜底，reason 必须标出来。
+  assert.deepEqual(
+    classifySessionInvalidResponse({
+      res_code: 0,
+      res_message: "check ip error - curIp=1.1.1.1, cookiesIp=2.2.2.2",
+    }),
+    { invalid: true, reason: "msg_fallback" },
+  )
+  assert.equal(
+    isSessionInvalidResponse({
+      errorCode: "InvalidSessionKey",
+      errorMsg: "check ip error - curIp=1.1.1.1, cookiesIp=2.2.2.2",
+    }),
+    true,
+  )
+})
+
+test("B5 InvalidSessionKey plus check ip error stays a session failure", () => {
+  assert.equal(
+    isSessionInvalidResponse({
+      errorCode: "InvalidSessionKey",
+      errorMsg: "check ip error",
+    }),
+    true,
+  )
+})
+
+test("B6 a normal empty listing is not a session failure", () => {
+  assert.equal(
+    isSessionInvalidResponse({ res_code: 0, fileListAO: { count: 0 } }),
+    false,
+  )
+})
+
+test("B7 an ordinary API error is not a session failure", () => {
+  assert.equal(
+    isSessionInvalidResponse({ res_code: 400, res_message: "参数错误" }),
+    false,
+  )
+  // B17：res_code=400 + check ip error 文案不触发重登（明确不覆盖的一角）。
+  assert.equal(
+    isSessionInvalidResponse({
+      res_code: 400,
+      res_message: "check ip error - curIp=1.1.1.1, cookiesIp=2.2.2.2",
+    }),
+    false,
+  )
+})
+
+test("B8 empty or null payload does not throw", () => {
+  assert.equal(isSessionInvalidResponse({}), false)
+  assert.equal(isSessionInvalidResponse(null), false)
+  assert.equal(isSessionInvalidResponse(undefined), false)
+  assert.equal(isSessionInvalidResponse("check ip error"), false)
+})
+
+test("B9 first attempt is allowed", () => {
+  ReloginGuard.resetProcessState()
+  const guard = new ReloginGuard()
+  assert.equal(guard.canAttempt(1_000_000).ok, true)
+})
+
+test("B10 success enforces the 60 s minimum interval", () => {
+  ReloginGuard.resetProcessState()
+  const guard = new ReloginGuard()
+  guard.recordSuccess(1_000_000)
+  const decision = guard.canAttempt(1_001_000)
+  assert.equal(decision.ok, false)
+  assert.equal(decision.reason, "min_interval")
+  assert.ok(Math.abs((decision.retryAfterMs || 0) - 59_000) <= 1)
+})
+
+test("B11 failures back off 60/300/900 s, the fourth one trips the breaker", () => {
+  ReloginGuard.resetProcessState()
+  const guard = new ReloginGuard()
+  const start = 1_000_000
+
+  const expected = [60_000, 300_000, 900_000]
+  for (let i = 0; i < expected.length; i++) {
+    guard.recordFailure("login", start + i * 1_000_000)
+    const decision = guard.canAttempt(start + i * 1_000_000 + 1_000)
+    assert.equal(decision.ok, false)
+    assert.equal(decision.reason, "backoff")
+    assert.ok(Math.abs((decision.retryAfterMs || 0) - (expected[i] - 1_000)) <= 1)
+  }
+
+  const fourthAt = start + 3 * 1_000_000
+  guard.recordFailure("login", fourthAt)
+  const breaker = guard.canAttempt(fourthAt + 1_000)
+  assert.equal(breaker.ok, false)
+  assert.equal(breaker.reason, "circuit")
+  assert.ok(Math.abs((breaker.retryAfterMs || 0) - (1_800_000 - 1_000)) <= 1)
+
+  // B19：resend 相（登录成功但会话不可用）单独计数，3 次后暂停 30 min，
+  // 不走进登录熔断；文案走 session_pause 分支。
+  const sessionGuard = new ReloginGuard()
+  const t0 = 2_000_000
+  for (let i = 0; i < 2; i++) sessionGuard.recordFailure("resend", t0 + i * 61_000)
+  assert.equal(sessionGuard.canAttempt(t0 + 122_000).ok, true)
+  sessionGuard.recordFailure("resend", t0 + 122_000)
+  const paused = sessionGuard.canAttempt(t0 + 123_000)
+  assert.equal(paused.ok, false)
+  assert.equal(paused.reason, "session_pause")
+  assert.ok(Math.abs((paused.retryAfterMs || 0) - (1_800_000 - 1_000)) <= 1)
+})
+
+test("B12 the breaker clears after 30 minutes", () => {
+  ReloginGuard.resetProcessState()
+  const guard = new ReloginGuard()
+  const start = 5_000_000
+  for (let i = 0; i < 4; i++) guard.recordFailure("login", start)
+  assert.equal(guard.getFailureCount(), 4)
+  assert.equal(guard.canAttempt(start + 1_800_000 + 1).ok, true)
+  assert.equal(guard.getFailureCount(), 0)
+})
+
+test("B13 five concurrent runs share one login", async () => {
+  ReloginGuard.resetProcessState()
+  const guard = new ReloginGuard()
+  let calls = 0
+  const run = () =>
+    guard.run(async () => {
+      calls += 1
+      await new Promise((resolve) => setTimeout(resolve, 10))
+      return calls
+    })
+  const results = await Promise.all([run(), run(), run(), run(), run()])
+  assert.equal(calls, 1)
+  assert.deepEqual(results, [1, 1, 1, 1, 1])
+})
+
+test("B13b a throttled run rejects with 189_RELOGIN_THROTTLED and retryAfterMs", async () => {
+  ReloginGuard.resetProcessState()
+  const guard = new ReloginGuard()
+  await guard.run(async () => undefined, 1_000_000)
+  await assert.rejects(
+    () => guard.run(async () => undefined, 1_001_000),
+    (error: any) => {
+      assert.equal(error.code, RELOGIN_ERRORS.THROTTLED)
+      assert.ok(error.retryAfterMs > 58_000 && error.retryAfterMs <= 59_000)
+      assert.ok(error.message.includes(RELOGIN_ERRORS.THROTTLED))
+      return true
+    },
+  )
+})
+
+test("B13c a failing run records one failure and rethrows the original error", async () => {
+  ReloginGuard.resetProcessState()
+  const guard = new ReloginGuard()
+  await assert.rejects(
+    () =>
+      guard.run(async () => {
+        throw new Error("boom")
+      }, 1_000_000),
+    /boom/,
+  )
+  assert.equal(guard.getFailureCount(), 1)
+  assert.equal(guard.getAttemptCount(), 1)
+})
+
+test("B13d the process-level account limit stops the seventh attempt per hour", async () => {
+  ReloginGuard.resetProcessState()
+  const guard = new ReloginGuard()
+  const key = shortHash("user@example.com")
+  const start = 10_000_000
+  for (let i = 0; i < 6; i++) {
+    const at = start + i * 61_000
+    assert.equal(guard.canAttempt(at, key).ok, true)
+    await guard.run(async () => undefined, at, key)
+  }
+  const blocked = guard.canAttempt(start + 6 * 61_000, key)
+  assert.equal(blocked.ok, false)
+  assert.equal(blocked.reason, "hourly_limit")
+})
+
+test("B14 shortHash matches the sha256 of the account name", () => {
+  assert.equal(
+    shortHash("abc"),
+    "ba7816bf",
+  )
+  assert.equal(shortHash(""), "e3b0c442")
+})
