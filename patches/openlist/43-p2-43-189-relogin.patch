+    this.lastAttemptAt = now
+    this.attempts += 1
+    const attempt = this.attempts
+    if (accountKey) {
+      const recent = (ReloginGuard.processAttempts.get(accountKey) || []).filter(
+        (at) => now - at < HOUR_MS,
+      )
+      recent.push(now)
+      ReloginGuard.processAttempts.set(accountKey, recent)
+    }
+    try {
+      this.onAttempt?.({ attempt, now })
+    } catch {
+      // 日志回调不得影响登录本身。
+    }
+
+    const task = Promise.resolve()
+      .then(fn)
+      .then(
+        (value) => {
+          this.recordSuccess(now)
+          return value
+        },
+        (error) => {
+          const phase: ReloginPhase =
+            (error as any)?.phase === "resend" ? "resend" : "login"
+          this.recordFailure(phase, now)
+          throw error
+        },
+      )
+    const tracked = task.finally(() => {
+      if (this.inflight === tracked) this.inflight = null
+    })
+    this.inflight = tracked
+    return tracked
+  }
+}
