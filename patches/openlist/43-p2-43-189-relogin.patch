+          ? `[189Cloud] 登录成功但会话不可用，${seconds} 秒后再试（${RELOGIN_ERRORS.THROTTLED}）`
+          : `[189Cloud] 重登被限流，${seconds} 秒后再试（${RELOGIN_ERRORS.THROTTLED}）`
+      return Promise.reject(
+        reloginError(RELOGIN_ERRORS.THROTTLED, message, decision.retryAfterMs),
+      )
+    }
