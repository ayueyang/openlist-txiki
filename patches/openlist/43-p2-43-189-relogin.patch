+  recordSuccess(now: number = Date.now()): void {
+    this.failures = 0
+    this.backoffUntil = 0
+    this.circuitUntil = 0
+    this.sessionFailures = 0
+    this.sessionPauseUntil = 0
+    this.lastAttemptAt = now
+  }
+
+  /**
+   * 失败计数分相（10:37 勘误 D-3）。
+   * - phase=login：计入 60/300/900/1800 退避与 30 min 熔断；
+   * - phase=resend：单独计数，连续 3 次暂停 30 min，不进登录熔断。
+   */
+  recordFailure(phase: ReloginPhase = "login", now: number = Date.now()): void {
+    if (phase === "resend") {
+      this.sessionFailures += 1
+      this.lastAttemptAt = now
+      if (this.sessionFailures >= this.sessionFailLimit) {
+        this.sessionPauseUntil = now + this.sessionPauseMs
+      }
+      return
+    }
+    this.failures += 1
+    this.lastAttemptAt = now
+    if (this.failures >= this.maxFailures) {
+      this.circuitUntil = now + this.circuitMs
+      this.backoffUntil = this.circuitUntil
+      return
+    }
+    const index = Math.min(this.failures, this.backoffMs.length) - 1
+    this.backoffUntil = now + this.backoffMs[index]
+  }
+
+  /**
+   * 单飞 + 限流 + 计数。
+   * 1) 已有 inflight 直接复用它，不重复登录；
+   * 2) canAttempt 拒绝则抛 189_RELOGIN_THROTTLED（带 retryAfterMs）；
+   * 3) 执行 fn，成功清零失败计数，失败累加并进入退避/熔断。
+   */
+  run<T>(fn: () => Promise<T>, now: number = Date.now(), accountKey = ""): Promise<T> {
