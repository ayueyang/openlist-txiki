diff --git a/src/backend/drivers/aliyundrive_open/limiter.ts b/src/backend/drivers/aliyundrive_open/limiter.ts
new file mode 100644
index 0000000..4e7b756
--- /dev/null
+++ b/src/backend/drivers/aliyundrive_open/limiter.ts
@@ -0,0 +1,62 @@
+/**
+ * 阿里云盘 Open 的 per-user 轻量限流。
+ *
+ * 参数取自 alist/OpenList 的 limiter.go:20-30：list 3.9/s、link 0.9/s、
+ * other 14.9/s。实现为「按 user + 桶排队的最小间隔」，只等待、不抛错，
+ * 调用方语义与不限流时一致；日志只在真的等过时打一行。
+ */
+
+export type AliyunRateBucket = "list" | "link" | "other"
+
+export const ALIYUN_RATE_INTERVAL_MS: Record<AliyunRateBucket, number> = {
+  list: Math.ceil(1000 / 3.9),
+  link: Math.ceil(1000 / 0.9),
+  other: Math.ceil(1000 / 14.9),
+}
+
+interface BucketState {
+  nextAt: number
+}
+
+const users = new Map<string, Map<AliyunRateBucket, BucketState>>()
+
+function bucketFor(userKey: string, bucket: AliyunRateBucket): BucketState {
+  let buckets = users.get(userKey)
+  if (!buckets) {
+    buckets = new Map()
+    users.set(userKey, buckets)
+  }
+  let state = buckets.get(bucket)
+  if (!state) {
+    state = { nextAt: 0 }
+    buckets.set(bucket, state)
+  }
+  return state
+}
+
+export function classifyAliyunPath(path: string): AliyunRateBucket {
+  if (path.includes("/openFile/list")) return "list"
+  if (path.includes("/openFile/getDownloadUrl")) return "link"
+  return "other"
+}
+
+/** 按 user + 桶排队；返回实际等待的毫秒数（0 表示没等）。 */
+export async function waitAliyunRateLimit(
+  userKey: string,
+  bucket: AliyunRateBucket,
+  now: number = Date.now(),
+): Promise<number> {
+  const state = bucketFor(userKey, bucket)
+  const start = Math.max(now, state.nextAt)
+  const waitMs = start - now
+  state.nextAt = start + ALIYUN_RATE_INTERVAL_MS[bucket]
+  if (waitMs > 0) {
+    await new Promise((resolve) => setTimeout(resolve, waitMs))
+  }
+  return waitMs
+}
+
+/** 仅单测用：清空进程级状态。 */
+export function resetAliyunRateLimit(): void {
+  users.clear()
+}
