@@ -0,0 +1,149 @@
+import assert from "node:assert/strict"
+import { test } from "node:test"
+import { saveDb } from "../model/db"
+import { canonicalizeShareFiles, resolveShare } from "./share"
+
+const env: any = {}
+
+const SH_USER: any = { role: 0, permission: 16384, base_path: "/t/pub" }
+
+const seed = (shares: any[], users: any[] = []) =>
+  saveDb(
+    {
+      settings: [],
+      users,
+      storages: [],
+      shares,
+    },
+    env,
+  )
+
+const share = (over: any = {}) => ({
+  id: "abc",
+  files: ["/t/pub/inside.txt"],
+  creator: "audsh",
+  creator_role: 0,
+  pwd: "",
+  disabled: false,
+  expires: null,
+  max_accessed: 0,
+  accessed: 0,
+  ...over,
+})
+
+test("P1-20 create: 四种编码写法全部 403 relative path", () => {
+  for (const bad of [
+    "/%2e%2e/secret/secret.txt",
+    "/..../secret/secret.txt",
+    "/%252e%252e/secret/secret.txt",
+    "/..%2Fsecret/secret.txt",
+  ]) {
+    const r = canonicalizeShareFiles(SH_USER, [bad])
+    assert.equal(r.ok, false, bad)
+    if (!r.ok) {
+      assert.equal(r.status, 403, bad)
+      assert.equal(r.error, "relative path", bad)
+    }
+  }
+})
+
+test("P1-20 create: 合法项落库为规范全局路径，逐字节", () => {
+  const r = canonicalizeShareFiles(SH_USER, ["/inside.txt"])
+  assert.equal(r.ok, true)
+  if (r.ok) assert.deepEqual(r.files, ["/t/pub/inside.txt"])
+})
+
+test("P1-20 create: 规范化后重复项去重保留首次（单文件分享不退化成 virtualList）", () => {
+  const r = canonicalizeShareFiles(SH_USER, ["/inside.txt", "/inside.txt", "/./inside.txt"])
+  assert.equal(r.ok, true)
+  if (r.ok) assert.deepEqual(r.files, ["/t/pub/inside.txt"])
+})
+
+test("P1-20 create: 空项/空数组/非数组/非字符串 400", () => {
+  for (const bad of [[], [""], ["", "/x"], undefined, "x", [1], [null]]) {
+    const r = canonicalizeShareFiles(SH_USER, bad as any)
+    assert.equal(r.ok, false, String(bad))
+    if (!r.ok) assert.equal(r.status, 400, String(bad))
+  }
+})
+
+test("P1-20 create: 非管理员提交 /@s/... 403（不能分享另一条分享）", () => {
+  const r = canonicalizeShareFiles(SH_USER, ["/@s/abc"])
+  assert.equal(r.ok, false)
+  if (!r.ok) assert.equal(r.status, 403)
+})
+
+test("P1-20 create: 管理员允许根外绝对路径，仍过规范化", () => {
+  const admin: any = { role: 2, permission: 0, base_path: "/" }
+  const ok = canonicalizeShareFiles(admin, ["/t/secret/secret.txt"])
+  assert.equal(ok.ok, true)
+  if (ok.ok) assert.deepEqual(ok.files, ["/t/secret/secret.txt"])
+  const bad = canonicalizeShareFiles(admin, ["/%2e%2e/x"])
+  assert.equal(bad.ok, false)
+  if (!bad.ok) assert.equal(bad.status, 403)
+})
+
+test("P1-20 access: 旧记录含编码残留整条拒绝 403", async () => {
+  await seed([share({ files: ["/t/pub/%2e%2e/secret/secret.txt"] })])
+  const r = await resolveShare("/@s/abc", "", env)
+  assert.equal(r.ok, false)
+  assert.equal(r.status, 403)
+  assert.equal(r.error, "relative path")
+})
+
+test("P1-20 access: 规范串但在创建者当前根外 403（第二层）", async () => {
+  await seed(
+    [share({ files: ["/t/secret/secret.txt"] })],
+    [{ username: "audsh", role: 0, permission: 16384, base_path: "/t/pub" }],
+  )
+  const r = await resolveShare("/@s/abc", "", env)
+  assert.equal(r.ok, false)
+  assert.equal(r.status, 403)
+})
+
+test("P1-20 access: 用户表 role 优先于记录里的 creator_role（伪造 2 绕不过）", async () => {
+  await seed(
+    [share({ files: ["/t/secret/secret.txt"], creator_role: 2 })],
+    [{ username: "audsh", role: 0, permission: 16384, base_path: "/t/pub" }],
+  )
+  const r = await resolveShare("/@s/abc", "", env)
+  assert.equal(r.ok, false)
+  assert.equal(r.status, 403)
+})
+
+test("P1-20 access: 合法单文件分享 realPath 逐字节等于落库串", async () => {
+  await seed([share()])
+  const r = await resolveShare("/@s/abc", "", env)
+  assert.equal(r.ok, true)
+  assert.equal(r.realPath, "/t/pub/inside.txt")
+})
+
+test("P1-20 access: 多文件分享返回规范 roots，子路径按 basename 落到规范串", async () => {
+  await seed([share({ files: ["/t/pub/inside.txt", "/t/pub/sub/inside3.txt"] })])
+  const root = await resolveShare("/@s/abc", "", env)
+  assert.equal(root.ok, true)
+  assert.deepEqual(root.files, ["/t/pub/inside.txt", "/t/pub/sub/inside3.txt"])
+  assert.equal(root.virtualList, true)
+  const sub = await resolveShare("/@s/abc/inside3.txt", "", env)
+  assert.equal(sub.ok, true)
+  assert.equal(sub.realPath, "/t/pub/sub/inside3.txt")
+})
+
+test("P1-20 access: 目录分享 realPath 为规范根；访客 .. 一律 403", async () => {
+  await seed([share({ files: ["/t/pub"] })])
+  const r = await resolveShare("/@s/abc", "", env)
+  assert.equal(r.ok, true)
+  assert.equal(r.realPath, "/t/pub")
+  for (const bad of ["/@s/abc/../../..", "/@s/abc/%2e%2e", "/@s/abc/...."]) {
+    const rr = await resolveShare(bad, "", env)
+    assert.equal(rr.ok, false, bad)
+    assert.equal(rr.status, 403, bad)
+  }
+})
+
+test("P1-20 access: 密码错仍回 wrong password（顺序不变）", async () => {
+  await seed([share({ pwd: "p120pw" })])
+  const r = await resolveShare("/@s/abc", "wrong", env)
+  assert.equal(r.ok, false)
+  assert.equal(r.error, "wrong password")
+})
