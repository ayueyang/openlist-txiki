+test("p2-84 move/copy 目标用物理 dstPhys 探测：虚拟 dstDir 不参与", async () => {
+  const d = newDriver({ writable: true, paths: "/local1" })
+  d.probeAll = true
+  await d.move("/v/ops", "/v/dir2", ["mv1.txt"], "/ops/mv1.txt", "/dir2/mv1.txt")
+  await d.copy("/v/ops", "/v/dir2", ["cp1.txt"], "/ops/cp1.txt", "/dir2/cp1.txt")
