+++ b/src/backend/server/raw-internal.test.ts
@@ -0,0 +1,120 @@
+/**
+ * r64 补丁 78（缺陷 C）单测：alias 挂载下载的进程内跳转判定。
+ *
+ * 只测纯函数，不发网络请求、不建存储：
+ * - 相对 raw_url 放行（/api/p、/api/d、/api/sd、/p、/d、/sd）；
+ * - 绝对外网 URL 仍 pass（后续仍走原 SSRF 判定）；
+ * - `//evil`、反斜杠、`..`、`%2e`、`%25` 二次编码拒绝；
+ * - hop 上限 3，伪造 hop 头无效。
+ */
+import assert from "node:assert/strict"
+import { test } from "node:test"
+
+import {
+  HOP_HEADER,
+  HOP_LIMIT,
+  buildInternalRequest,
+  internalHopHeader,
+  isInternalRawUrl,
+  parseHopHeader,
+  planInternalDispatch,
+} from "./internal-dispatch"
+
+test("r64 补丁 78：六个内部下载前缀的相对 raw_url 放行", () => {
+  for (const url of [
+    "/api/p/l1/dup.txt",
+    "/api/d/l1/dup.txt",
+    "/api/sd/share1/dup.txt",
+    "/p/l1/dup.txt",
+    "/d/l1/dup.txt",
+    "/sd/share1/dup.txt",
+  ]) {
+    assert.equal(isInternalRawUrl(url), true, url)
+    assert.deepEqual(planInternalDispatch(url, 0), {
+      action: "dispatch",
+      hop: 1,
+      url,
+    })
+  }
+})
+
+test("r64 补丁 78：绝对外网 URL 仍 pass，不进入内部跳转", () => {
+  for (const url of [
+    "https://example.com/file.bin",
+    "http://192.168.7.1:15361/api/p/l1/dup.txt",
+    "ftp://example.com/x",
+  ]) {
+    assert.equal(isInternalRawUrl(url), false, url)
+    assert.deepEqual(planInternalDispatch(url, 0), { action: "pass" })
+  }
+})
+
+test("r64 补丁 78：//evil、反斜杠、非白名单前缀拒绝", () => {
+  for (const url of [
+    "//evil.example/api/p/x",
+    "/\\evil/api/p/x",
+    "/api/x/l1/dup.txt",
+    "/raw/x",
+    "/api/px/l1/dup.txt",
+    " /api/p/x",
+  ]) {
+    assert.equal(isInternalRawUrl(url), false, url)
+  }
+})
+
+test("r64 补丁 78：.. 段、%2e 与 %25 二次编码残留拒绝", () => {
+  for (const url of [
+    "/api/p/../etc/passwd",
+    "/api/p/%2e%2e/etc/passwd",
+    "/api/p/%2E%2E/etc/passwd",
+    "/api/p/%252e%252e/etc/passwd",
+    "/api/p/x%25y",
+    "/api/p/./x",
+  ]) {
+    assert.equal(isInternalRawUrl(url), false, url)
+  }
+})
+
+test("r64 补丁 78：hop 上限 3，超限返回 loop", () => {
+  assert.deepEqual(planInternalDispatch("/api/p/x", HOP_LIMIT - 1), {
+    action: "dispatch",
+    hop: HOP_LIMIT,
+    url: "/api/p/x",
+  })
+  assert.deepEqual(planInternalDispatch("/api/p/x", HOP_LIMIT), {
+    action: "loop",
+  })
+  assert.deepEqual(planInternalDispatch("/api/p/x", HOP_LIMIT + 1), {
+    action: "loop",
+  })
+})
+
+test("r64 补丁 78：伪造 hop 头无效，本进程 hop 头可解析", () => {
+  assert.equal(parseHopHeader(""), 0)
+  assert.equal(parseHopHeader(undefined), 0)
+  assert.equal(parseHopHeader("forged:1"), 0)
+  assert.equal(parseHopHeader("deadbeefdeadbeef:2"), 0)
+  assert.equal(parseHopHeader(":1"), 0)
+  assert.equal(parseHopHeader("x:0"), 0)
+  assert.equal(parseHopHeader("x:-1"), 0)
+  assert.equal(parseHopHeader("x:1.5"), 0)
+  assert.equal(parseHopHeader(internalHopHeader(1)), 1)
+  assert.equal(parseHopHeader(internalHopHeader(HOP_LIMIT)), HOP_LIMIT)
+})
+
+test("r64 补丁 78：内部 Request 用固定占位主机，只带 hop 与 Range", () => {
+  const req = buildInternalRequest("/api/p/l1/dup.txt", 2, {
+    method: "GET",
+    range: "bytes=0-2",
+  })
+  assert.equal(req.url, "http://internal/api/p/l1/dup.txt")
+  assert.equal(req.method, "GET")
+  assert.equal(req.headers.get(HOP_HEADER), internalHopHeader(2))
+  assert.equal(req.headers.get("Range"), "bytes=0-2")
+  assert.equal(req.headers.get("Authorization"), null)
+  const head = buildInternalRequest("/api/p/l1/dup.txt", 1, {
+    method: "HEAD",
+  })
+  assert.equal(head.method, "HEAD")
+  assert.equal(head.headers.get("Range"), null)
+})
