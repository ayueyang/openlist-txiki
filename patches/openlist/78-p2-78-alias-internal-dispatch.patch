+++ b/src/backend/server/internal-dispatch.ts
@@ -0,0 +1,117 @@
+/**
+ * r64 补丁 78（缺陷 C）：alias 挂载下载的进程内跳转。
+ *
+ * alias 驱动把目标存储返回的**相对** raw_url（`/api/p/<目标挂载>/<文件>`）
+ * 原样透传，rawRouter 却把它当外网地址交给 safeProxyFetch：`new URL()` 对相对
+ * 串抛错，`isSafeUrl` 回 false，于是 403。本模块只做两件事：
+ *
+ * 1. 判断一个 raw_url 是不是「本实例内部的下载路径」——只看字符串形态与路径
+ *    前缀白名单，不读请求 Host、不读绑定地址、不读 trusted hosts；
+ * 2. 构造一个进程内 Request 与原样透传的 hop 头。
+ *
+ * 安全边界：
+ * - 只接受 `/api/p`、`/api/d`、`/api/sd`、`/p`、`/d`、`/sd` 前缀的相对路径；
+ * - 拒绝 `//`、反斜杠、空白/控制字符、查询串与片段、`..` 段、`%2e` 与
+ *   `%25` 二次编码残留（这些一律 pass，交回原 SSRF 判定）；
+ * - 绝对 URL 一律 pass，仍走原 SSRF 判定，不放宽任何 host；
+ * - hop 计数使用模块加载时随机生成的 nonce，客户端不可知；伪造头按 0 处理，
+ *   nonce 不匹配的头不参与任何放行判断。
+ */
+export const HOP_HEADER = "x-openlist-hop"
+
+/** 内部跳转上限：n 允许 1..3，准备发出第 4 跳时回 403。 */
+export const HOP_LIMIT = 3
+
+const INTERNAL_ORIGIN = "http://internal"
+const RAW_PREFIXES = ["/api/p", "/api/d", "/api/sd", "/p", "/d", "/sd"]
+
+function randomNonce(): string {
+  const bytes = new Uint8Array(16)
+  const webCrypto = (globalThis as any).crypto
+  if (webCrypto && typeof webCrypto.getRandomValues === "function") {
+    webCrypto.getRandomValues(bytes)
+  } else {
+    for (let i = 0; i < bytes.length; i++) {
+      bytes[i] = Math.floor(Math.random() * 256)
+    }
+  }
+  return Array.from(bytes, (b) => b.toString(16).padStart(2, "0")).join("")
+}
+
+const DISPATCH_NONCE = randomNonce()
+
+/** 解析 hop 头：nonce 不匹配或格式不合法一律按 0（外部请求）处理。 */
+export function parseHopHeader(value: string | null | undefined): number {
+  if (!value) return 0
+  const idx = value.lastIndexOf(":")
+  if (idx <= 0) return 0
+  if (value.slice(0, idx) !== DISPATCH_NONCE) return 0
+  const raw = value.slice(idx + 1)
+  if (!/^\d+$/.test(raw)) return 0
+  const n = Number(raw)
+  if (!Number.isSafeInteger(n) || n < 1) return 0
+  return n
+}
+
+/** 生成本进程内部使用的 hop 头（只发给 rawRouter 自己）。 */
+export function internalHopHeader(next: number): string {
+  return `${DISPATCH_NONCE}:${next}`
+}
+
+/**
+ * 相对 raw_url 校验：必须是本实例的下载端点路径，且不含任何越界/二次编码
+ * 残留。返回 true 时才允许进程内跳转。
+ */
+export function isInternalRawUrl(value: unknown): value is string {
+  if (typeof value !== "string") return false
+  if (!value.startsWith("/") || value.startsWith("//")) return false
+  // 反斜杠、空白、控制字符、查询串、片段：一律不当作内部路径。
+  if (/[\\\u0000-\u001f\u007f\s?#]/.test(value)) return false
+  const matched = RAW_PREFIXES.some(
+    (prefix) => value === prefix || value.startsWith(prefix + "/"),
+  )
+  if (!matched) return false
+  // 二次编码残留（%252e -> %2e -> .）与任何 %2e 编码都不放行。
+  if (value.includes("%25")) return false
+  if (/%2e/i.test(value)) return false
+  const segments = value.split("/")
+  if (segments.some((s) => s === "." || s === "..")) return false
+  return true
+}
+
+export type DispatchPlan =
+  | { action: "dispatch"; hop: number; url: string }
+  | { action: "loop" }
+  | { action: "pass" }
+
+/**
+ * 决策：pass=不是内部路径（走原判定）；dispatch=内部跳转；loop=超过上限。
+ * currentHop 来自 parseHopHeader，外部请求恒为 0。
+ */
+export function planInternalDispatch(
+  rawUrl: unknown,
+  currentHop: number,
+): DispatchPlan {
+  if (!isInternalRawUrl(rawUrl)) return { action: "pass" }
+  if (currentHop >= HOP_LIMIT) return { action: "loop" }
+  return { action: "dispatch", hop: currentHop + 1, url: rawUrl }
+}
+
+/**
+ * 构造进程内 Request：URL 主机用固定占位符 `http://internal`，路径用原
+ * raw_url（getItem 产出的 raw_url 已逐段编码，不再二次编码）。只透传 Range；
+ * 其余请求头不进入内层，避免把鉴权信息或伪造头带进第二跳。
+ */
+export function buildInternalRequest(
+  rawUrl: string,
+  hop: number,
+  opts: { method?: string; range?: string } = {},
+): Request {
+  const method =
+    (opts.method || "GET").toUpperCase() === "HEAD" ? "HEAD" : "GET"
+  const headers: Record<string, string> = {
+    [HOP_HEADER]: internalHopHeader(hop),
+  }
+  if (opts.range) headers["Range"] = opts.range
+  return new Request(INTERNAL_ORIGIN + rawUrl, { method, headers })
+}
diff --git a/src/backend/server/raw-alias-dispatch.test.ts b/src/backend/server/raw-alias-dispatch.test.ts
