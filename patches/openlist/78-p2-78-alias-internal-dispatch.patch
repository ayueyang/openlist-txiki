+++ b/src/backend/server/raw-alias-dispatch.test.ts
@@ -0,0 +1,118 @@
+/**
+ * r64 补丁 78（缺陷 C）handler 级回归：alias 挂载下载不再被 SSRF 判定误杀。
+ *
+ * 场景与设备侧缺陷单同形：Local 存储挂在 /l1，Alias 存储挂在 /aliasPlain、
+ * paths=/l1。alias 的 get() 把目标存储返回的相对 raw_url（/api/p/l1/dup.txt）
+ * 原样透传；修前 rawRouter 把它当外网地址，safeProxyFetch 的 new URL() 抛错，
+ * 回 403 SSRF protection。修后走进程内 dispatch，Local 分支直接读文件。
+ *
+ * 全部本地，不建网络连接、不需要设备。
+ */
+import assert from "node:assert/strict"
+import { mkdtemp, mkdir, rm, writeFile } from "node:fs/promises"
+import { tmpdir } from "node:os"
+import { dirname, join } from "node:path"
+import { test } from "node:test"
+import { Hono } from "hono"
+
+import { saveDb } from "../internal/model/db"
+import { rawRouter } from "./raw"
+
+const env: any = {}
+
+const app = new Hono()
+app.route("/p", rawRouter)
+
+async function makeTree(files: Record<string, string>): Promise<string> {
+  const root = await mkdtemp(join(tmpdir(), "openlist-p78-"))
+  for (const [rel, content] of Object.entries(files)) {
+    const full = join(root, rel)
+    await mkdir(dirname(full), { recursive: true })
+    await writeFile(full, content)
+  }
+  return root
+}
+
+async function seed(root: string, id: string) {
+  await saveDb(
+    {
+      settings: [],
+      users: [
+        {
+          id: 1,
+          username: "admin",
+          password: "xxx",
+          role: 2,
+          permission: 0,
+          base_path: "/",
+          disabled: false,
+        },
+      ],
+      storages: [
+        {
+          id: `${id}-local`,
+          mount_path: "/l1",
+          driver: "local",
+          disabled: false,
+          addition: JSON.stringify({ root_folder_path: root }),
+        },
+        {
+          id: `${id}-alias`,
+          mount_path: "/aliasPlain",
+          driver: "alias",
+          disabled: false,
+          // /p 端点准入（canProxy）要求 alias 自身开 web_proxy 或命中
+          // proxy_types/text_types；设备复现里 alias 正是可代理状态。
+          web_proxy: true,
+          addition: JSON.stringify({ paths: "/l1", writable: true }),
+        },
+      ],
+      shares: [],
+    },
+    env,
+  )
+}
+
+test("r64 缺陷 C：alias 挂载 GET 回源文件字节（修前 403 SSRF）", async (t) => {
+  const root = await makeTree({ "dup.txt": "abcdef" })
+  t.after(() => rm(root, { recursive: true, force: true }))
+  await seed(root, "p78-full")
+
+  const res = await app.request("/p/aliasPlain/dup.txt", { method: "GET" }, env)
+  assert.equal(res.status, 200)
+  assert.equal(res.headers.get("content-length"), "6")
+  assert.equal(await res.text(), "abcdef")
+})
+
+test("r64 缺陷 C：alias 挂载 GET 带 Range 回 206 与正确 Content-Range", async (t) => {
+  const root = await makeTree({ "dup.txt": "abcdef" })
+  t.after(() => rm(root, { recursive: true, force: true }))
+  await seed(root, "p78-range")
+
+  const res = await app.request(
+    "/p/aliasPlain/dup.txt",
+    { method: "GET", headers: { Range: "bytes=0-2" } },
+    env,
+  )
+  assert.equal(res.status, 206)
+  assert.equal(res.headers.get("content-range"), "bytes 0-2/6")
+  assert.equal(await res.text(), "abc")
+})
+
+test("r64 缺陷 C：Local 对照路径同口径（200 与 206）", async (t) => {
+  const root = await makeTree({ "dup.txt": "abcdef" })
+  t.after(() => rm(root, { recursive: true, force: true }))
+  await seed(root, "p78-local")
+
+  const full = await app.request("/p/l1/dup.txt", { method: "GET" }, env)
+  assert.equal(full.status, 200)
+  assert.equal(await full.text(), "abcdef")
+  const part = await app.request(
+    "/p/l1/dup.txt",
+    { method: "GET", headers: { Range: "bytes=0-2" } },
+    env,
+  )
+  assert.equal(part.status, 206)
+  assert.equal(part.headers.get("content-range"), "bytes 0-2/6")
+  assert.equal(await part.text(), "abc")
+})
