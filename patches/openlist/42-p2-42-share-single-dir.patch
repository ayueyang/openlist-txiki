+
+test("P6-2e access: 单目录分享子路径落到规范串，越界与编码残留仍 403", async () => {
+  await seed([share({ files: ["/t/pub"] })])
+  const root = await resolveShare("/@s/abc", "", env)
+  assert.equal(root.ok, true)
+  assert.equal(root.realPath, "/t/pub")
+  const sub = await resolveShare("/@s/abc/sub/inside.txt", "", env)
+  assert.equal(sub.ok, true)
+  assert.equal(sub.realPath, "/t/pub/sub/inside.txt")
+  for (const bad of ["/@s/abc/../../etc/passwd", "/@s/abc/%2e%2e/x"]) {
+    const rr = await resolveShare(bad, "", env)
+    assert.equal(rr.ok, false, bad)
+    assert.equal(rr.status, 403, bad)
+  }
+})
