+ * ENOENT 必须继续是 500。storage not found 与 fs.ts 写路由共用同一判定。
+ */
+function isSourceMissing(e: any): boolean {
+  const code = e?.code
+  if (code === "ENOENT" || code === "ENOTDIR") return true
+  if (code === 404 || code === 1004) return true
+  if (isStorageNotFoundError(e)) return true
+  return /not found/i.test(String(e?.message || ""))
+}
+
+class SourceMissingError extends Error {
+  constructor(original: any) {
+    super(String(original?.message || original))
+  }
+}
