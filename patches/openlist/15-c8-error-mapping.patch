+ * 补偿改名必须在错误冒泡前执行；直接返回 Response 会短路 catch，文件会停在
+ * 目标名上。
+ */
+async function sourceStep<T>(call: () => Promise<T>): Promise<T> {
+  try {
+    return await call()
+  } catch (e: any) {
+    if (!isSourceMissing(e)) throw e
+    console.error(`[dav] source missing: ${String(e?.message || e)}`)
+    throw new SourceMissingError(e)
+  }
+}
