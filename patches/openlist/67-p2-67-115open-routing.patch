diff -ruN a/src/backend/drivers/115open/routing.test.ts b/src/backend/drivers/115open/routing.test.ts
--- a/src/backend/drivers/115open/routing.test.ts	1970-01-01 08:00:00.000000000 +0800
+++ b/src/backend/drivers/115open/routing.test.ts	2026-11-09 05:45:32.211612100 +0800
@@ -0,0 +1,122 @@
+import assert from "node:assert/strict"
+import { afterEach, beforeEach, test } from "node:test"
+
+import { getDriver } from "../../internal/op/storage"
+import { Pan115Driver } from "./driver"
+
+// 全部用例只 mock globalThis.fetch：不连网、不登录、不需要真实 115 账号。
+
+const realFetch = globalThis.fetch
+let fetchCalls = 0
+
+function jsonResponse(body: any): any {
+  const text = JSON.stringify(body)
+  return {
+    ok: true,
+    status: 200,
+    headers: { get: () => "application/json" },
+    text: async () => text,
+    json: async () => JSON.parse(text),
+  }
+}
+
+beforeEach(() => {
+  fetchCalls = 0
+  globalThis.fetch = (async (input: any) => {
+    fetchCalls++
+    const url = String(input)
+    // Pan115Driver.init 的 token 校验（proapi 开放平台）
+    if (url.includes("/open/user/info")) {
+      return jsonResponse({
+        state: true,
+        code: 0,
+        data: { user_id: 1, user_name: "u" },
+      })
+    }
+    // Driver115.init 的 token 校验（passport）
+    if (url.includes("passportapi.115.com")) {
+      return jsonResponse({ state: true, data: { user_id: 1 } })
+    }
+    // Driver115Cookie.init 的登录态校验
+    if (url.includes("my.115.com")) {
+      return jsonResponse({ state: true })
+    }
+    return jsonResponse({ state: true, code: 0, data: {} })
+  }) as any
+})
+
+afterEach(() => {
+  globalThis.fetch = realFetch
+})
+
+function cfg(id: string, addition: any) {
+  return {
+    id,
+    mount_path: "/115",
+    addition: JSON.stringify(addition),
+    modified: 1,
+    disabled: false,
+  }
+}
+
+test("driver 名 115 Open 精确路由到 Pan115Driver", async () => {
+  const driver = await getDriver(
+    "115 Open",
+    cfg("r67-pos-115open", { refresh_token: "r", access_token: "a" }),
+  )
+  assert.equal(driver.constructor.name, "Pan115Driver")
+})
+
+test("driver 名 115 + 仅 cookie 仍路由到 Driver115Cookie（patch 41 双轨回归）", async () => {
+  const driver = await getDriver(
+    "115",
+    cfg("r67-neg-cookie", { cookie: "UID=1;CID=2;SEID=3", access_token: "" }),
+  )
+  assert.equal(driver.constructor.name, "Driver115Cookie")
+})
+
+test("driver 名 115 + token 仍路由到 Driver115", async () => {
+  const driver = await getDriver(
+    "115",
+    cfg("r67-neg-token", { access_token: "a", refresh_token: "r" }),
+  )
+  assert.equal(driver.constructor.name, "Driver115")
+})
+
+test("Pan115Driver.put fail-closed：抛未接线且不发任何 fetch", async () => {
+  const driver = new Pan115Driver({
+    access_token: "a",
+    refresh_token: "r",
+  } as any)
+  const before = fetchCalls
+  await assert.rejects(
+    () => driver.put("/115", "/115/a.bin", Buffer.from("abc")),
+    /未接线/,
+  )
+  assert.equal(fetchCalls, before)
+})
+
+// subrequestLimit 按 A-4 保持模块内私有，没有导出符号；这里断言它真正被读取的位置：
+// budget 是实例字段，构造时求值，所以同一个进程里两次构造就能覆盖两种运行时，
+// 不需要动态 import 规避 ESM 缓存。
+test("subrequestLimit：无 tjs 时预算 45，tjs 运行时 100000", () => {
+  const g = globalThis as any
+  const saved = g.tjs
+  try {
+    delete g.tjs
+    const nodeSide = new Pan115Driver({
+      access_token: "a",
+      refresh_token: "r",
+    } as any)
+    assert.equal((nodeSide as any).budget.limit, 45)
+    g.tjs = {}
+    const tjsSide = new Pan115Driver({
+      access_token: "a",
+      refresh_token: "r",
+    } as any)
+    assert.equal((tjsSide as any).budget.limit, 100000)
+  } finally {
+    if (saved === undefined) delete g.tjs
+    else g.tjs = saved
+  }
+})
