@@ -184,3 +184,35 @@ export async function appendFile(p: string, data: any): Promise<void> {
     await f.close()
   }
 }
+
+/**
+ * P2 C：分片上传收尾，把 parts 顺序追加到 dst（dst 是第一个分片，已存在）。
+ *
+ * 单独放 shim 的原因：26.9 的 FileHandle.write(buf, pos) 第二参数是文件内偏移，
+ * 而 Node 的 FileHandle 签名不同；这里只写 txiki 版本，调用方在 Node 下走
+ * readFile + appendFile 回退（单片 10MB 级别，Node 端不在意）。
+ * 峰值内存固定 64KB 一块，与文件总大小无关。
+ */
+export async function appendFromFiles(dst: string, parts: string[]): Promise<void> {
+  const CHUNK = 64 * 1024
+  const out = await tjs.open(dst, "a")
+  try {
+    for (const p of parts) {
+      const fh = await tjs.open(p, "r")
+      try {
+        let off = 0
+        for (;;) {
+          const buf = new Uint8Array(CHUNK)
+          const n = await fh.read(buf, off)
+          if (n === null || n === undefined || n === 0) break
+          await out.write(n === buf.length ? buf : buf.subarray(0, n))
+          off += n
+        }
+      } finally {
+        await fh.close()
+      }
+    }
+  } finally {
+    await out.close()
+  }
+}
