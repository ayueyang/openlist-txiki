@@ -0,0 +1,259 @@
+// SPEC p2-79（补丁 86）：weiyun 落盘暂存 + 分片上传单元测试。
+// mock globalThis.fetch 与 globalThis.tjs：不连网、不需要真实微云账号。
+import assert from "node:assert/strict"
+import { afterEach, beforeEach, test } from "node:test"
+import * as fsp from "node:fs/promises"
+import { mkdtemp, readdir, rm } from "node:fs/promises"
+import { tmpdir } from "node:os"
+import { join } from "node:path"
+
+import { WeiyunDriver } from "./driver"
+import { WeiyunClient } from "./util"
+
+const MB = 1024 * 1024
+const realFetch = globalThis.fetch
+const realTjs = (globalThis as any).tjs
+
+interface FetchCall {
+  url: string
+  body: any
+}
+interface UploadRec {
+  bytes: Uint8Array
+}
+
+let calls: FetchCall[] = []
+let spoolDir = ""
+let readLens: number[] = []
+let uploads: UploadRec[] = []
+let uploadFailAt = -1
+let uploadCount = 0
+let hashReadCount = -1
+let preData: any = {}
+let fileExist = false
+
+function jsonResponse(body: any): any {
+  const text = JSON.stringify(body)
+  return {
+    ok: true,
+    status: 200,
+    headers: { get: () => "application/json", getSetCookie: () => [] },
+    text: async () => text,
+    json: async () => JSON.parse(text),
+  }
+}
+
+function errResponse(status: number): any {
+  return {
+    ok: false,
+    status,
+    headers: { get: () => "text/plain", getSetCookie: () => [] },
+    text: async () => "boom",
+    json: async () => ({}),
+  }
+}
+
+/** 从 weiyun upload 的 multipart 请求体里取出文件段。 */
+function extractFilePart(body: Uint8Array): Uint8Array {
+  const text = Buffer.from(body.subarray(0, Math.min(body.length, 2048))).toString("latin1")
+  const marker = 'name="upload"; filename="blob"'
+  const mi = text.indexOf(marker)
+  assert.ok(mi >= 0, "multipart 里没有 upload 文件段")
+  const sep = text.indexOf("\r\n\r\n", mi)
+  assert.ok(sep >= 0)
+  const start = sep + 4
+  const endMarker = Buffer.from("\r\n------WebKitFormBoundaryIifrOqiswelC8nfe--\r\n", "latin1")
+  const ei = Buffer.from(body).indexOf(endMarker, start)
+  assert.ok(ei >= 0, "multipart 尾部标记缺失")
+  return body.subarray(start, ei)
+}
+
+function makeDriver(): WeiyunDriver {
+  const d = new WeiyunDriver({ cookies: "wyctoken=t" } as any)
+  ;(d as any).resolveFolder = async () => ({ pdirKey: "pdir", dirKey: "dir" })
+  return d
+}
+
+beforeEach(async () => {
+  calls = []
+  readLens = []
+  uploads = []
+  uploadFailAt = -1
+  uploadCount = 0
+  hashReadCount = -1
+  fileExist = false
+  preData = {
+    file_exist: false,
+    upload_key: "k",
+    ex: "e",
+    channel_list: [{ id: 0, offset: 0, len: 4 * MB }],
+  }
+  spoolDir = await mkdtemp(join(tmpdir(), "weiyun-p86-"))
+  ;(globalThis as any).tjs = {
+    env: { UPLOAD_SPOOL_DIR: spoolDir },
+    statFs: async () => ({ bsize: 4096, bavail: 1024 * 1024 }),
+    open: async (p: string, mode: "r" | "w") => {
+      const fh = await fsp.open(p, mode)
+      return {
+        write: async (chunk: Uint8Array) => (await fh.write(chunk)).bytesWritten,
+        read: async (buf: Uint8Array, position: number) => {
+          readLens.push(buf.byteLength)
+          const r = await fh.read(buf, 0, buf.byteLength, position)
+          return r.bytesRead
+        },
+        close: async () => fh.close(),
+      }
+    },
+  }
+  globalThis.fetch = (async (input: any, init?: any) => {
+    const url = String(input)
+    calls.push({ url, body: init?.body })
+    if (url.includes("ftn_pre_upload")) {
+      return jsonResponse({
+        ret: 0,
+        data: {
+          rsp_body: {
+            RspMsg_body: {
+              weiyunPreUploadMsgRsp_body: {
+                ...preData,
+                file_exist: fileExist || preData.file_exist,
+              },
+            },
+          },
+        },
+      })
+    }
+    if (url.includes("ftnup_v2")) {
+      if (hashReadCount < 0) hashReadCount = readLens.length
+      const idx = uploadCount++
+      if (idx === uploadFailAt) return errResponse(500)
+      uploads.push({ bytes: extractFilePart(new Uint8Array(init.body)) })
+      return jsonResponse({
+        ret: 0,
+        data: {
+          rsp_body: {
+            RspMsg_body: {
+              "weiyun.UploadPieceMsgRsp_body": { upload_state: 1 },
+            },
+          },
+        },
+      })
+    }
+    throw new Error("unexpected fetch: " + url)
+  }) as any
+})
+
+afterEach(async () => {
+  globalThis.fetch = realFetch
+  ;(globalThis as any).tjs = realTjs
+  await rm(spoolDir, { recursive: true, force: true })
+})
+
+test("1 preUpload 块表：reader 路径与 content 路径逐项相同、offset/长度符合 1MiB 约定", async () => {
+  const client = new WeiyunClient({ cookies: "" } as any)
+  const size = 6.5 * MB
+  const src = new Uint8Array(size)
+  for (let i = 0; i < size; i++) src[i] = (i * 13 + 5) & 0xff
+
+  const seen: Array<[number, number]> = []
+  const reader = async (offset: number, len: number) => {
+    seen.push([offset, len])
+    return src.subarray(offset, offset + len)
+  }
+
+  await client.preUpload("pdir", "dir", "a.bin", size, src, 4, 1)
+  const bodyContent = calls[calls.length - 1].body as string
+  await client.preUpload("pdir", "dir", "a.bin", size, new Uint8Array(0), 4, 1, reader)
+  const bodyReader = calls[calls.length - 1].body as string
+
+  const pick = (s: string) =>
+    JSON.parse(s).req_body.ReqMsg_body["weiyun.PreUploadMsgReq_body"]
+  const a = pick(bodyContent)
+  const b = pick(bodyReader)
+  assert.deepEqual(b.block_info_list, a.block_info_list)
+  assert.deepEqual(b.block_info_list.map((x: any) => x.size), [MB, MB, MB, MB, MB, MB, 0.5 * MB])
+  assert.equal(b.check_sha, a.check_sha)
+  assert.equal(b.check_data, a.check_data)
+
+  assert.deepEqual(
+    seen.map(([o, l]) => [o, l]),
+    [
+      [0, MB],
+      [MB, MB],
+      [2 * MB, MB],
+      [3 * MB, MB],
+      [4 * MB, MB],
+      [5 * MB, MB],
+      [6 * MB, 0.5 * MB],
+    ],
+  )
+})
+
+test("2/5 6.5MiB 三通道：片长 <=1MiB、拼起来等于源、读块 <=1MiB", async () => {
+  preData = {
+    file_exist: false,
+    upload_key: "k",
+    ex: "e",
+    channel_list: [
+      { id: 0, offset: 0, len: 4 * MB },
+      { id: 1, offset: 4 * MB, len: 2 * MB },
+      { id: 2, offset: 6 * MB, len: 0.5 * MB },
+    ],
+  }
+  const d = makeDriver()
+  const size = 6.5 * MB
+  const src = new Uint8Array(size)
+  for (let i = 0; i < size; i++) src[i] = (i * 29 + 11) & 0xff
+  const w = await (d as any).beginStream("docs/a.bin", size)
+  await w.write(src)
+  await w.commit()
+
+  assert.equal(uploads.length, 7, "4+2+0.5MiB 按 1MiB 切片")
+  assert.ok(uploads.every((u) => u.bytes.length <= MB))
+  const joined = new Uint8Array(size)
+  let off = 0
+  for (const u of uploads) {
+    joined.set(u.bytes, off)
+    off += u.bytes.length
+  }
+  assert.equal(off, size)
+  assert.deepEqual(joined, src)
+
+  assert.ok(Math.max(...readLens) <= MB)
+  // 首次上传 fetch 之前的那一次 readAt 属于第一片上传数据，其余是哈希阶段。
+  assert.equal(hashReadCount - 1, Math.ceil(size / MB), "哈希阶段按 1MiB 读块")
+  assert.ok(!readLens.includes(size), "不得出现整文件大小的读")
+  assert.deepEqual(await readdir(spoolDir), [])
+})
+
+test("3 秒传：file_exist=true 不发片、spool 已删", async () => {
+  fileExist = true
+  const d = makeDriver()
+  const w = await (d as any).beginStream("docs/a.bin", 2 * MB)
+  await w.write(new Uint8Array(2 * MB))
+  await w.commit()
+  assert.equal(uploads.length, 0)
+  assert.deepEqual(await readdir(spoolDir), [])
+})
+
+test("4 失败：第 2 片抛错、上抛、spool 已删、后续片不再发", async () => {
+  uploadFailAt = 1
+  const d = makeDriver()
+  const w = await (d as any).beginStream("docs/a.bin", 6.5 * MB)
+  await w.write(new Uint8Array(6.5 * MB))
+  await assert.rejects(() => w.commit(), /HTTP 500/)
+  assert.equal(uploadCount, 2)
+  assert.equal(uploads.length, 1)
+  assert.deepEqual(await readdir(spoolDir), [])
+})
+
+test("6 put 兼容路径：2MiB 走同一实现、字节一致", async () => {
+  const d = makeDriver()
+  const src = new Uint8Array(2 * MB)
+  for (let i = 0; i < src.length; i++) src[i] = (i * 3 + 2) & 0xff
+  await d.put("/docs/a.bin", "docs/a.bin", Buffer.from(src))
+  assert.equal(uploads.length, 2)
+  assert.deepEqual(uploads[0].bytes, src.subarray(0, MB))
+  assert.deepEqual(uploads[1].bytes, src.subarray(MB))
+  assert.deepEqual(await readdir(spoolDir), [])
+})
