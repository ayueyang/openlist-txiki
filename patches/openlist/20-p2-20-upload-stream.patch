+/**
+ * P1-17 A 层：为一次上传准备目标（SPEC-P117 §3.2）。
+ *
+ * 驱动实现 beginStream 时真流式（Local）：数据边收边写临时文件，峰值与文件
+ * 大小无关。否则缓冲回退：write() 只收集块，commit() 合并后走 driver.put，
+ * 内存 = payload（受上传上限约束，SPEC §3.8 的已知限制，不在 P1-17 门内）。
+ *
+ * 收尾必须复用 putItem 的两步（flushPendingDriverState + invalidatePaths），
+ * 否则上传后直链与目录缓存不失效，属回归。
+ */
+export async function beginUpload(
+  virtualPath: string,
+  requestContext?: StorageRequestContext,
+): Promise<UploadTarget> {
+  const resolved = await resolvePath(virtualPath, requestContext?.env)
+  if (resolved.isVirtual) {
+    throw new Error("failed get storage: storage not found")
+  }
+  const driver = await getDriver(resolved.storage!.driver, resolved.storage)
+  const finish = async () => {
+    await flushPendingDriverState(
+      resolved.storage!.driver,
+      resolved.storage,
+      driver,
+      requestContext,
+    )
+    await invalidatePaths([virtualPath], requestContext?.env)
+  }
+  // 能力探测用结构化判断（与 fs.ts 判 createUploadSession 同一写法），
+  // 不改 StorageDriver 接口，避免动 base.ts 和 100 多个驱动。
+  const beginStream = (driver as any).beginStream
+  if (typeof beginStream === "function") {
+    const handle = await beginStream.call(driver, resolved.physical!)
+    let settled = false
+    return {
+      stream: true,
+      write: (chunk: Uint8Array) => handle.write(chunk),
+      commit: async () => {
+        if (settled) return
+        settled = true
+        await handle.commit()
+        await finish()
+      },
+      abort: async () => {
+        if (settled) return
+        settled = true
+        try {
+          await handle.abort()
+        } catch {}
+      },
+    }
+  }
+  const parts: Uint8Array[] = []
+  let settled = false
+  return {
+    stream: false,
+    write: async (chunk: Uint8Array) => {
+      parts.push(chunk)
+    },
+    commit: async () => {
+      if (settled) return
+      settled = true
+      const buffer = Buffer.concat(parts)
+      parts.length = 0
+      await driver.put(virtualPath, resolved.physical!, buffer)
+      await finish()
+    },
+    abort: async () => {
+      settled = true
+      parts.length = 0
+    },
+  }
+}
