--- /dev/null
+++ b/src/backend/pkg/upload-stream.ts
@@ -0,0 +1,162 @@
+/**
+ * P1-17 A 层：上传请求体的流式读写（SPEC-P117 §3.1）。
+ *
+ * 上传路径一次都不碰 `c.req.arrayBuffer()`：只从 `c.req.raw.body` 拿
+ * ReadableStream，一次读一块、写一块、计一次数。峰值因此与 payload 脱钩。
+ *
+ * drain 不是优化：txiki 的 httpserver.js onBodyChunk 是无背压的 enqueue，
+ * 请求体一旦开始流式，没人读的时候块会全堆在 JS 队列里。拒绝路径必须把
+ * 剩余 body 读完丢弃，否则「413 了但内存照样吃满」，与修复前等价。
+ */
+
+export interface UploadTarget {
+  /** 驱动是否真流式（false=缓冲回退，内存与 payload 同阶） */
+  stream: boolean
+  write(chunk: Uint8Array): Promise<void>
+  /** 成功：落盘 + 缓存失效 */
+  commit(): Promise<void>
+  /** 失败：清临时文件/目录，幂等 */
+  abort(): Promise<void>
+}
+
+export type PipeResult =
+  | { ok: true; bytes: number }
+  | {
+      ok: false
+      limit: number
+      received: number
+      reason: "content-length" | "counted"
+    }
+
+/** Content-Length 头；缺失/非数字返回 null（缺失不能当 0 参与判断）。 */
+export function contentLengthOf(c: any): number | null {
+  let raw: any
+  try {
+    raw = c?.req?.header?.("Content-Length")
+  } catch {}
+  if (raw === undefined || raw === null) {
+    try {
+      raw = c?.req?.raw?.headers?.get?.("content-length")
+    } catch {}
+  }
+  if (raw === undefined || raw === null) return null
+  const s = String(raw).trim()
+  if (!s) return null
+  const n = Number(s)
+  if (!Number.isFinite(n) || n < 0) return null
+  return Math.floor(n)
+}
+
+async function drainReader(reader: any, deadlineMs: number): Promise<void> {
+  let timer: any = null
+  if (deadlineMs > 0) {
+    timer = setTimeout(() => {
+      try {
+        void reader.cancel()
+      } catch {}
+    }, deadlineMs)
+    try {
+      timer?.unref?.()
+    } catch {}
+  }
+  try {
+    for (;;) {
+      const { done } = await reader.read()
+      if (done) break
+    }
+  } catch {
+    // 客户端断连、流已被取消：body 不可读，drain 到此为止
+  } finally {
+    if (timer !== null) {
+      try {
+        clearTimeout(timer)
+      } catch {}
+    }
+  }
+}
+
+/** 把请求体读完丢弃，默认 60 s 硬超时后 cancel（慢客户端不许吊住连接）。 */
+export async function drainRequestBody(
+  req: Request,
+  deadlineMs = 60000,
+): Promise<void> {
+  const anyReq = req as any
+  const body = anyReq?.body
+  if (!body || anyReq.bodyUsed) return
+  let reader: any
+  try {
+    reader = body.getReader()
+  } catch {
+    return
+  }
+  await drainReader(reader, deadlineMs)
+}
+
+export async function drainBody(c: any, deadlineMs = 60000): Promise<void> {
+  const req = c?.req?.raw
+  if (!req) return
+  await drainRequestBody(req, deadlineMs)
+}
+
+/**
+ * 逐块读 body、逐块写 target、逐块计数。
+ *
+ * 顺序是判据的一部分：
+ * 1) 声明长度超限：不读 body，只 drain；
+ * 2) 无 body（Content-Length: 0）：直接 commit；
+ * 3) 边读边超限：先 abort，再把剩余块读完丢弃（drain），最后才返回；
+ * 4) 正常结束：commit；
+ * 5) 任何异常：abort 后原样抛出（交给 writeFailure / sourceStep 映射）。
+ *
+ * 调用方必须在建 target 之前做一次 CL 预检（SPEC §3.7 第 1 条：超限请求连
+ * 临时目录都不该建）；这里的同一条判断是幂等兜底，防别的调用点漏了预检。
+ */
+export async function pipeBody(
+  c: any,
+  limit: number,
+  target: UploadTarget,
+): Promise<PipeResult> {
+  const cl = contentLengthOf(c)
+  if (cl !== null && cl > limit) {
+    await target.abort()
+    await drainBody(c)
+    return { ok: false, limit, received: cl, reason: "content-length" }
+  }
+
+  const body: any = c?.req?.raw?.body
+  if (!body) {
+    await target.commit()
+    return { ok: true, bytes: 0 }
+  }
+
+  const reader = body.getReader()
+  let received = 0
+  let overflow = false
+  try {
+    for (;;) {
+      const { done, value } = await reader.read()
+      if (done) break
+      if (!value) continue
+      received += value.byteLength
+      if (received > limit) {
+        overflow = true
+        await target.abort()
+        break
+      }
+      await target.write(value)
+    }
+    if (overflow) {
+      await drainReader(reader, 60000)
+      return { ok: false, limit, received, reason: "counted" }
+    }
+  } catch (e) {
+    try {
+      await target.abort()
+    } catch {}
+    // 写盘失败时客户端可能还在发：先 drain 再抛，避免剩余块堆在 JS 队列里
+    await drainReader(reader, 60000)
+    throw e
+  }
+  await target.commit()
+  return { ok: true, bytes: received }
+}
