@@ -282,6 +289,50 @@ export class Onedrive implements StorageDriver {
     await requestApi(this, url, "POST", data)
   }
 
+  /**
+   * P2-74：单个分片 PUT 的响应判定与 5xx 退避（A util.go:204-258）。
+   * 只有 2xx 才返回；500..504 每片最多重试 3 次（2s/4s/8s）；
+   * 其他非 2xx 立即失败——失败分片绝不能被当成成功跳过。
+   */
+  private async putChunkWithRetry(
+    uploadUrl: string,
+    chunk: Buffer,
+    start: number,
+    total: number,
+    sleepFn: (ms: number) => Promise<void> = this.sleepFn,
+  ): Promise<void> {
+    const byteSize = chunk.length
+    const contentRange = `bytes ${start}-${start + byteSize - 1}/${total}`
+    let retryCount = 0
+    for (;;) {
+      const res = await fetch(uploadUrl, {
+        method: "PUT",
+        headers: {
+          "Content-Length": String(byteSize),
+          "Content-Range": contentRange,
+        },
+        body: chunk as any,
+      })
+      if (res.ok) {
+        // 成功分片体不需要内容；显式取消，避免占用连接池。
+        try {
+          await res.body?.cancel()
+        } catch {}
+        return
+      }
+      const status = res.status
+      const body = (await res.text().catch(() => "")).slice(0, 300)
+      if (status >= 500 && status <= 504 && retryCount < 3) {
+        retryCount++
+        await sleepFn(1000 * (1 << retryCount))
+        continue
+      }
+      throw new Error(
+        `[OneDrive] chunk upload failed: HTTP ${status} ${body} (bytes ${start}-${start + byteSize - 1}/${total})`,
+      )
+    }
+  }
+
   async put(
     virtualPath: string,
     physicalPath: string,
