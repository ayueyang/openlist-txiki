+import assert from "node:assert/strict"
+import { test } from "node:test"
+
+import { assertStorageEndpointSafe, collectEndpointUrls } from "./ssrf-endpoint"
+import { SsrfTargetBlockedError } from "./errs"
+
+test("p2-85 私网目标抛 SsrfTargetBlockedError，文案含 SSRF protection", () => {
+  assert.throws(
+    () => assertStorageEndpointSafe({ address: "http://10.255.255.1/x" }),
+    (e: any) => {
+      assert.ok(e instanceof SsrfTargetBlockedError, "错误类型")
+      assert.match(e.message, /SSRF protection/)
+      return true
+    },
+  )
+})
+
+test("p2-85 公网目标放行", () => {
+  assert.doesNotThrow(() =>
+    assertStorageEndpointSafe({ address: "https://dav.example.com/x" }),
+  )
+})
+
+test("p2-85 放行只认显式 allow：10.255.255.1 放行，只给 127.0.0.1 时仍拒绝", () => {
+  assert.doesNotThrow(() =>
+    assertStorageEndpointSafe(
+      { address: "http://10.255.255.1/x" },
+      { SSRF_ALLOWED_HOSTS: "10.255.255.1" },
+    ),
+  )
+  assert.throws(
+    () =>
+      assertStorageEndpointSafe(
+        { address: "http://10.255.255.1/x" },
+        { SSRF_ALLOWED_HOSTS: "127.0.0.1" },
+      ),
+    SsrfTargetBlockedError,
+  )
+})
+
+test("p2-85 裸 host:port 与 JSON 字符串 addition 都能识别", () => {
+  assert.deepEqual(collectEndpointUrls({ address: "192.168.1.10:9000" }), [
+    "http://192.168.1.10:9000",
+  ])
+  assert.throws(
+    () => assertStorageEndpointSafe('{"address":"192.168.1.10:9000"}'),
+    SsrfTargetBlockedError,
+  )
+})
+
+test("p2-85 本地路径与空串不产生候选、不抛错", () => {
+  for (const addition of [
+    { address: "/mnt/usb" },
+    { address: "/loopA/sub" },
+    { address: "" },
+    {},
+    null,
+  ]) {
+    assert.deepEqual(collectEndpointUrls(addition), [])
+    assert.doesNotThrow(() => assertStorageEndpointSafe(addition))
+  }
+})
