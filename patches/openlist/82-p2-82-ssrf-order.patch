@@ -0,0 +1,84 @@
+/**
+ * 存储 endpoint 的 SSRF 前置判定（r65 补丁 82，计划条目 p2-85）。
+ *
+ * 背景：部分驱动（如 webdav）的 get() 内部会先向 addition.address 连网，
+ * 守卫若只挂在 driver.get 返回 raw_url 之后的代理层，请求会先挂到超时。
+ * 因此读路径必须在调用驱动之前按 addition 的字面量判定。
+ *
+ * 约束（判据 S1-C5/S1-C6）：
+ * - 白名单只认显式环境变量 SSRF_ALLOWED_HOSTS（精确 host），不采用由
+ *   addition 自动推导的受信 host —— 后者会让任何管理员配置的私网 endpoint
+ *   无条件通过，正是 S1-C5 的反例。
+ * - 纯函数：不联网、不做 DNS、不读请求头、不读 site_url。
+ */
+import { assertSafeUrl, hostFromValue, parseAllowHostsEnv } from "./http"
+import { SsrfTargetBlockedError } from "./errs"
+
+const HOST_KEY_RE =
+  /(url|host|address|endpoint|server|domain|site|base|gateway|api)/i
+
+/**
+ * 单个字段值 → 绝对 URL；不是 endpoint 形态时返回 undefined。
+ *
+ * hostFromValue 对 "/mnt/usb" 会给 host="mnt"（WHATWG URL 把首段当 authority），
+ * 本地路径不是 endpoint，这里先按形态排除，避免把挂载路径误判成主机。
+ */
+function endpointUrlOf(value: string): string | undefined {
+  const trimmed = value.trim()
+  if (!trimmed) return undefined
+  if (trimmed.startsWith("/") || trimmed.startsWith("./")) return undefined
+  if (/^[A-Za-z]:[\\/]/.test(trimmed)) return undefined
+  if (!hostFromValue(trimmed)) return undefined
+  return /^[a-z][a-z0-9+.-]*:\/\//i.test(trimmed)
+    ? trimmed
+    : `http://${trimmed}`
+}
+
+function walk(node: any, out: string[]): void {
+  if (node == null || typeof node !== "object") return
+  for (const [key, val] of Object.entries(node)) {
+    if (typeof val === "string") {
+      if (!HOST_KEY_RE.test(key)) continue
+      const url = endpointUrlOf(val)
+      if (url) out.push(url)
+    } else if (val != null && typeof val === "object") {
+      walk(val, out)
+    }
+  }
+}
+
+/** 汇总 addition 里所有可解析成 host 的候选 URL（去重，保持首次出现顺序）。 */
+export function collectEndpointUrls(addition: any): string[] {
+  if (addition == null) return []
+  let obj = addition
+  if (typeof addition === "string") {
+    try {
+      obj = JSON.parse(addition)
+    } catch {
+      return []
+    }
+  }
+  if (typeof obj !== "object" || obj === null) return []
+  const out: string[] = []
+  walk(obj, out)
+  return Array.from(new Set(out))
+}
+
+/**
+ * 读路径前置守卫：任一候选 URL 命中私网/环回/元数据地址即抛
+ * SsrfTargetBlockedError（403）。没有候选时直接返回，不改动无法识别
+ * endpoint 的驱动行为。
+ */
+export function assertStorageEndpointSafe(addition: any, env?: any): void {
+  const urls = collectEndpointUrls(addition)
+  if (urls.length === 0) return
+  const raw = env?.["SSRF_ALLOWED_HOSTS"]
+  const allow = parseAllowHostsEnv(typeof raw === "string" ? raw : "")
+  for (const url of urls) {
+    try {
+      assertSafeUrl(url, "SSRF protection", allow)
+    } catch (e: any) {
+      throw new SsrfTargetBlockedError(String(e?.message || e))
+    }
+  }
+}
