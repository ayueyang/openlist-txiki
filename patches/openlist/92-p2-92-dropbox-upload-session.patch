index eae3c2b..69b8bf6 100755
--- a/src/backend/internal/upload/spool.ts
+++ b/src/backend/internal/upload/spool.ts
@@ -156,3 +156,53 @@ export function randomHex(bytes: number): string {
     .map((x) => x.toString(16).padStart(2, "0"))
     .join("")
 }
+
+
+/** 按 position 读满 buf；readAt 返回 0 视为提前结束。 */
+export async function readSpoolExact(
+  handle: SpoolHandle,
+  buf: Uint8Array,
+  position: number,
+  label: string,
+): Promise<void> {
+  let got = 0
+  while (got < buf.byteLength) {
+    const n = await handle.readAt(buf.subarray(got), position + got)
+    if (!(n > 0)) throw new Error(`${label} spool 读取提前结束`)
+    got += n
+  }
+}
+
+/**
+ * 从 spool 读句柄建出站流：pull 驱动、chunkSize 一块、读到 size 就 close。
+ * 一块读不满时继续读，readAt 返回 0 抛错（不静默截断）。
+ */
+export function spoolReadStream(
+  handle: SpoolHandle,
+  size: number,
+  label: string,
+  chunkSize = 64 * 1024,
+): ReadableStream<Uint8Array> {
+  let pos = 0
+  return new ReadableStream<Uint8Array>({
+    pull: async (controller) => {
+      if (pos >= size) {
+        controller.close()
+        return
+      }
+      const want = Math.min(chunkSize, size - pos)
+      const buf = new Uint8Array(want)
+      let got = 0
+      while (got < want) {
+        const n = await handle.readAt(buf.subarray(got), pos + got)
+        if (!(n > 0)) {
+          controller.error(new Error(`${label} spool 读取提前结束`))
+          return
+        }
+        got += n
+      }
+      pos += want
+      controller.enqueue(buf)
+    },
+  })
+}
