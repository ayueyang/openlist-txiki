+// SPEC p2-92（补丁 92）：Dropbox upload_session 与落盘暂存单元测试。
+// mock globalThis.fetch 与 globalThis.tjs：不连网、不需要真实 Dropbox 账号。
+import assert from "node:assert/strict"
+import { afterEach, beforeEach, test } from "node:test"
+import * as fsp from "node:fs/promises"
+import { mkdtemp, readdir, rm } from "node:fs/promises"
+import { tmpdir } from "node:os"
+import { join } from "node:path"
+
+import { DropboxDriver } from "./driver"
+
+const MB = 1024 * 1024
+const PART = 20 * MB
+const realFetch = globalThis.fetch
+const realTjs = (globalThis as any).tjs
+
+interface Call {
+  url: string
+  method: string
+  headers: Record<string, string>
+  body: any
+}
+
+let calls: Call[] = []
+let spoolDir = ""
+let appendFailAt = -1
+let append401At = -1
+let refreshCount = 0
+let appendCalls: Array<{ offset: number; bytes: Uint8Array }> = []
+let uploadBodies: any[] = []
+
+function jsonResponse(body: any): any {
+  const text = JSON.stringify(body)
+  return {
+    ok: true,
+    status: 200,
+    headers: { get: () => "application/json" },
+    text: async () => text,
+    json: async () => JSON.parse(text),
+  }
+}
+
+function errResponse(status: number, text: string): any {
+  return {
+    ok: false,
+    status,
+    headers: { get: () => "text/plain" },
+    text: async () => text,
+    json: async () => ({}),
+  }
+}
+
+function apiArg(c: Call): any {
+  return JSON.parse(c.headers["Dropbox-API-Arg"])
+}
+
+function makeDriver(): DropboxDriver {
+  return new DropboxDriver({ access_token: "t0", refresh_token: "r0" } as any)
+}
+
+function countUrl(part: string): number {
+  return calls.filter((c) => c.url.includes(part)).length
+}
+
+beforeEach(async () => {
+  calls = []
+  appendFailAt = -1
+  append401At = -1
+  refreshCount = 0
+  appendCalls = []
+  uploadBodies = []
+  spoolDir = await mkdtemp(join(tmpdir(), "dropbox-p92-"))
+  ;(globalThis as any).tjs = {
+    env: { UPLOAD_SPOOL_DIR: spoolDir },
+    statFs: async () => ({ bsize: 4096, bavail: 1024 * 1024 }),
+    open: async (p: string, mode: "r" | "w") => {
+      const fh = await fsp.open(p, mode)
+      return {
+        write: async (chunk: Uint8Array) => (await fh.write(chunk)).bytesWritten,
+        read: async (buf: Uint8Array, position: number) => {
+          const r = await fh.read(buf, 0, buf.byteLength, position)
+          return r.bytesRead
+        },
+        close: async () => fh.close(),
+      }
+    },
+  }
+  globalThis.fetch = (async (input: any, init?: any) => {
+    const url = String(input)
+    const method = String(init?.method || "POST").toUpperCase()
+    const headers = (init?.headers || {}) as Record<string, string>
+    const call: Call = { url, method, headers, body: init?.body }
+    calls.push(call)
+    if (url.includes("/oauth2/token")) {
+      refreshCount++
+      return jsonResponse({ access_token: "t1", refresh_token: "r1" })
+    }
+    if (url.includes("/2/files/upload_session/start")) {
+      return jsonResponse({ session_id: "s1" })
+    }
+    if (url.includes("/2/files/upload_session/append_v2")) {
+      const arg = apiArg(call)
+      const idx = appendCalls.length
+      appendCalls.push({ offset: arg.cursor.offset, bytes: new Uint8Array(init.body) })
+      if (idx === appendFailAt) return errResponse(413, "payload too large")
+      if (idx === append401At) return errResponse(401, "expired_access_token")
+      return jsonResponse({})
+    }
+    if (url.includes("/2/files/upload_session/finish")) {
+      return jsonResponse({ name: "a.bin" })
+    }
+    if (url.endsWith("/2/files/upload")) {
+      uploadBodies.push(init?.body)
+      return jsonResponse({ name: "a.bin" })
+    }
+    throw new Error("unexpected fetch: " + url)
+  }) as any
+})
+
+afterEach(async () => {
+  globalThis.fetch = realFetch
+  ;(globalThis as any).tjs = realTjs
+  await rm(spoolDir, { recursive: true, force: true })
+})
+
+test("1 beginStream 存在", () => {
+  assert.equal(typeof (makeDriver() as any).beginStream, "function")
+})
+
+test("2 25MiB：start 1 + append 2 + finish 1，分片 20MiB，字节一致", async () => {
+  const size = 25 * MB
+  const src = new Uint8Array(size)
+  for (let i = 0; i < size; i++) src[i] = (i * 31 + 7) & 0xff
+  const d = makeDriver()
+  const w = await (d as any).beginStream("/docs/a.bin", size)
+  await w.write(src)
+  await w.commit()
+
+  assert.equal(countUrl("/upload_session/start"), 1)
+  assert.equal(appendCalls.length, 2)
+  assert.equal(countUrl("/upload_session/finish"), 1)
+  assert.deepEqual(
+    appendCalls.map((a) => a.offset),
+    [0, PART],
+  )
+  assert.equal(Math.max(...appendCalls.map((a) => a.bytes.byteLength)), PART)
+  const joined = Buffer.concat(appendCalls.map((a) => Buffer.from(a.bytes)))
+  assert.equal(joined.byteLength, size)
+  assert.deepEqual(new Uint8Array(joined), src)
+
+  const fin = calls.find((c) => c.url.includes("/upload_session/finish"))!
+  const arg = apiArg(fin)
+  assert.equal(arg.commit.path, "/docs/a.bin")
+  assert.equal(arg.commit.mode, "overwrite")
+  assert.equal(arg.cursor.offset, size)
+  assert.deepEqual(await readdir(spoolDir), [])
+})
+
+test("3 0 字节：只发 /2/files/upload 一次，空 body，不进 session", async () => {
+  const d = makeDriver()
+  const w = await (d as any).beginStream("/docs/empty.bin", 0)
+  await w.commit()
+  assert.equal(uploadBodies.length, 1)
+  assert.equal(uploadBodies[0].byteLength, 0)
+  assert.equal(countUrl("/upload_session/"), 0)
+  assert.deepEqual(await readdir(spoolDir), [])
+})
+
+test("4 首个 append 401：refreshToken 1 次、append 请求 3 次、finish 成功", async () => {
+  append401At = 0
+  const size = 25 * MB
+  const d = makeDriver()
+  const w = await (d as any).beginStream("/docs/a.bin", size)
+  await w.write(new Uint8Array(size))
+  await w.commit()
+  assert.equal(refreshCount, 1)
+  assert.equal(countUrl("/upload_session/append_v2"), 3)
+  assert.equal(appendCalls.length, 3)
+  assert.equal(countUrl("/upload_session/finish"), 1)
+  assert.deepEqual(await readdir(spoolDir), [])
+})
+
+test("5 append 413：commit 抛错含 413，finish 0 次，spool 已清", async () => {
+  appendFailAt = 0
+  const d = makeDriver()
+  const w = await (d as any).beginStream("/docs/a.bin", 25 * MB)
+  await w.write(new Uint8Array(25 * MB))
+  await assert.rejects(() => w.commit(), /413/)
+  assert.equal(countUrl("/upload_session/finish"), 0)
+  assert.deepEqual(await readdir(spoolDir), [])
+})
+
+test("6 声明长度 10 写 11：write 抛错，fetch 0 次，spool 已清", async () => {
+  const d = makeDriver()
+  const w = await (d as any).beginStream("/docs/a.bin", 10)
+  await assert.rejects(() => w.write(new Uint8Array(11)), /dropbox 上传声明长度与实际不符/)
+  assert.equal(calls.length, 0)
+  assert.deepEqual(await readdir(spoolDir), [])
+})
+
+test("7 abort：fetch 0 次，spool 已清", async () => {
+  const d = makeDriver()
+  const w = await (d as any).beginStream("/docs/a.bin", 1024)
+  await w.write(new Uint8Array(1024))
+  await w.abort()
+  assert.equal(calls.length, 0)
+  assert.deepEqual(await readdir(spoolDir), [])
+})
