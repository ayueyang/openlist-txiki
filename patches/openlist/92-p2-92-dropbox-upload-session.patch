+// SPEC p2-92（补丁 92）：spool 通用读函数单元测试。
+// 只覆盖 readSpoolExact / spoolReadStream：不连网、不碰真实 spool 目录。
+import assert from "node:assert/strict"
+import { test } from "node:test"
+
+import * as spool from "./spool"
+
+interface FakeHandle {
+  readAt(buf: Uint8Array, position: number): Promise<number>
+}
+
+/** 假读句柄：plan 限定每次 readAt 最多回多少字节，缺省整块。 */
+function fakeHandle(data: Uint8Array, plan?: number[]): FakeHandle {
+  let calls = 0
+  return {
+    async readAt(buf: Uint8Array, position: number) {
+      const room = plan ? plan[Math.min(calls, plan.length - 1)] : buf.byteLength
+      calls++
+      const want = Math.min(buf.byteLength, room, Math.max(0, data.byteLength - position))
+      buf.set(data.subarray(position, position + want), 0)
+      return want
+    },
+  }
+}
+
+test("R1 readSpoolExact 以多段读填满缓冲", async () => {
+  assert.equal(typeof (spool as any).readSpoolExact, "function")
+  const src = Uint8Array.from({ length: 100 }, (_, i) => (i * 7) & 0xff)
+  const h = fakeHandle(src, [40, 30, 30])
+  const out = new Uint8Array(100)
+  await (spool as any).readSpoolExact(h, out, 0, "unit")
+  assert.deepEqual(out, src)
+})
+
+test("R2 readSpoolExact 提前 EOF 抛错", async () => {
+  const h = fakeHandle(new Uint8Array(10), [10])
+  const out = new Uint8Array(20)
+  await assert.rejects(
+    () => (spool as any).readSpoolExact(h, out, 0, "unit"),
+    /unit spool 读取提前结束/,
+  )
+})
+
+test("R3 spoolReadStream 分块读、拼回一致", async () => {
+  assert.equal(typeof (spool as any).spoolReadStream, "function")
+  const size = 150 * 1024 + 7
+  const src = new Uint8Array(size)
+  for (let i = 0; i < size; i++) src[i] = (i * 17 + 3) & 0xff
+  const h = fakeHandle(src)
+  const lens: number[] = []
+  const parts: Uint8Array[] = []
+  const reader = (spool as any).spoolReadStream(h, size, "unit").getReader()
+  for (;;) {
+    const { done, value } = await reader.read()
+    if (done) break
+    lens.push(value.byteLength)
+    parts.push(value)
+  }
+  assert.ok(Math.max(...lens) <= 64 * 1024, "读块 <= 64KiB")
+  assert.ok(Math.min(...lens) > 0)
+  const joined = Buffer.concat(parts.map((p) => Buffer.from(p)))
+  assert.equal(joined.byteLength, size)
+  assert.deepEqual(new Uint8Array(joined), src)
+})
