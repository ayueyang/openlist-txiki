+// SPEC p2-93（补丁 93）：迅雷 gcid 流式计算与落盘暂存单元测试。
+// mock globalThis.tjs 与 fetch、注入 client.authRequest：不连网、不需要真实迅雷账号。
+import assert from "node:assert/strict"
+import { afterEach, beforeEach, test } from "node:test"
+import * as fsp from "node:fs/promises"
+import { mkdtemp, readdir, rm } from "node:fs/promises"
+import { tmpdir } from "node:os"
+import { join } from "node:path"
+
+import { ThunderDriver } from "./driver"
+import { calcGcid } from "./util"
+import * as thunderUtil from "./util"
+
+const MB = 1024 * 1024
+const realFetch = globalThis.fetch
+const realTjs = (globalThis as any).tjs
+const realDigest = globalThis.crypto.subtle.digest
+
+let spoolDir = ""
+let readLens: number[] = []
+let readTotal = 0
+let digestCalls = 0
+let authCalls: Array<{ url: string; opts: any }> = []
+let putCalls: Array<{ url: string; headers: Record<string, string>; body: any; duplex?: string }> = []
+let putChunkLens: number[] = []
+let putBodyBytes = new Uint8Array(0)
+let putStatus = 200
+let authResp: any = null
+
+function makeSrc(size: number, seed = 13): Uint8Array {
+  const src = new Uint8Array(size)
+  for (let i = 0; i < size; i++) src[i] = (i * seed + 5) & 0xff
+  return src
+}
+
+function makeDriver(): ThunderDriver {
+  const d = new ThunderDriver({ username: "u", password: "p", root_folder_id: "root" } as any)
+  ;(d as any).client = {
+    authRequest: async (url: string, opts: any) => {
+      authCalls.push({ url, opts })
+      return authResp
+    },
+  }
+  return d
+}
+
+beforeEach(async () => {
+  readLens = []
+  readTotal = 0
+  digestCalls = 0
+  authCalls = []
+  putCalls = []
+  putChunkLens = []
+  putBodyBytes = new Uint8Array(0)
+  putStatus = 200
+  authResp = {
+    upload_type: "UPLOAD_TYPE_RESUMABLE",
+    resumable: {
+      params: { endpoint: "up.example.com", bucket: "bkt", key: "k", security_token: "tok" },
+    },
+  }
+  spoolDir = await mkdtemp(join(tmpdir(), "thunder-p93-"))
+  ;(globalThis as any).tjs = {
+    env: { UPLOAD_SPOOL_DIR: spoolDir },
+    statFs: async () => ({ bsize: 4096, bavail: 1024 * 1024 }),
+    open: async (p: string, mode: "r" | "w") => {
+      const fh = await fsp.open(p, mode)
+      return {
+        write: async (chunk: Uint8Array) => (await fh.write(chunk)).bytesWritten,
+        read: async (buf: Uint8Array, position: number) => {
+          readLens.push(buf.byteLength)
+          const r = await fh.read(buf, 0, buf.byteLength, position)
+          readTotal += r.bytesRead
+          return r.bytesRead
+        },
+        close: async () => fh.close(),
+      }
+    },
+  }
+  ;(globalThis.crypto.subtle as any).digest = (alg: any, data: any) => {
+    digestCalls++
+    return realDigest.call(globalThis.crypto.subtle, alg, data)
+  }
+  globalThis.fetch = (async (input: any, init?: any) => {
+    const url = String(input)
+    // 真实 fetch 在 resolve 前读完请求体；这里同样在调用点消费，避免驱动
+    // 按 SPEC 在 finally 关读句柄后测试再读流（否则 EBADF）。
+    if (init?.body instanceof ReadableStream) {
+      const parts: Uint8Array[] = []
+      const reader = init.body.getReader()
+      for (;;) {
+        const { done, value } = await reader.read()
+        if (done) break
+        putChunkLens.push(value.byteLength)
+        parts.push(value)
+      }
+      putBodyBytes = new Uint8Array(Buffer.concat(parts.map((p) => Buffer.from(p))))
+    }
+    putCalls.push({
+      url,
+      headers: (init?.headers || {}) as Record<string, string>,
+      body: init?.body,
+      duplex: init?.duplex,
+    })
+    if (putStatus !== 200) {
+      return {
+        ok: false,
+        status: putStatus,
+        headers: { get: () => "text/plain" },
+        text: async () => "denied",
+        json: async () => ({}),
+      }
+    }
+    return {
+      ok: true,
+      status: 200,
+      headers: { get: () => "text/plain" },
+      text: async () => "",
+      json: async () => ({}),
+    } as any
+  }) as any
+})
+
+afterEach(async () => {
+  globalThis.fetch = realFetch
+  ;(globalThis as any).tjs = realTjs
+  ;(globalThis.crypto.subtle as any).digest = realDigest
+  await rm(spoolDir, { recursive: true, force: true })
+})
+
+/** 把 spool 文件当 readAt 源，模拟驱动内部的读法。 */
+function fileReader(path: string) {
+  return async (buf: Uint8Array, position: number): Promise<number> => {
+    readLens.push(buf.byteLength)
+    const fh = await fsp.open(path, "r")
+    try {
+      const r = await fh.read(buf, 0, buf.byteLength, position)
+      readTotal += r.bytesRead
+      return r.bytesRead
+    } finally {
+      await fh.close()
+    }
+  }
+}
+
+test("1 beginStream 与 calcGcidFromSpool 存在", () => {
+  assert.equal(typeof (makeDriver() as any).beginStream, "function")
+  assert.equal(typeof (thunderUtil as any).calcGcidFromSpool, "function")
+})
+
+test("2 gcid 兼容：5MiB / 3MiB+1 / 0 字节与整包 calcGcid 相同", async () => {
+  assert.equal(typeof (thunderUtil as any).calcGcidFromSpool, "function")
+  for (const size of [5 * MB, 3 * MB + 1, 0]) {
+    const src = makeSrc(size)
+    const p = join(spoolDir, `cmp-${size}.bin`)
+    await fsp.writeFile(p, src)
+    const got = await (thunderUtil as any).calcGcidFromSpool(fileReader(p), size)
+    assert.equal(got, calcGcid(src), `size=${size}`)
+  }
+  const empty = await (thunderUtil as any).calcGcidFromSpool(fileReader(join(spoolDir, "cmp-0.bin")), 0)
+  assert.equal(empty, "da39a3ee5e6b4b0d3255bfef95601890afd80709")
+})
+
+test("3 5MiB 流式：读块 <= 2MiB、总读 5MiB、digest 21 次", async () => {
+  const size = 5 * MB
+  const src = makeSrc(size)
+  const p = join(spoolDir, "stream.bin")
+  await fsp.writeFile(p, src)
+  digestCalls = 0
+  readLens = []
+  readTotal = 0
+  const got = await (thunderUtil as any).calcGcidFromSpool(fileReader(p), size)
+  assert.equal(got, calcGcid(src))
+  assert.ok(Math.max(...readLens) <= 2 * MB)
+  assert.equal(readTotal, size)
+  assert.equal(digestCalls, 21)
+})
+
+test("4 5MiB 上传：authRequest 1 次、S3 流式 PUT、字节一致", async () => {
+  const size = 5 * MB
+  const src = makeSrc(size)
+  const d = makeDriver()
+  const w = await (d as any).beginStream("/thunder-test/a.bin", size)
+  await w.write(src)
+  await w.commit()
+
+  assert.equal(authCalls.length, 1)
+  const body = authCalls[0].opts.body
+  assert.equal(body.hash, calcGcid(src))
+  assert.equal(body.size, String(size))
+  assert.equal(body.name, "a.bin")
+  assert.equal(body.parent_id, "thunder-test")
+
+  assert.equal(putCalls.length, 1)
+  const put = putCalls[0]
+  assert.equal(put.url, "https://up.example.com/bkt/k")
+  assert.equal(put.headers["Content-Length"], String(size))
+  assert.equal(put.headers["x-amz-security-token"], "tok")
+  assert.equal(put.duplex, "half")
+  assert.ok(put.body instanceof ReadableStream, "S3 body 是 ReadableStream")
+
+  assert.ok(Math.max(...putChunkLens) <= 64 * 1024)
+  assert.equal(putBodyBytes.byteLength, size)
+  assert.deepEqual(putBodyBytes, src)
+  assert.deepEqual(await readdir(spoolDir), [])
+})
+
+test("5 0 字节：gcid 空文件、S3 body 是 Uint8Array(0)", async () => {
+  const d = makeDriver()
+  const w = await (d as any).beginStream("/thunder-test/empty.bin", 0)
+  await w.commit()
+  assert.equal(authCalls[0].opts.body.hash, "da39a3ee5e6b4b0d3255bfef95601890afd80709")
+  assert.equal(authCalls[0].opts.body.size, "0")
+  assert.ok(putCalls[0].body instanceof Uint8Array)
+  assert.equal(putCalls[0].body.byteLength, 0)
+  assert.equal(putCalls[0].headers["Content-Length"], "0")
+  assert.deepEqual(await readdir(spoolDir), [])
+})
+
+test("6 S3 403：commit 抛错含 403，spool 已清", async () => {
+  putStatus = 403
+  const d = makeDriver()
+  const w = await (d as any).beginStream("/thunder-test/a.bin", MB)
+  await w.write(new Uint8Array(MB))
+  await assert.rejects(() => w.commit(), /403/)
+  assert.deepEqual(await readdir(spoolDir), [])
+})
+
+test("7 abort：authRequest 0 次、fetch 0 次、spool 已清", async () => {
+  const d = makeDriver()
+  const w = await (d as any).beginStream("/thunder-test/a.bin", MB)
+  await w.write(new Uint8Array(MB))
+  await w.abort()
+  assert.equal(authCalls.length, 0)
+  assert.equal(putCalls.length, 0)
+  assert.deepEqual(await readdir(spoolDir), [])
+})
+
+test("8 声明长度 10 写 11：write 抛错，authRequest 0 次", async () => {
+  const d = makeDriver()
+  const w = await (d as any).beginStream("/thunder-test/a.bin", 10)
+  await assert.rejects(() => w.write(new Uint8Array(11)), /thunder 上传声明长度与实际不符/)
+  assert.equal(authCalls.length, 0)
+  assert.deepEqual(await readdir(spoolDir), [])
+})
