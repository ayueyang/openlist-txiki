+/**
+ * 从落盘 spool 按块流式算 gcid：每块 SHA-1，再把摘要串整体 SHA-1。
+ * 语义与 calcGcid 完全一致，内存只与块大小有关（<=2MiB）。
+ */
+export async function calcGcidFromSpool(
+  readAt: (buf: Uint8Array, position: number) => Promise<number>,
+  size: number,
+): Promise<string> {
+  const psize = calcGcidBlockSize(size)
+  const digests: Uint8Array[] = []
+  let pos = 0
+  while (pos < size) {
+    const want = Math.min(psize, size - pos)
+    const buf = new Uint8Array(want)
+    let got = 0
+    while (got < want) {
+      const n = await readAt(buf.subarray(got), pos + got)
+      if (!(n > 0)) throw new Error("thunder gcid 读取提前结束")
+      got += n
+    }
+    const d = await crypto.subtle.digest("SHA-1", buf)
+    digests.push(new Uint8Array(d))
+    pos += want
+  }
+  const all = new Uint8Array(digests.length * 20)
+  for (let i = 0; i < digests.length; i++) all.set(digests[i], i * 20)
+  const final = await crypto.subtle.digest("SHA-1", all)
+  return Array.from(new Uint8Array(final))
+    .map((x) => x.toString(16).padStart(2, "0"))
+    .join("")
+}
