+// 刷新等待上限：单次等 15 秒、整轮 30 秒（alist 同口径），防止一次用户请求
+// 被多个限流端点拖死。
+const MAX_REFRESH_WAIT_MS = 15_000
+const MAX_REFRESH_TOTAL_MS = 30_000
+
+/** sub 不一致是终止错误，不能被当成「这个端点不行」吞掉。 */
+class AliyunRefreshSubMismatchError extends Error {}
+
+/** 整轮刷新超预算，直接终止，不再换端点。 */
+class AliyunRefreshBudgetExceededError extends Error {}
+
+function parseRetryAfter(header: string | null): number {
+  if (!header) return 0
+  const s = header.trim()
+  if (/^\d+$/.test(s)) return Math.min(Number(s) * 1000, MAX_REFRESH_WAIT_MS)
+  const at = Date.parse(s)
+  if (Number.isFinite(at)) return Math.max(0, Math.min(at - Date.now(), MAX_REFRESH_WAIT_MS))
+  return 0
+}
+
+function isRetryableStatus(status: number): boolean {
+  return status === 429 || status >= 500
+}
+
+/** 日志与错误文案里抹掉 refresh_token 值，避免泄密（验收 A10）。 */
+function redactTokenEcho(text: string): string {
+  return String(text || "").replace(
+    /("?refresh_token"?\s*[:=]\s*"?)([^"&\s,}]+)/gi,
+    "$1***",
+  )
+}
