--- a/src/backend/drivers/quark/util.ts
+++ b/src/backend/drivers/quark/util.ts
@@ -348,6 +348,69 @@ export class QuarkClient {
     return resp.data
   }
 
+  // ---- Cookie refresh loop ----
+  //
+  // alist 的做法（quark_uc/util.go:240-297）：每 100 分钟 ±5 分钟抖动，去掉
+  // __puus 后请求 /config，让服务端重新下发；否则 __puus 约 3 小时后过期，
+  // 下载先 403、随后列表也失败，只能重新粘 cookie。
+  private refreshTimer: any = null
+
+  public startAutoRefresh(): void {
+    if (this.refreshTimer) return
+    const raw =
+      typeof process !== "undefined" && process.env
+        ? process.env.OPENLIST_QUARK_REFRESH_MS
+        : ""
+    const override = Number(raw || 0)
+    let period = 100 * 60 * 1000
+    if (Number.isFinite(override) && override > 0) {
+      // 只给测试用；生产不设这个变量。
+      period = Math.max(1000, Math.floor(override))
+    } else {
+      period += Math.floor((Math.random() * 10 - 5) * 60 * 1000)
+    }
+    this.refreshTimer = setInterval(() => {
+      void this.refreshCookie()
+    }, period)
+    try {
+      ;(this.refreshTimer as any)?.unref?.()
+    } catch {
+      // txiki 的 setInterval 可能不返回对象；不影响功能。
+    }
+    console.log(
+      `[Quark/UC] (${this.addition.variant || "Quark"}) cookie refresh loop period_ms=${period}`,
+    )
+  }
+
+  public stopAutoRefresh(): void {
+    if (!this.refreshTimer) return
+    clearInterval(this.refreshTimer)
+    this.refreshTimer = null
+  }
+
+  /**
+   * 主动刷新一次：删掉旧 __puus/__pus 再请求 /config，服务端通过 Set-Cookie
+   * 下发新值；request() 负责合并并触发 onCookieUpdate 落库。
+   */
+  public async refreshCookie(): Promise<boolean> {
+    if (!this.cookie?.trim()) return false
+    const before = this.cookie
+    // 设备实测（2026-11-05）：删掉 __puus 再请求 /config 会直接 401
+    // require login [guest]，与 alist 的 quark_uc 不同。改为带原 cookie 请求
+    // /config 做保活/轮换；服务端下发的新 Set-Cookie 由同一路径合并并落库。
+    try {
+      await this.request("/config", "GET")
+      const changed = this.cookie !== before
+      console.log(
+        `[Quark/UC] (${this.addition.variant || "Quark"}) cookie refresh ok changed=${changed} cookie_len=${this.cookie.length}`,
+      )
+      return changed
+    } catch (e: any) {
+      console.warn(`[Quark/UC] cookie refresh failed:`, e.message)
+      return false
+    }
+  }
+
   // ---- Init (validates cookie by calling /config) ----
 
   async init(): Promise<void> {
