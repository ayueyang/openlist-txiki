+/** 枚举校验：非法值显式拒绝（A 有表单层约束，W 没有，只能在这里拦）。 */
+function pickEnum(
+  field: string,
+  value: any,
+  allowed: string[],
+  fallback: string,
+): string {
+  const raw = value === undefined || value === null ? "" : String(value).trim()
+  const v = raw || fallback
+  if (!allowed.includes(v)) {
+    throw new Error(
+      `[189pc] 无效的 ${field}=${v}，可选：${allowed.join(",")}`,
+    )
+  }
+  return v
+}
