@@ -0,0 +1,162 @@
+// SPEC p2-80（补丁 87）：189pc 配置字段保真与显式失败。零网络。
+import assert from "node:assert/strict"
+import { afterEach, beforeEach, test } from "node:test"
+
+import { Cloud189PCDriver, normalizeCloud189PCAddition } from "./driver"
+
+const realFetch = globalThis.fetch
+let fetchCount = 0
+let loginBody: URLSearchParams | null = null
+let loginResp: any = {
+  result: 0,
+  accessToken: "at",
+  sessionKey: "sk",
+  sessionSecret: "ss",
+  refreshToken: "rt",
+  tokenType: "Bearer",
+  familyId: 0,
+  keepAlive: 1,
+}
+
+function jsonResponse(body: any): any {
+  const text = JSON.stringify(body)
+  return {
+    ok: true,
+    status: 200,
+    headers: { get: () => "application/json" },
+    text: async () => text,
+    json: async () => JSON.parse(text),
+  }
+}
+
+function file(id: number, name: string, size: number, isFolder = false) {
+  return {
+    id,
+    parentId: 0,
+    name,
+    size,
+    createDate: "2026-01-02T03:04:05",
+    lastOpTime: "2026-01-02T03:04:05",
+    isFolder,
+  }
+}
+
+beforeEach(() => {
+  fetchCount = 0
+  loginBody = null
+  loginResp = {
+    result: 0,
+    accessToken: "at",
+    sessionKey: "sk",
+    sessionSecret: "ss",
+    refreshToken: "rt",
+    tokenType: "Bearer",
+    familyId: 0,
+    keepAlive: 1,
+  }
+  globalThis.fetch = (async (_input: any, init?: any) => {
+    fetchCount++
+    if (init?.body) loginBody = new URLSearchParams(String(init.body))
+    return jsonResponse(loginResp)
+  }) as any
+})
+
+afterEach(() => {
+  globalThis.fetch = realFetch
+})
+
+test("1 默认值", () => {
+  const a = normalizeCloud189PCAddition({})
+  assert.equal(a.order_by, "filename")
+  assert.equal(a.order_direction, "asc")
+  assert.equal(a.type, "personal")
+  assert.equal(a.upload_method, "stream")
+  assert.equal(a.upload_thread, "3")
+  assert.equal(a.strip_emoji, false)
+  assert.equal(a.family_transfer, false)
+  assert.equal(a.rapid_upload, false)
+  assert.equal(a.no_use_ocr, false)
+  assert.equal(a.family_id, "")
+  assert.equal(a.validate_code, "")
+})
+
+test("2 非法枚举显式抛错（含字段名与可选值）", () => {
+  assert.throws(
+    () => normalizeCloud189PCAddition({ order_by: "mtime" }),
+    /无效的 order_by=mtime.*filename,filesize,lastOpTime/,
+  )
+  assert.throws(
+    () => normalizeCloud189PCAddition({ type: "team" }),
+    /无效的 type=team.*personal,family/,
+  )
+  assert.throws(
+    () => normalizeCloud189PCAddition({ upload_method: "fast" }),
+    /无效的 upload_method=fast.*stream,rapid,old/,
+  )
+})
+
+test("3 upload_thread 收敛", () => {
+  assert.equal(normalizeCloud189PCAddition({ upload_thread: "0" }).upload_thread, "3")
+  assert.equal(normalizeCloud189PCAddition({ upload_thread: "33" }).upload_thread, "3")
+  assert.equal(normalizeCloud189PCAddition({ upload_thread: "abc" }).upload_thread, "3")
+  assert.equal(normalizeCloud189PCAddition({ upload_thread: "16" }).upload_thread, "16")
+})
+
+test("4 type=family：init 在任何 fetch 之前抛错", async () => {
+  const d = new Cloud189PCDriver({ username: "u", password: "p", type: "family" } as any)
+  await assert.rejects(() => d.init(), /type=family 未实现/)
+  assert.equal(fetchCount, 0)
+})
+
+test("5 排序：filesize/desc 与 filename/asc", async () => {
+  const d = new Cloud189PCDriver({ username: "u", password: "p", order_by: "filesize", order_direction: "desc" } as any)
+  let page = 0
+  ;(d as any).client.requestAPI = async () => {
+    page++
+    if (page === 1) {
+      return { folderList: [], fileList: [file(1, "a", 3), file(2, "b", 1)], recordCount: 4 }
+    }
+    return { folderList: [], fileList: [file(3, "c", 4), file(4, "d", 2)], recordCount: 4 }
+  }
+  const desc = await d.list("-11")
+  assert.deepEqual(desc.map((x) => x.size), [4, 3, 2, 1])
+
+  const d2 = new Cloud189PCDriver({ username: "u", password: "p" } as any)
+  page = 0
+  ;(d2 as any).client.requestAPI = async () => {
+    page++
+    if (page === 1) {
+      return { folderList: [], fileList: [file(1, "b", 3), file(2, "a", 1)], recordCount: 4 }
+    }
+    return { folderList: [], fileList: [file(3, "d", 4), file(4, "c", 2)], recordCount: 4 }
+  }
+  const asc = await d2.list("-11")
+  assert.deepEqual(asc.map((x) => x.name), ["a", "b", "c", "d"])
+})
+
+test("6 validate_code：非空进登录表单，空则不含该键", async () => {
+  const d = new Cloud189PCDriver({ username: "u", password: "p", validate_code: " 1234 " } as any)
+  await (d as any).login()
+  assert.ok(loginBody)
+  assert.equal(loginBody!.get("validateCode"), "1234")
+
+  loginBody = null
+  const d2 = new Cloud189PCDriver({ username: "u", password: "p" } as any)
+  await (d2 as any).login()
+  assert.ok(loginBody)
+  assert.equal((loginBody as any)!.has("validateCode"), false)
+})
+
+test("7 老配置不回退", () => {
+  const d = new Cloud189PCDriver({ username: "u", password: "p" } as any)
+  const a = (d as any).addition
+  assert.equal(a.order_by, "filename")
+  assert.equal(a.type, "personal")
+  assert.equal(a.upload_thread, "3")
+})
+
+test("8 登录失败验证码文案", async () => {
+  loginResp = { result: 10001, msg: "验证码错误" }
+  const d = new Cloud189PCDriver({ username: "u", password: "p" } as any)
+  await assert.rejects(() => (d as any).login(), /validate_code/)
+})
