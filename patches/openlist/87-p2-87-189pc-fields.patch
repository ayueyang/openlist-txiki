+  let thread = 3
+  if (/^\d+$/.test(threadRaw)) {
+    const n = parseInt(threadRaw, 10)
+    if (n >= 1 && n <= 32) thread = n
+  }
+  norm.upload_thread = String(thread)
+  norm.strip_emoji = !!norm.strip_emoji
+  norm.family_transfer = !!norm.family_transfer
+  norm.rapid_upload = !!norm.rapid_upload
+  norm.no_use_ocr = !!norm.no_use_ocr
