diff --git a/src/backend/drivers/alias/loop-guard.test.ts b/src/backend/drivers/alias/loop-guard.test.ts
new file mode 100644
index 0000000..0f1fb94
--- /dev/null
+++ b/src/backend/drivers/alias/loop-guard.test.ts
@@ -0,0 +1,93 @@
+import assert from "node:assert/strict"
+import { test } from "node:test"
+
+import { AliasDriver } from "./driver"
+import { AliasRedirectLoopError } from "../../pkg/errs"
+
+/**
+ * r65 补丁 83 单测桩：resolvePath 按 resolveTo 返回目标存储 id；
+ * getItem / listItems 只记调用，用于断言「环回时零底层调用」。
+ */
+class LoopStubDriver extends AliasDriver {
+  calls: string[] = []
+  resolveTo = "s1"
+  itemName = "x"
+
+  // 覆写放宽为 public：兜底深度用例需要在实例上替换 storageModule。
+  async storageModule(): Promise<any> {
+    const calls = this.calls
+    const self = this
+    return {
+      resolvePath: async (p: string) => {
+        calls.push(`storage.resolvePath:${p}`)
+        return { storage: { id: self.resolveTo }, isVirtual: false }
+      },
+      getItem: async (p: string) => {
+        calls.push(`storage.getItem:${p}`)
+        return { item: { name: self.itemName, size: 1 } }
+      },
+      listItems: async (p: string) => {
+        calls.push(`storage.listItems:${p}`)
+        return { content: [] }
+      },
+    }
+  }
+}
+
+test("p2-86 自指 alias：get 与 list 均抛 AliasRedirectLoopError，且不进入底层", async () => {
+  const d = new LoopStubDriver({ paths: "/x" } as any, { id: "s1" })
+  await assert.rejects(() => d.get("/v/x", "/x"), AliasRedirectLoopError)
+  await assert.rejects(() => d.list("/v/x", "/x"), AliasRedirectLoopError)
+  assert.deepEqual(
+    d.calls.filter(
+      (c) => c.startsWith("storage.getItem:") || c.startsWith("storage.listItems:"),
+    ),
+    [],
+  )
+})
+
+test("p2-86 正常 alias 链不误杀：目标是别的存储时 get 正常返回", async () => {
+  const d = new LoopStubDriver({ paths: "/x" } as any, { id: "s1" })
+  d.resolveTo = "s2"
+  const item = await d.get("/v/x", "/x")
+  assert.equal(item.name, "x")
+})
+
+test("p2-86 三级别名链 s1->s2->s3 每层只解析到不同 id，全部放行", async () => {
+  const d1 = new LoopStubDriver({ paths: "/x" } as any, { id: "s1" })
+  d1.resolveTo = "s2"
+  const d2 = new LoopStubDriver({ paths: "/x" } as any, { id: "s2" })
+  d2.resolveTo = "s3"
+  const d3 = new LoopStubDriver({ paths: "/x" } as any, { id: "s3" })
+  d3.resolveTo = "l1"
+  for (const d of [d1, d2, d3]) {
+    const item = await d.get("/v/x", "/x")
+    assert.equal(item.name, "x")
+  }
+})
+
+test("p2-86 无 storageConfig 时嵌套超过 8 层触发兜底错误", async () => {
+  const d = new LoopStubDriver({ paths: "/x" } as any)
+  let hits = 0
+  const base = d.storageModule.bind(d)
+  ;(d as any).storageModule = async () => {
+    const mod = await base()
+    return {
+      ...mod,
+      getItem: async (_p: string) => {
+        hits++
+        await d.get("/v/x", "/x")
+        return { item: { name: "x", size: 1 } }
+      },
+    }
+  }
+  await assert.rejects(() => d.get("/v/x", "/x"), AliasRedirectLoopError)
+  assert.equal(hits, 8)
+})
+
+test("p2-86 两个独立实例的兜底计数互不污染", async () => {
+  const a = new LoopStubDriver({ paths: "/x" } as any)
+  const b = new LoopStubDriver({ paths: "/x" } as any)
+  const res = await Promise.all([a.get("/v/x", "/x"), b.get("/v/x", "/x")])
+  assert.equal(res.length, 2)
+})
