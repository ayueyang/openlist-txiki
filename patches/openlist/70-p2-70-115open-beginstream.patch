--- a/src/backend/drivers/115open/driver.ts
+++ b/src/backend/drivers/115open/driver.ts
@@ -23,6 +23,238 @@ function subrequestLimit(): number {
   return typeof (globalThis as any).tjs !== "undefined" ? 100000 : 45
 }
 
+// ---- Upload phase 2：落盘暂存 + OSS multipart（A-5） ----
+
+/** begin 时至少预留 fileSize + 64MiB。 */
+const SPOOL_MIN_FREE = 64 * 1024 * 1024
+/** expectedSize 未知时的剩余空间复查步长。 */
+const SPOOL_RECHECK_EVERY = 16 * 1024 * 1024
+/** 流式 sha1 的读块大小，只影响 hash 峰值，与分片大小无关。 */
+const HASH_CHUNK = 1024 * 1024
+
+const MB = 1024 * 1024
+const GB = 1024 * MB
+const TB = 1024 * GB
+
+/**
+ * 分片档位，逐字移植 A drivers/115_open/upload.go:17-35：
+ * 20MiB 起步；>128/256/384/512/768GB 与 >1TB 各升一档。
+ */
+export function calPartSize(fileSize: number): number {
+  let partSize = 20 * MB
+  if (fileSize > partSize) {
+    if (fileSize > 1 * TB) partSize = 5 * GB
+    else if (fileSize > 768 * GB) partSize = 109951163
+    else if (fileSize > 512 * GB) partSize = 82463373
+    else if (fileSize > 384 * GB) partSize = 54975582
+    else if (fileSize > 256 * GB) partSize = 41231687
+    else if (fileSize > 128 * GB) partSize = 27487791
+  }
+  return partSize
+}
+
+/** 只有真 tjs 运行时才有文件句柄 API；测试里的 tjs mock 只有 env/statFs。 */
+function tjsFs(): any {
+  const t = (globalThis as any).tjs
+  return t && typeof t.open === "function" ? t : null
+}
+
+function isErrno(e: any, name: string): boolean {
+  return e?.code === name || String(e?.message || e).includes(name)
+}
+
+/**
+ * spool 目录解析顺序：UPLOAD_SPOOL_DIR > dirname(TJS_DB)/upload-spool >
+ * TJS_DATA_DIR/upload-spool。都拿不到就抛错，禁止回退 /tmp（设备上是 tmpfs）。
+ */
+function resolveSpoolDir(): string {
+  const t = (globalThis as any).tjs
+  const env = (t && t.env) || {}
+  const explicit = env.UPLOAD_SPOOL_DIR
+  if (explicit) return String(explicit).replace(/[\\/]+$/, "")
+  const db = env.TJS_DB
+  if (db) {
+    const s = String(db)
+    const idx = Math.max(s.lastIndexOf("/"), s.lastIndexOf("\\"))
+    if (idx > 0) return `${s.slice(0, idx)}/upload-spool`
+  }
+  const dataDir = env.TJS_DATA_DIR
+  if (dataDir) return `${String(dataDir).replace(/[\\/]+$/, "")}/upload-spool`
+  throw new Error(
+    "115open 上传暂存目录不可用：请设置 UPLOAD_SPOOL_DIR、TJS_DB 或 TJS_DATA_DIR" +
+      "（禁止回退 /tmp：设备上是 tmpfs）",
+  )
+}
+
+async function ensureDir(dir: string): Promise<void> {
+  const t = tjsFs()
+  if (!t || typeof t.makeDir !== "function") {
+    const spec: string = "node:fs/promises"
+    const fsp: any = await import(spec)
+    await fsp.mkdir(dir, { recursive: true })
+    return
+  }
+  const parts = dir.split("/").filter(Boolean)
+  let cur = dir.startsWith("/") ? "" : "."
+  for (const p of parts) {
+    cur = cur === "" ? `/${p}` : `${cur}/${p}`
+    try {
+      await t.makeDir(cur)
+    } catch (e: any) {
+      if (!isErrno(e, "EEXIST")) throw e
+    }
+  }
+}
+
+interface SpoolHandle {
+  write(chunk: Uint8Array): Promise<void>
+  readAt(buf: Uint8Array, position: number): Promise<number>
+  close(): Promise<void>
+}
+
+async function openSpoolFile(p: string, mode: "w" | "r"): Promise<SpoolHandle> {
+  const t = tjsFs()
+  if (t) {
+    const h = await t.open(p, mode)
+    return {
+      write: async (chunk) => {
+        let off = 0
+        while (off < chunk.byteLength) {
+          const n = Number(await h.write(chunk.subarray(off)))
+          if (!(n > 0)) throw new Error("115open spool 写入失败")
+          off += n
+        }
+      },
+      readAt: async (buf, position) => {
+        const n = await h.read(buf, position)
+        return n === null || n === undefined ? 0 : Number(n)
+      },
+      close: async () => {
+        await h.close()
+      },
+    }
+  }
+  const spec: string = "node:fs/promises"
+  const fsp: any = await import(spec)
+  const h = await fsp.open(p, mode)
+  return {
+    write: async (chunk) => {
+      let off = 0
+      while (off < chunk.byteLength) {
+        const r = await h.write(chunk.subarray(off))
+        const n = Number(r?.bytesWritten ?? r ?? 0)
+        if (!(n > 0)) throw new Error("115open spool 写入失败")
+        off += n
+      }
+    },
+    readAt: async (buf, position) => {
+      const r = await h.read(buf, 0, buf.length, position)
+      return Number(r?.bytesRead || 0)
+    },
+    close: async () => {
+      await h.close()
+    },
+  }
+}
+
+async function unlinkSpool(p: string): Promise<void> {
+  const t = tjsFs()
+  if (t && typeof t.unlink === "function") {
+    await t.unlink(p)
+    return
+  }
+  const spec: string = "node:fs/promises"
+  const fsp: any = await import(spec)
+  await fsp.unlink(p)
+}
+
+async function availableBytes(dir: string): Promise<number | null> {
+  const t = (globalThis as any).tjs
+  if (!t || typeof t.statFs !== "function") return null
+  const st = await t.statFs(dir)
+  const bsize = Number(st?.bsize)
+  const bavail = Number(st?.bavail)
+  // bavail 为 -1 表示文件系统不报可用块，按未知处理（不阻断上传）。
+  if (!Number.isFinite(bsize) || !Number.isFinite(bavail)) return null
+  if (bsize <= 0 || bavail < 0) return null
+  return bavail * bsize
+}
+
+async function assertSpoolSpace(dir: string, needed: number): Promise<void> {
+  const avail = await availableBytes(dir)
+  if (avail === null) return
+  if (avail < needed) {
+    throw new Error(
+      `115open 上传暂存空间不足：需要 ${needed} 字节，可用 ${avail} 字节（${dir}）`,
+    )
+  }
+}
+
+function randomHex(bytes: number): string {
+  const b = new Uint8Array(bytes)
+  crypto.getRandomValues(b)
+  return Array.from(b)
+    .map((x) => x.toString(16).padStart(2, "0"))
+    .join("")
+}
+
+interface Sha1Sink {
+  update(chunk: Uint8Array): void
+  hex(): string
+}
+
+/**
+ * 增量 sha1：tjs 用 tjs:hashing（native），Node/测试用 node:crypto。
+ * WebCrypto 只有一次性 digest，1GiB 全量哈希必须走增量接口。
+ */
+async function createSha1Sink(): Promise<Sha1Sink> {
+  if (tjsFs()) {
+    const spec: string = "tjs:hashing"
+    const mod: any = await import(spec)
+    const h = mod.createHash("sha1")
+    return {
+      update: (chunk) => {
+        h.update(chunk)
+      },
+      hex: () => String(h.digest()),
+    }
+  }
+  const spec: string = "node:crypto"
+  const mod: any = await import(spec)
+  const h = mod.createHash("sha1")
+  return {
+    update: (chunk) => {
+      h.update(chunk)
+    },
+    hex: () => String(h.digest("hex")),
+  }
+}
+
