+// 115open phase 2：beginStream 落盘暂存 + OSS multipart 单元测试
+// 全部 mock globalThis.fetch：不连网、不登录、不需要真实 115 账号与设备。
+import assert from "node:assert/strict"
+import { afterEach, beforeEach, test } from "node:test"
+import { mkdtemp, readdir, readFile, rm } from "node:fs/promises"
+import { tmpdir } from "node:os"
+import { join } from "node:path"
+
+import { Pan115Driver, calPartSize } from "./driver"
+
+const MB = 1024 * 1024
+const GB = 1024 * MB
+const TB = 1024 * GB
+
+const realFetch = globalThis.fetch
+const realTjs = (globalThis as any).tjs
+
+interface FetchCall {
+  url: string
+  method: string
+  headers: Record<string, string>
+  body: any
+}
+
+let calls: FetchCall[] = []
+let initResponses: any[] = []
+let partFailAt = 0
+let spoolDir = ""
+let statFsQueue: Array<{ bsize: number; bavail: number }> = []
+let defaultStatFs = { bsize: 4096, bavail: 1024 * 1024 } // 4GiB 可用
+
+function jsonResponse(body: any): any {
+  const text = JSON.stringify(body)
+  return {
+    ok: true,
+    status: 200,
+    headers: { get: () => "application/json" },
+    text: async () => text,
+    json: async () => JSON.parse(text),
+  }
+}
+
+function ossResponse(
+  status: number,
+  text: string,
+  headers: Record<string, string> = {},
+): any {
+  const lower: Record<string, string> = {}
+  for (const [k, v] of Object.entries(headers)) lower[k.toLowerCase()] = v
+  return {
+    ok: status >= 200 && status < 300,
+    status,
+    headers: { get: (k: string) => lower[String(k).toLowerCase()] ?? null },
+    text: async () => text,
+    json: async () => JSON.parse(text),
+  }
+}
+
+beforeEach(async () => {
+  calls = []
+  initResponses = []
+  partFailAt = 0
+  statFsQueue = []
+  defaultStatFs = { bsize: 4096, bavail: 1024 * 1024 }
+  spoolDir = await mkdtemp(join(tmpdir(), "115open-p2-"))
+  ;(globalThis as any).tjs = {
+    env: { UPLOAD_SPOOL_DIR: spoolDir },
+    statFs: async () => (statFsQueue.length ? statFsQueue.shift()! : defaultStatFs),
+  }
+  globalThis.fetch = (async (input: any, init?: any) => {
+    const url = String(input)
+    const method = String(init?.method || "GET").toUpperCase()
+    calls.push({ url, method, headers: init?.headers || {}, body: init?.body })
+    if (url.includes("/open/folder/get_info")) {
+      return jsonResponse({
+        state: true,
+        code: 0,
+        data: { file_id: "111", file_name: "dir" },
+      })
+    }
+    if (url.includes("/open/upload/init")) {
+      const next = initResponses.shift()
+      if (!next) throw new Error("unexpected uploadInit call")
+      return jsonResponse({ state: true, code: 0, data: next })
+    }
+    if (url.includes("/open/upload/get_token")) {
+      return jsonResponse({
+        state: true,
+        code: 0,
+        data: {
+          endpoint: "https://oss.example.com",
+          AccessKeyId: "AK",
+          AccessKeySecret: "SK",
+          SecurityToken: "ST",
+        },
+      })
+    }
+    if (url.includes("oss.example.com")) {
+      if (method === "POST" && url.endsWith("?uploads")) {
+        return ossResponse(
+          200,
+          "<InitiateMultipartUploadResult><UploadId>UP1</UploadId></InitiateMultipartUploadResult>",
+        )
+      }
+      if (method === "PUT") {
+        const pn = Number(new URL(url).searchParams.get("partNumber"))
+        if (partFailAt && pn === partFailAt) return ossResponse(500, "boom")
+        return ossResponse(200, "", { etag: `"etag-${pn}"` })
+      }
+      if (method === "POST" && url.includes("uploadId=")) {
+        return ossResponse(200, '{"state":true}')
+      }
+    }
+    throw new Error(`unexpected fetch ${method} ${url}`)
+  }) as any
+})
+
+afterEach(async () => {
+  globalThis.fetch = realFetch
+  if (realTjs === undefined) delete (globalThis as any).tjs
+  else (globalThis as any).tjs = realTjs
+  await rm(spoolDir, { recursive: true, force: true })
+})
+
+function newDriver(): Pan115Driver {
+  return new Pan115Driver({ access_token: "a", refresh_token: "r" } as any)
+}
+
+async function spoolFiles(): Promise<string[]> {
+  return (await readdir(spoolDir)).filter((n) => n.startsWith("115open-"))
+}
+
+function initOk(extra: Record<string, any> = {}) {
+  return {
+    status: 0,
+    bucket: "bkt",
+    object: "obj/a.bin",
+    callback: { callback: "CB", callback_var: "CV" },
+    ...extra,
+  }
+}
+
+function kindOf(c: FetchCall): string {
+  if (c.url.includes("/open/upload/init")) return "init"
+  if (c.url.includes("/open/upload/get_token")) return "token"
+  if (c.url.includes("oss.example.com")) {
+    if (c.method === "POST" && c.url.endsWith("?uploads")) return "initiate"
+    if (c.method === "PUT") {
+      return `part${new URL(c.url).searchParams.get("partNumber")}`
+    }
+    if (c.method === "POST" && c.url.includes("uploadId=")) return "complete"
+  }
+  return "other"
+}
+
+function uploadCalls(): FetchCall[] {
+  return calls.filter((c) => !c.url.includes("/open/folder/get_info"))
+}
+
+test("spool 顺序落盘；秒传 status 2 清理且不发 token/multipart", async () => {
+  initResponses = [{ status: 2 }]
+  const driver = newDriver()
+  const h = await driver.beginStream("/dir/a.bin", 6)
+  await h.write(new Uint8Array([1, 2, 3]))
+  await h.write(new Uint8Array([4, 5, 6]))
+
+  const files = await spoolFiles()
+  assert.equal(files.length, 1)
+  assert.match(files[0], /^115open-[0-9a-f]+\.part$/)
+  const bytes = await readFile(join(spoolDir, files[0]))
+  assert.deepEqual([...bytes], [1, 2, 3, 4, 5, 6])
+
+  await h.commit()
+  assert.deepEqual(await readdir(spoolDir), [])
+
+  const kinds = uploadCalls().map(kindOf)
+  assert.deepEqual(kinds, ["init"])
+  assert.ok(!calls.some((c) => c.url.includes("/open/upload/get_token")))
+  assert.ok(!calls.some((c) => c.url.includes("oss.example.com")))
+})
+
+test("abort 关文件并删除 spool", async () => {
+  const driver = newDriver()
+  const h = await driver.beginStream("/dir/b.bin", 3)
+  await h.write(new Uint8Array([9, 9, 9]))
+  assert.equal((await spoolFiles()).length, 1)
+  await h.abort()
+  assert.deepEqual(await readdir(spoolDir), [])
+})
+
+test("请求序列：init → token → Initiate → N 次 UploadPart → Complete(callback)", async () => {
+  initResponses = [initOk()]
+  const driver = newDriver()
+  const size = 20 * MB + 16
+  const h = await driver.beginStream("/dir/a.bin", size)
+  await h.write(new Uint8Array(20 * MB).fill(0x41))
+  await h.write(new Uint8Array(16).fill(0x42))
+  await h.commit()
+
+  assert.deepEqual(uploadCalls().map(kindOf), [
+    "init",
+    "token",
+    "initiate",
+    "part1",
+    "part2",
+    "complete",
+  ])
+
+  const oss = uploadCalls().filter((c) => c.url.includes("oss.example.com"))
+  for (const c of oss) {
+    assert.match(String(c.headers.Authorization), /^OSS AK:.+/)
+    assert.equal(c.headers["x-oss-security-token"], "ST")
+  }
+  const initiate = oss[0]
+  assert.equal(initiate.method, "POST")
+  assert.ok(initiate.url.endsWith("?uploads"))
+  const part1 = oss[1]
+  const part2 = oss[2]
+  assert.ok(part1.url.includes("partNumber=1&uploadId=UP1"))
+  assert.ok(part2.url.includes("partNumber=2&uploadId=UP1"))
+  assert.equal(part1.body.byteLength, 20 * MB)
+  assert.equal(part2.body.byteLength, 16)
+  const complete = oss[3]
+  assert.equal(complete.method, "POST")
+  assert.ok(complete.url.includes("?uploadId=UP1"))
+  assert.equal(
+    complete.headers["x-oss-callback"],
+    Buffer.from("CB", "utf8").toString("base64"),
+  )
+  assert.equal(
+    complete.headers["x-oss-callback-var"],
+    Buffer.from("CV", "utf8").toString("base64"),
+  )
+  assert.deepEqual(await readdir(spoolDir), [])
+})
+
+test("sign_check：第二次 init 的 signVal 等于指定字节区间的 sha1", async () => {
+  initResponses = [
+    initOk({ status: 6, sign_check: "2-5", sign_key: "SK1" }),
+    { status: 2 },
+  ]
+  const driver = newDriver()
+  const h = await driver.beginStream("/dir/a.bin", 10)
+  await h.write(new TextEncoder().encode("0123456789"))
+  await h.commit()
+
+  const inits = uploadCalls().filter((c) => kindOf(c) === "init")
+  assert.equal(inits.length, 2)
+  const second = new URLSearchParams(String(inits[1].body))
+  assert.equal(second.get("sign_key"), "SK1")
+  assert.equal(second.get("sign_val"), "D2F75E8204FEDF2EACD261E2461B2964E3BFD5BE")
+  assert.equal(second.get("fileid"), "87ACEC17CD9DCD20A716CC2CF67417B71C8A7016")
+  assert.equal(second.get("preid"), "87ACEC17CD9DCD20A716CC2CF67417B71C8A7016")
+  assert.ok(!uploadCalls().some((c) => c.url.includes("oss.example.com")))
+  assert.deepEqual(await readdir(spoolDir), [])
+})
+
+test("sign_check 缺失：status 6 但无 sign_check 时 fail-closed，不进入 multipart", async () => {
+  initResponses = [initOk({ status: 6, sign_check: "" })]
+  const driver = newDriver()
+  const h = await driver.beginStream("/dir/q.bin", 4)
+  await h.write(new Uint8Array([1, 2, 3, 4]))
+  await assert.rejects(() => h.commit(), /sign_check/)
+  assert.ok(!uploadCalls().some((c) => c.url.includes("oss.example.com")))
+  assert.deepEqual(await readdir(spoolDir), [])
+})
+
+test("calPartSize：20MiB 起步、档位单调递增、1GiB 约 52 片", () => {
+  assert.equal(calPartSize(0), 20 * MB)
+  assert.equal(calPartSize(1), 20 * MB)
+  assert.equal(calPartSize(20 * MB), 20 * MB)
+  assert.equal(calPartSize(20 * MB + 1), 20 * MB)
+  assert.equal(calPartSize(1 * GB), 20 * MB)
+  assert.equal(Math.ceil((1 * GB) / calPartSize(1 * GB)), 52)
+
+  assert.equal(calPartSize(128 * GB + 1), 27487791)
+  assert.equal(calPartSize(256 * GB + 1), 41231687)
+  assert.equal(calPartSize(384 * GB + 1), 54975582)
+  assert.equal(calPartSize(512 * GB + 1), 82463373)
+  assert.equal(calPartSize(768 * GB + 1), 109951163)
+  assert.equal(calPartSize(1 * TB + 1), 5 * GB)
+
+  const samples = [
+    0,
+    1,
+    20 * MB,
+    20 * MB + 1,
+    128 * GB,
+    128 * GB + 1,
+    256 * GB + 1,
+    384 * GB + 1,
+    512 * GB + 1,
+    768 * GB + 1,
+    1 * TB + 1,
+  ]
+  let prev = 0
+  for (const n of samples) {
+    const p = calPartSize(n)
+    assert.ok(p >= 20 * MB, `calPartSize(${n}) 必须 >= 20MiB`)
+    assert.ok(p >= prev, `calPartSize 在 ${n} 处必须单调不减`)
+    prev = p
+  }
+})
+
+test("空间门：expectedSize 已知时 begin 即拒，且不建 spool", async () => {
+  statFsQueue = [{ bsize: 4096, bavail: 100 }] // 400KiB
+  const driver = newDriver()
+  await assert.rejects(
+    () => driver.beginStream("/dir/x.bin", 1 * MB),
+    /空间不足/,
+  )
+  assert.deepEqual(await readdir(spoolDir), [])
+})
+
+test("空间门：expectedSize 未知时每 16MiB 复查，不足立即清理并抛错", async () => {
+  statFsQueue = [
+    { bsize: 4096, bavail: 1024 * 1024 }, // begin：4GiB
+    { bsize: 4096, bavail: 100 }, // 16MiB 节点：400KiB
+  ]
+  const driver = newDriver()
+  const h = await driver.beginStream("/dir/y.bin")
+  await assert.rejects(
+    () => h.write(new Uint8Array(16 * MB)),
+    /空间不足/,
+  )
+  assert.deepEqual(await readdir(spoolDir), [])
+  await assert.rejects(() => h.write(new Uint8Array([1])), /已结束/)
+})
+
+test("失败清理：第 2 片 UploadPart 500 时 commit rejects，无 spool 残留", async () => {
+  initResponses = [initOk()]
+  partFailAt = 2
+  const driver = newDriver()
+  const h = await driver.beginStream("/dir/z.bin", 20 * MB + 1)
+  await h.write(new Uint8Array(20 * MB + 1))
+  await assert.rejects(() => h.commit(), /HTTP 500/)
+  assert.deepEqual(await readdir(spoolDir), [])
+})
+
+test("能力探测：beginStream 存在；流式路径不调用 put", async () => {
+  initResponses = [{ status: 2 }]
+  const driver = newDriver()
+  let putCalls = 0
+  ;(driver as any).put = async () => {
+    putCalls++
+    throw new Error("put must not be called")
+  }
+  assert.equal(typeof (driver as any).beginStream, "function")
+  const h = await driver.beginStream("/dir/s.bin", 3)
+  await h.write(new Uint8Array([1, 2, 3]))
+  await h.commit()
+  assert.equal(putCalls, 0)
+})
+
+test("spool 目录不可解析时抛错，不回退 /tmp", async () => {
+  ;(globalThis as any).tjs = { env: {}, statFs: async () => defaultStatFs }
+  const driver = newDriver()
+  await assert.rejects(
+    () => driver.beginStream("/dir/n.bin", 1),
+    /暂存目录不可用/,
+  )
+})
