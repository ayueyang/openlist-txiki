+static JSValue tjs_httpserver_abort(JSContext *ctx, JSValue this_val, int argc, JSValue *argv) {
+    TJSHttpServer *s = tjs_httpserver_get(ctx, this_val);
+    if (!s) {
+        return JS_EXCEPTION;
+    }
+
+    int64_t req_id;
+    if (JS_ToInt64(ctx, &req_id, argv[0])) {
+        return JS_EXCEPTION;
+    }
+
+    TJSHttpRequest *req = tjs_http_find_request(s, req_id);
+    if (!req) {
+        return JS_UNDEFINED;
+    }
