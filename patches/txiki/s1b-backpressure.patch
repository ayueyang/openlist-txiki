+/*
+ * HttpServer.prototype.waitDrain(requestId, lowWater)
+ *
+ * Resolves true once the queued bytes fall to lowWater (or below), false when
+ * the connection is gone or abort() was called, so the producer can stop.
+ */
+static JSValue tjs_httpserver_wait_drain(JSContext *ctx, JSValue this_val, int argc, JSValue *argv) {
+    TJSHttpServer *s = tjs_httpserver_get(ctx, this_val);
+    if (!s) {
+        return JS_EXCEPTION;
+    }
+
+    int64_t req_id;
+    if (JS_ToInt64(ctx, &req_id, argv[0])) {
+        return JS_EXCEPTION;
+    }
+
+    int64_t low_water = 0;
+    if (argc > 1 && JS_ToInt64(ctx, &low_water, argv[1])) {
+        return JS_EXCEPTION;
+    }
+    if (low_water < 0) {
+        low_water = 0;
+    }
+
+    JSValue resolving_funcs[2];
+    JSValue promise = JS_NewPromiseCapability(ctx, resolving_funcs);
+    if (JS_IsException(promise)) {
+        return JS_EXCEPTION;
+    }
+
+    TJSHttpRequest *req = tjs_http_find_request(s, req_id);
+
+    if (!req || req->broken || req->queued_bytes <= (size_t) low_water) {
+        /* Nothing to wait for: settle immediately. */
+        JSValue arg = JS_NewBool(ctx, req && !req->broken);
+        JSValue ret = JS_Call(ctx, resolving_funcs[0], JS_UNDEFINED, 1, &arg);
+        if (JS_IsException(ret)) {
+            JS_FreeValue(ctx, JS_GetException(ctx));
+        }
+        JS_FreeValue(ctx, ret);
+        JS_FreeValue(ctx, arg);
+        JS_FreeValue(ctx, resolving_funcs[0]);
+        JS_FreeValue(ctx, resolving_funcs[1]);
+        return promise;
+    }
+
+    /* One waiter per request: supersede an older one with false. */
+    tjs_http_req_settle_drain(ctx, req, false);
+
+    req->drain_pending = true;
+    req->drain_low = (size_t) low_water;
+    req->drain_resolve = resolving_funcs[0]; /* ownership moves into req */
+    JS_FreeValue(ctx, resolving_funcs[1]);
+
+    return promise;
+}
