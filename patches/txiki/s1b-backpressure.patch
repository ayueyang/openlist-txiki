+    if (JS_IsFunction(ctx, resolve)) {
+        JSValue arg = JS_NewBool(ctx, ok);
+        JSValue ret = JS_Call(ctx, resolve, JS_UNDEFINED, 1, &arg);
+        if (JS_IsException(ret)) {
