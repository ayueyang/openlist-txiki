+     * chunk terminating a chunked body would make the short body look
+     * complete. */
+    struct list_head *el, *el1;
+    list_for_each_safe(el, el1, &req->pending_writes) {
+        TJSHttpPendingWrite *pw = list_entry(el, TJSHttpPendingWrite, link);
+        list_del(&pw->link);
+        js_free(ctx, pw->data);
+        js_free(ctx, pw);
+    }
+    req->queued_bytes = 0;
+    tjs_http_req_settle_drain(ctx, req, false);
