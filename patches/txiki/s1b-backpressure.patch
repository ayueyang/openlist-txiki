+static void tjs_http_req_settle_drain(JSContext *ctx, TJSHttpRequest *req, bool ok) {
+    if (!req->drain_pending) {
+        return;
+    }
+    req->drain_pending = false;
+
+    JSValue resolve = req->drain_resolve;
+    req->drain_resolve = JS_UNDEFINED;
+    req->drain_low = 0;
