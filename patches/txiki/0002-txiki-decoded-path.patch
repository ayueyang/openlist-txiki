+    // JS_NewStringLen).  The fallback is for callers that only have the
+    // combined URL, e.g. the WebSocket upgrade path.
+    const decodedPath = typeof path === 'string' ? path : url.split('?')[0];
+    const queryStr = typeof query === 'string'
+        ? query
+        : (url.includes('?') ? url.slice(url.indexOf('?')) : '');
