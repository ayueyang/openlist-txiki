+    // '%' is left alone: `new URL()` accepts a literal '%' in a pathname.
+    const safePath = decodedPath.replace(/#/g, '%23').replace(/\?/g, '%3F');
+    const safeQuery = query.replace(/#/g, '%23');
+
+    return `${scheme}://${host}${safePath}${safeQuery}`;
+}
