+        return JS_EXCEPTION;
+    }
+
+    const char *path = JS_ToCString(ctx, argv[3]);
+    if (!path) {
+        return JS_EXCEPTION;
+    }
+
+    int64_t offset = 0;
+    int64_t length = -1;
+    if (JS_ToInt64(ctx, &offset, argv[4]) || JS_ToInt64(ctx, &length, argv[5])) {
+        JS_FreeCString(ctx, path);
+        return JS_EXCEPTION;
+    }
+    bool head_only = JS_ToBool(ctx, argv[6]);
