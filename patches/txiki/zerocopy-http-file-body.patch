+    int rc = uv_fs_fstat(NULL, &stat_req, fd, NULL);
+    uv_stat_t st;
+    if (rc == 0) {
+        st = stat_req.statbuf;
+    }
+    uv_fs_req_cleanup(&stat_req);
+
+    if (rc != 0 || !S_ISREG(st.st_mode)) {
+        uv_fs_t close_req;
+        uv_fs_close(NULL, &close_req, fd, NULL);
+        uv_fs_req_cleanup(&close_req);
+        return JS_FALSE;
+    }
+
+    uint64_t fsize = (uint64_t) st.st_size;
+    if (offset < 0 || (uint64_t) offset > fsize) {
+        uv_fs_t close_req;
+        uv_fs_close(NULL, &close_req, fd, NULL);
+        uv_fs_req_cleanup(&close_req);
+        return JS_FALSE;
+    }
+
+    uint64_t avail = fsize - (uint64_t) offset;
+    uint64_t send_len = avail;
+    if (length >= 0) {
+        send_len = (uint64_t) length;
+        if (send_len > avail) {
+            send_len = avail;
+        }
+    }
+
+    /* Build and send the response headers (same shape as sendResponse). */
+    size_t hdr_buf_size = LWS_PRE + TJS_MAX_HEADER_SIZE;
+    unsigned char *header_buf = js_malloc(ctx, hdr_buf_size);
+    if (!header_buf) {
+        uv_fs_t close_req;
+        uv_fs_close(NULL, &close_req, fd, NULL);
+        uv_fs_req_cleanup(&close_req);
+        return JS_ThrowOutOfMemory(ctx);
+    }
+
+    unsigned char *start = &header_buf[LWS_PRE];
+    unsigned char *p = start;
+    unsigned char *end = header_buf + hdr_buf_size - 1;
+    bool ok = true;
+
+    if (lws_add_http_header_status(req->wsi, (unsigned int) status, &p, end)) {
+        ok = false;
+    }
+
+    if (ok && tjs_http_add_altsvc(s, req, &p, end)) {
+        ok = false;
+    }
+
+    bool has_content_length = false;
+
+    if (ok && JS_IsArray(argv[2])) {
+        int64_t headers_len;
+        JS_GetLength(ctx, argv[2], &headers_len);
+
+        for (int64_t i = 0; i < headers_len && ok; i++) {
+            JSValue pair = JS_GetPropertyUint32(ctx, argv[2], i);
+            JSValue name_val = JS_GetPropertyUint32(ctx, pair, 0);
+            JSValue value_val = JS_GetPropertyUint32(ctx, pair, 1);
+
+            const char *name = JS_ToCString(ctx, name_val);
+            size_t value_len;
+            const char *value = JS_ToCStringLen(ctx, &value_len, value_val);
+
+            if (name && value) {
+                if (strcasecmp(name, "content-length") == 0) {
+                    has_content_length = true;
+                }
+
+                if (lws_add_http_header_by_name(req->wsi,
+                                                (const unsigned char *) name,
+                                                (const unsigned char *) value,
