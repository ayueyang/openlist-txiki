+    req->file_fd = fd;
+    req->file_offset = (lws_fileofs_t) offset;
+    req->file_remaining = head_only ? 0 : (size_t) send_len;
+    req->file_head_only = head_only;
+
+    if (req->file_remaining == 0) {
+        int must_close = lws_http_transaction_completed(req->wsi);
+        (void) must_close;
+        tjs_http_req_complete(s, req);
+        return JS_TRUE;
+    }
+
+    lws_callback_on_writable(req->wsi);
+    return JS_TRUE;
+}
