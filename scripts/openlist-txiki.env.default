# openlist-txiki 运行参数模板。post-install 只在文件不存在时复制本模板，
# 升级不会覆盖用户改过的 /etc/openlist-txiki/openlist-txiki.env。
# 改完必须 /etc/init.d/openlist-txiki restart（reload 等价 restart，env 只在进程启动时读）。
#
# 首次使用（默认只绑 127.0.0.1，装完不立刻对 LAN 开放）：
#   1. 取引导口令：cat /etc/openlist-txiki/admin.pass
#      post-install 已生成（0600 root:root）。服务首次启动会在监听前自检：用这个口令
#      把 admin 建出来，日志出现 "admin bootstrap ok: user=admin source=admin.pass"，
#      并写 /etc/openlist-txiki/.admin-ready。
#   2. 本机验一次登录（能拿到 token 即成功）：
#      curl -s -X POST http://127.0.0.1:5345/api/auth/login \
#        -H 'Content-Type: application/json' \
#        -d '{"username":"admin","password":"<admin.pass 的内容>"}'
#      登录后请在界面改密；改密不会回写 admin.pass（它只是首次建号的引导凭据）。
#   3. 要 LAN 访问再改 LISTEN_ADDR=0.0.0.0 并 restart。改之前必须已经出现 .admin-ready：
#      没有口令、没有 .admin-ready 时，init 的启动前自检过不了就拒绝启动，
#      不会把未初始化的 setup 端点暴露到 LAN。
#      .admin-ready 只是上次自检成功的记号：data.db 被删除、清空或截断后它自动失效，
#      下次启动会重新自检，不会因为 marker 残留就跳过检查。
#
# 固定不通过 env 改的项（规格 §2 已定）：
#   数据目录 /etc/openlist-txiki            apk 升级/卸载都保留，不搬家
#   临时目录 /tmp/openlist-txiki             init 启动时清空，0700
#   数据库   /etc/openlist-txiki/data.db    随 TJS_DATA_DIR 推导
LISTEN_ADDR=127.0.0.1
LISTEN_PORT=5345
# 管理员口令覆盖项（可选）：留空或注释掉时，init 读 /etc/openlist-txiki/admin.pass。
# 设置后优先于 admin.pass；只在新建 admin（或旧格式口令自愈）时使用，正常升级不会重置已有密码。
# 值里不要带空格与引号；明文口令更推荐留在 admin.pass（0600）而不是这里。
#TJS_ADMIN_PASS=
# 只读开关：1=只读（默认，安全侧），0=允许写。其它值启动即失败，不静默猜。
READONLY=1
#
# 以下是可选项。默认全部注释掉：不设就不转发，应用侧走内置默认值。
# 取值只认十进制整数（字节 / 毫秒），设错不会静默纠正，应用会按自己的校验报错。
# 单次整体上传上限（字节，内置默认 25MB）
#MAX_UPLOAD=26214400
# 分片单片上限（字节，内置默认 16MB）
#MAX_UPPART=16777216
# 临时文件回收：log=只记日志不删（止损开关）
#OPENLIST_TXIKI_SWEEP=log
# 周期扫描间隔（毫秒，0=关闭）
#OPENLIST_TXIKI_SWEEP_MS=3600000
# 掉电持久性（B1）：NORMAL=SQLite 默认，掉电可能丢最近几秒内的配置写，库不损坏；
# FULL=每次提交 fsync，写放大与延迟更高。只认 NORMAL 或 FULL（大小写不敏感），
# 其他值按 NORMAL 处理并在启动日志告警一行。默认 NORMAL。
#DB_SYNC=NORMAL
